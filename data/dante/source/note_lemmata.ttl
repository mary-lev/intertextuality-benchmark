<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/20/paragrafo/14/exprFrag1/596>	ns3:efChars	"ibi haec incondita solus / montibus et silvis studio iactabat inani - Egl. II 4-5" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/7/exprFrag/274>	ns3:efChars	"v. 21" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/15/paragrafo/4/exprFrag1/370>	ns3:efChars	"LXX 7.9" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/20/paragrafo/5/exprFrag1/600>	ns3:efChars	"Pegli occhi fere un spirito sottile, / die fa 'n la mente spirito destare, / del qual si move spirito d'amare - versi 1-3" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/34/paragrafo/10/exprFrag1/958>	ns3:efChars	"come non mandate / fuor della mente parole adomate / di pianto, dolorose e sbigottite ? - versi 2-4" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/31/paragrafo/17/exprFrag1/932>	ns3:efChars	"Va', ballatetta, e la mia donna trova - verso 18" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/7/exprFrag/273>	ns3:efChars	"che 'nfin qua su risplende" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/20/paragrafo/5/exprFrag1/601>	ns3:efChars	"di 'n occhi 'n occhi di femina e d'omo - verso 2" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/16/paragrafo/7/exprFrag1/406>	ns3:efChars	"verso 8" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/3/paragrafo/8/exprFrag1/71>	ns3:efChars	"verso 8" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/11/exprFrag1/538>	ns3:efChars	"verso 8" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/15/paragrafo/6/exprFrag1/394>	ns3:efChars	"verso 8" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/23/paragrafo/23/exprFrag1/716>	ns3:efChars	"verso 8" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/34/paragrafo/10/exprFrag1/957>	ns3:efChars	"I' sento pianger for li miei sospiri, / quando la mente di lei mi ragiona - versi 11-2" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/8/paragrafo/10/exprFrag1/176>	ns3:efChars	"verso 24" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/16/paragrafo/7/exprFrag1/407>	ns3:efChars	"A me stesso di me pietate v\u00E9ne / per la dolente angoscia ch'i' mi vego - versi 1-2" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/34/paragrafo/11/exprFrag/545>	ns3:efChars	"v. 13. venian dicendo" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/8/paragrafo/10/exprFrag1/177>	ns3:efChars	"versi 31-5" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/16/paragrafo/7/exprFrag1/408>	ns3:efChars	"ch\u00E9 mante fiate son ch'io mi dispero, / e dico: Ohi lasso [cfr. v.4], che vit'\u00E8 la mia? / Ch\u00E9 non mi movo e vo a la donna mia - versi 57-61" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/16/paragrafo/7/exprFrag1/404>	ns3:efChars	"ch\u00E9 mante fiate son ch'io mi dispero, / e dico: Ohi lasso [cfr. v.4], che vit'\u00E8 la mia? / Ch\u00E9 non mi movo e vo a la donna mia - versi 57-61" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/7/exprFrag/270>	ns3:efChars	"v. 15. Angelo" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/3/paragrafo/10/exprFrag1/76>	ns3:efChars	"de voi - .. / m'ha preso amor - versi 2-4" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/14/paragrafo/12/exprFrag1/356>	ns3:efChars	"l' sento pianger for li miei sospiri - verso 11" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/39/paragrafo/10/exprFrag/573>	ns3:efChars	"v. 11. Amor vi tramortisce" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/3/paragrafo/10/exprFrag1/75>	ns3:efChars	"si pres'\u00E8 '1 meo core / di vo' - verso 8" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/39/paragrafo/10/exprFrag/572>	ns3:efChars	"versi 9-10" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/16/paragrafo/7/exprFrag1/402>	ns3:efChars	"Ispesse volte voi vegno a vedere - verso 1" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/3/paragrafo/10/exprFrag1/74>	ns3:efChars	"la donna \u00E8 prisa - verso 12" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/7/exprFrag/272>	ns3:efChars	"in divino intelletto" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/31/paragrafo/15/exprFrag1/922>	ns3:efChars	"li strugge il suo valore - verso 14" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/16/paragrafo/7/exprFrag1/403>	ns3:efChars	"Ispessamente movomi lo giorno, / e vado per veder la donna mia - versi 1-2" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/7/exprFrag/271>	ns3:efChars	"clama" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/20/paragrafo/5/exprFrag1/596>	ns3:efChars	"speranza ed amore / di persona piaciuta \u00BBproprio \u00ABquando omo 'namora - 2328-9" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/20/paragrafo/5/exprFrag1/595>	ns3:efChars	"E' par che da verace piacimento / lo fino amor discenda, / guardando quel ch'ai cor torni piacente - versi 12-4" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/15/paragrafo/4/exprFrag1/378>	ns3:efChars	"spiriti, fuggite - verso 11" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/26/paragrafo/7/exprFrag1/853>	ns3:efChars	"versi 3-4" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/15/paragrafo/4/exprFrag1/376>	ns3:efChars	"versi 3-4" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/3/paragrafo/10/exprFrag1/78>	ns3:efChars	"versi 3-4" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/3/paragrafo/10/exprFrag1/79>	ns3:efChars	"Se 'n questo dir presente si contene - I verso 1" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/20/paragrafo/5/exprFrag1/594>	ns3:efChars	"rima aretina (o Guittoniana)" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/15/paragrafo/4/exprFrag1/377>	ns3:efChars	"Tu sai, quando venisti, ch'io ti dissi [parla Amore], / poi che l'av\u00E9i veduta, / per forza convenia che tu morissi - versi 40-2" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/15/paragrafo/4/exprFrag1/375>	ns3:efChars	"verso 2" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/24/paragrafo/3/exprFrag1/734>	ns3:efChars	"verso 2" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/20/paragrafo/5/exprFrag1/593>	ns3:efChars	"Amor est passio quaedam innata procedens ex visione et immoderata cogitatone formae alterius sexus - I. 1" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/12/exprFrag/299>	ns3:efChars	"passan" .
