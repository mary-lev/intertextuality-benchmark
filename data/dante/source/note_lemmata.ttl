<http://perunaenciclopediadantescadigitale.eu/resource/work/convivio/libro/4/capitolo/20/paragrafo/7/exprFrag/544>	ns3:efChars	"IN UNA SUA CANZONE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/convivio/libro/4/capitolo/20/paragrafo/7/exprFrag/543>	ns3:efChars	"LE COSE CONVENGONO ESSERE DISPOSTE ALLI LORO AGENTI ..." .
<http://perunaenciclopediadantescadigitale.eu/resource/work/convivio/libro/4/capitolo/20/paragrafo/7/exprFrag1/952>	ns3:efChars	"\"Foco d'amore in gentil cor s'aprende /come vertute in pietra preziosa, / che da la stella valor no i discende / anti che 'l sol la faccia gentil cosa; / poi che n'ha tratto fore / per sua forza lo sol che li \u00E8 vile /stella li d\u00E0 valore\"\" (11-17, II, Contini, p. 461)\"" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/convivio/libro/4/capitolo/20/paragrafo/7/exprFrag1/951>	ns3:efChars	"cap. 2, 414 a 11-12" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/11/paragrafo/3/exprFrag/232>	ns3:efChars	"UNA COSA" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/28/paragrafo/3/exprFrag/447>	ns3:efChars	"CON TUTTO LO VERGOGNOSO CUORE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/28/paragrafo/3/exprFrag/448>	ns3:efChars	"L\u00C0" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/7/paragrafo/1/exprFrag1/235>	ns3:efChars	"a la battaglia ove madonna \u00E8 stata - verso 11" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/1/paragrafo/12/exprFrag/22>	ns3:efChars	"PASSANDO PER UNA VIA" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/7/paragrafo/1/exprFrag1/236>	ns3:efChars	"questa battaglia di dolor' mantene - verso 8" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/1/paragrafo/12/exprFrag/23>	ns3:efChars	"VIRTUOSAMENTE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/11/paragrafo/3/exprFrag/233>	ns3:efChars	"PONE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/12/paragrafo/4/exprFrag1/363>	ns3:efChars	"O Deo, che sembra quando li occhi gira! - verso 5; Non fu s\u00EC alta gi\u00E0 la mente nostra / e non si pose 'n noi tanta salute / che propriamente n'avi\u00E0n canoscenza - versi 12-4" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/7/paragrafo/1/exprFrag1/234>	ns3:efChars	"de la battaglia ch'e[l]l'ave dal core - verso 2" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/11/paragrafo/3/exprFrag/234>	ns3:efChars	"OSA" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/4/paragrafo/11/exprFrag1/167>	ns3:efChars	"et vocavi te in nomine tuo - Is 45,4" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/7/paragrafo/5/exprFrag/159>	ns3:efChars	"DISTRUTTI LI MIEI SPIRITI" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/20/paragrafo/16/exprFrag/414>	ns3:efChars	"IO T'ABANDONO" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/4/paragrafo/11/exprFrag1/169>	ns3:efChars	"Amore meco ristette, che venia di lontano - verso 6" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/1/paragrafo/12/exprFrag/20>	ns3:efChars	"COMPIUTI LI NOVE ANNI" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/15/paragrafo/4/exprFrag/307>	ns3:efChars	"LO IMPONITORE DEL NOME" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/4/paragrafo/11/exprFrag1/168>	ns3:efChars	"questo mio spirto che vien di lontano - verso 3" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/1/paragrafo/12/exprFrag/21>	ns3:efChars	"BIANCHISSIMO" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/3/paragrafo/10/exprFrag1/151>	ns3:efChars	"quanto \u00E8 da pregiare - verso 13" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/5/paragrafo/6/exprFrag1/183>	ns3:efChars	"remagno como statua d'ottono - verso 12" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/5/paragrafo/6/exprFrag1/184>	ns3:efChars	"fatto di rame o di pietra o di legno, / che si conduca sol per maestria - versi 11-2" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/15/paragrafo/4/exprFrag/308>	ns3:efChars	"PRECEDETTE LA VERACE LUCE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/10/paragrafo/27/exprFrag1/330>	ns3:efChars	"per ch'eo voglio dire - verso 1" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/26/paragrafo/6/exprFrag/439>	ns3:efChars	"LAGRIMAR" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/26/paragrafo/6/exprFrag/438>	ns3:efChars	"L'AMARO LAGRIMAR ... SOSPIRA" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/1/paragrafo/4/exprFrag/7>	ns3:efChars	"CINTA" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/27/paragrafo/2/exprFrag/443>	ns3:efChars	"IN COS\u00CC VILE MODO" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/7/paragrafo/11/exprFrag1/257>	ns3:efChars	"E' mi duol forte del gabbato affanno - verso 12" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/7/paragrafo/11/exprFrag1/258>	ns3:efChars	"Donna, voi li gabbate sorridendo - verso 52" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/1/paragrafo/16/exprFrag1/58>	ns3:efChars	"Chi gran pena sente / guardi costui, e veder\u00E0 'l su' core / che Morte 'l porta 'n man tagliato in croce - versi 12-4" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/1/paragrafo/22/exprFrag/51>	ns3:efChars	"N'\u00C8 LUCENTE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/7/paragrafo/11/exprFrag1/255>	ns3:efChars	"pur aspettando che da voi si mova / una dolce piet\u00E0, se 'n voi si trova\u00BB - versi 10-11" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/13/paragrafo/6/exprFrag1/380>	ns3:efChars	"e vidi 'l servitore / di monna Lagia che venia dicendo - versi 5-6" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/13/paragrafo/6/exprFrag1/381>	ns3:efChars	"ei mihi, qualis erat, quantum mutatus ab illo / Hectore qui redit exuvias indutus Achilli - Aen. II 274-5" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/7/paragrafo/11/exprFrag1/256>	ns3:efChars	"non gabbereste la vista e 'l colore - verso 3" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/10/paragrafo/15/exprFrag1/304>	ns3:efChars	"Io vogl' del ver la mia donna laudare - verso 1" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/10/paragrafo/20/exprFrag/210>	ns3:efChars	"QUANDO VA PER VIA" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/27/paragrafo/1/exprFrag1/646>	ns3:efChars	"La salute tua \u00E8 apparita - verso 12" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/10/paragrafo/20/exprFrag/211>	ns3:efChars	"DIVERRIA ... MORRIA" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/21/paragrafo/6/exprFrag/418>	ns3:efChars	"DOLENTE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/10/paragrafo/22/exprFrag1/324>	ns3:efChars	"Ipse fuit quicquid potuit Natura - 394" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/25/paragrafo/4/exprFrag1/629>	ns3:efChars	"caeco carpitur igni - Aen. IV 2" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/1/paragrafo/6/exprFrag1/21>	ns3:efChars	"Animalis spiritus ... licet exeat a corde, evolat in vacuitatem cellularum cerebri, et ex illis dirigitur in nervos concavos qui a sensus communis organo ad sensus proprios diriguntur; quorum tamen nervi illi qui optici sive visivi dicuntur, et maiores et magis sunt concavi et plus capiunt de spiritu, et puriorem et lucidiorem, qui solus elevatur, colligunt -  I II 4" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/3/paragrafo/8/exprFrag/92>	ns3:efChars	"MORTE VILLANA ... COMPAGNIA" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/3/paragrafo/8/exprFrag/93>	ns3:efChars	"MORTE ... NEMICA" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/3/paragrafo/8/exprFrag/94>	ns3:efChars	"BLASMAR" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/1/paragrafo/6/exprFrag1/22>	ns3:efChars	"tien ragion nel cassar de la mente - verso 6" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/16/paragrafo/10/exprFrag1/509>	ns3:efChars	"omni ornatu orationis tamquam veste detracta - Brutus 262" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/1/paragrafo/14/exprFrag/31>	ns3:efChars	"DI PAUROSO ASPETTO A CHI LA GUARDASSE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/1/paragrafo/14/exprFrag/30>	ns3:efChars	"NEBULA DI COLORE DI FUOCO" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/7/paragrafo/7/exprFrag1/250>	ns3:efChars	"modicae fidei - Mt 14, 31" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/1/paragrafo/18/exprFrag1/61>	ns3:efChars	"redde mihi laetitiam salutaris tui et spiritu principali confirma me - Ps 50, 14" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/19/paragrafo/8/exprFrag/384>	ns3:efChars	"QUASI VEDOVA" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/1/paragrafo/18/exprFrag1/62>	ns3:efChars	"risus vester in luctum convertatur, et gaudium in maerorem - Iac 4, 9" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/15/paragrafo/7/exprFrag/314>	ns3:efChars	"IO MI SENTI' ... SOMIGLIA" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/1/paragrafo/18/exprFrag/41>	ns3:efChars	"LA SUA LETIZIA SI CONVERTIA IN AMARISSIMO PIANTO" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/1/paragrafo/14/exprFrag/34>	ns3:efChars	"EGO DOMINUS TUUS" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/1/paragrafo/18/exprFrag1/63>	ns3:efChars	"et plorabunt te in amaritudine animae ploratu amarissimo - Ez 27, 31" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/6/paragrafo/8/exprFrag1/230>	ns3:efChars	"e tanto vi sent\u00ECo gioia e dolzore - verso 25" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/19/paragrafo/8/exprFrag/386>	ns3:efChars	"LAGRIMANDO" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/1/paragrafo/18/exprFrag/42>	ns3:efChars	"DEBOLETTO" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/1/paragrafo/18/exprFrag1/64>	ns3:efChars	"deboletti spiriti - verso 6" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/11/paragrafo/2/exprFrag1/195>	ns3:efChars	"deboletti spiriti - verso 6" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/1/paragrafo/14/exprFrag/33>	ns3:efChars	"MIRABILE COSA" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/47/paragrafo/2/exprFrag/726>	ns3:efChars	"RAGIONE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/19/paragrafo/8/exprFrag/385>	ns3:efChars	"DISPOGLIATA DA OGNI DIGNITADE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/1/paragrafo/21/exprFrag1/81>	ns3:efChars	"Corona XXV" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/1/paragrafo/18/exprFrag1/65>	ns3:efChars	"voce sbigottita e deboletta - verso 37" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/1/paragrafo/14/exprFrag/32>	ns3:efChars	"CON TANTA LETIZIA" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/15/paragrafo/7/exprFrag/315>	ns3:efChars	"RIDEA" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/2/paragrafo/11/exprFrag1/114>	ns3:efChars	"sexagenario arcessito sibi numero dominarum II XVI, p. 263" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/31/paragrafo/2/exprFrag1/685>	ns3:efChars	"Deus autem non est mortuorum: omnes enim vivunt ei - Lc 20, 38" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/12/paragrafo/3/exprFrag1/362>	ns3:efChars	"Beatus venter qui te portavit, et ubera quae suxisti - Lc 11, 27" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/3/paragrafo/10/exprFrag/98>	ns3:efChars	"CI\u00D2 ... VERTUTE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/20/paragrafo/16/exprFrag/413>	ns3:efChars	"S\u00CC 'NVILITA" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/1/paragrafo/21/exprFrag1/80>	ns3:efChars	"Gratia vobis et pax a Deo Patre nostro et Domino Iesu Christo - Rm 1, 7" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/29/paragrafo/9/exprFrag1/671>	ns3:efChars	"Tu solus peregrinus es in Jerusalem et non cognovisti quae facta sunt in illa his diebus? -Lc 24,18" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/31/paragrafo/2/exprFrag1/683>	ns3:efChars	"\u00ABmerc\u00E9 per quella donna che tu miri, / d'opra non star, se di fe' non s\u00E8 sciolto\u00BB- versi 13-4" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/29/paragrafo/9/exprFrag1/673>	ns3:efChars	"Deh, spiriti miei, quando mi vedete" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/29/paragrafo/6/exprFrag1/668>	ns3:efChars	"fatto per greve essilio pellegrino - verso 2" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/31/paragrafo/2/exprFrag1/684>	ns3:efChars	"Regem, cui omnia vivunt" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/3/paragrafo/10/exprFrag/97>	ns3:efChars	"\u00C0I PARTITA" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/10/paragrafo/20/exprFrag/209>	ns3:efChars	"IN SOMMO CIELO" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/8/paragrafo/4/exprFrag/172>	ns3:efChars	"BELLA GIOIA" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/8/paragrafo/4/exprFrag/173>	ns3:efChars	"E QUAND'IO ... NOIA" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/29/paragrafo/6/exprFrag1/667>	ns3:efChars	"Peregrinus, longe a patria positus, sicut alienigena - Etym. X 215" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/7/paragrafo/5/exprFrag1/242>	ns3:efChars	"E dico che ' miei spiriti son morti - verso 5" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/2/paragrafo/11/exprFrag1/112>	ns3:efChars	"beltate / in molte donne sparte mi diletti - versi 13-14" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/7/paragrafo/5/exprFrag1/241>	ns3:efChars	"li spiriti fuggiti del mio core, / che per soverchio de lo su' valore / eran distrutti, se non fosser v\u00F2lti - versi 48-50" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/2/paragrafo/11/exprFrag1/113>	ns3:efChars	"Sexaginta sunt reginae et octo- ginta concubinae et adulescentularum non est numerus. Una est columba mea perfecta mea ... viderunt illam filiae et beatissimam praedicaverunt ... laudaverunt ... quae est ista quae progreditur - versetti 7 - 9" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/1/paragrafo/1/exprFrag1/2>	ns3:efChars	"Amico, i' t'aggio letta la robrica; / provedi al negro - versi 12-13" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/9/paragrafo/8/exprFrag1/277>	ns3:efChars	"la morte / mi stringe s\u00EC, che vita m'abbandona - versi 17-8" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/16/paragrafo/8/exprFrag1/414>	ns3:efChars	"la morte / mi stringe s\u00EC, che vita m'abbandona - versi 17-8" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/8/paragrafo/1/exprFrag/170>	ns3:efChars	"ERA DI COTALE RAGIONAMENTO" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/7/paragrafo/11/exprFrag/166>	ns3:efChars	"CON L'ALTRE ... TORMENTOSI" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/1/paragrafo/1/exprFrag1/3>	ns3:efChars	"Canzon, \u2026 de' libri d'Amore / io t'asemplai - versi 43-44" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/9/paragrafo/8/exprFrag1/276>	ns3:efChars	"ond'assalir lo v\u00E8n, s\u00EC ch'e' si more - verso 14" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/1/paragrafo/1/exprFrag1/0>	ns3:efChars	"Gn 1,1 In principio creavit Deus caelum et terram" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/5/paragrafo/12/exprFrag1/200>	ns3:efChars	"Scuro saccio che par lo / mio detto, ma' che parlo -  versi 61-2" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/7/paragrafo/11/exprFrag/167>	ns3:efChars	"MIA VISTA GABBATE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/1/paragrafo/23/exprFrag1/86>	ns3:efChars	"cor ardens - Lc 24, 32" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/1/paragrafo/23/exprFrag1/85>	ns3:efChars	"e veder\u00E0 'l su' core / che Morte 'l porta 'n man, tagliato in croce - versi 13-14" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/3/paragrafo/6/exprFrag/91>	ns3:efChars	"RIGUARDAVA VER' LO CIEL" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/3/paragrafo/5/exprFrag1/137>	ns3:efChars	"che tanta bielt\u00E0 fosse / per te, Morte, cos\u00EC tosto guastata - versi 44-45" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/3/paragrafo/6/exprFrag/90>	ns3:efChars	"IN FORMA VERA" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/3/paragrafo/5/exprFrag1/138>	ns3:efChars	"d'Amor sorella mi sembl' al parlare - verso 8" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/9/paragrafo/8/exprFrag1/278>	ns3:efChars	"I' sento pianger for li miei sospiri / quando la mente di lei mi ragiona - versi 11-2" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/16/paragrafo/8/exprFrag1/417>	ns3:efChars	"I' sento pianger for li miei sospiri / quando la mente di lei mi ragiona - versi 11-2" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/3/paragrafo/5/exprFrag1/139>	ns3:efChars	"dic sapientiae soror mea es et prudentiam voca amicam tuam - Prv 7, 4" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/3/paragrafo/6/exprFrag1/142>	ns3:efChars	"Ad te levavi oculos meos qui habitas in coelo - Ps 122,1" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/1/paragrafo/21/exprFrag1/79>	ns3:efChars	"Gianni, quel Guido salute" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/28/paragrafo/4/exprFrag1/654>	ns3:efChars	"lo qual s\u00F2l apparir quand'om si more, detto di quel pauroso spirito d'amore - verso 3" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/16/paragrafo/6/exprFrag1/483>	ns3:efChars	"Madonna, dir vo voglio / como l'amor m'\u00E0 priso - versi 1-2" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/3/paragrafo/6/exprFrag1/140>	ns3:efChars	"ch'io veggio Amor visibil che l'adora / e falle reverenza - versi 13-14" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/1/paragrafo/21/exprFrag1/78>	ns3:efChars	"Guido, quel Gianni ch'a te fu l'altrieri / salute - versi 1-2" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/10/paragrafo/18/exprFrag/207>	ns3:efChars	"IN DIVINO INTELLETTO" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/17/paragrafo/7/exprFrag1/533>	ns3:efChars	"dal qual si move spirito d'amare e Po\u00EF da questo spirito si move / un altro dolce spirito soave - versi 3 e 9-10" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/17/paragrafo/7/exprFrag1/532>	ns3:efChars	"imaginar nol pote om che nol prova - verso 53" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/26/paragrafo/6/exprFrag1/639>	ns3:efChars	"che 'l forte e 'l duro lagrimar ch'e' fanno - verso 10" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/26/paragrafo/6/exprFrag1/637>	ns3:efChars	"Li mie' foll' occhi, che prima guardaro - verso 1" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/26/paragrafo/6/exprFrag1/638>	ns3:efChars	"Perch\u00E9 non fuoro a me gli occhi dispenti - verso 1" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/1/paragrafo/21/exprFrag/50>	ns3:efChars	"SALUTE IN LOR SEGNOR" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/7/paragrafo/7/exprFrag/163>	ns3:efChars	"DI BUONA FEDE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/5/paragrafo/18/exprFrag/134>	ns3:efChars	"ANDAR SICURAMENTE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/12/paragrafo/3/exprFrag1/361>	ns3:efChars	"ex hoc beatam me dicent del Magnificat - Lc 1, 48" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/7/paragrafo/7/exprFrag/162>	ns3:efChars	"SI GABBAVANO" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/8/paragrafo/6/exprFrag1/273>	ns3:efChars	"nisi granum frumenti cadens in terram mortuum fuerit - Io 12, 24" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/12/paragrafo/3/exprFrag1/360>	ns3:efChars	"che porse dentr'al cor nova dolcezza - verso 11" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/7/paragrafo/7/exprFrag/161>	ns3:efChars	"ACCORGENDOSI DELLA MIA TRANSFIGURAZIONE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/20/paragrafo/13/exprFrag1/593>	ns3:efChars	"su' core / che Morte 'l porta 'n man tagliato in croce - versi 13-4" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/8/paragrafo/6/exprFrag1/271>	ns3:efChars	"che fate quando v'encontro, m'ancide: - verso 2; s\u00EC come quelli che sua morte vede. - verso 8" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/29/paragrafo/9/exprFrag/462>	ns3:efChars	"DEH, PEREGRINI ... ALTRUI" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/1/paragrafo/21/exprFrag1/77>	ns3:efChars	"che mi riscrivi s'elli 'l chiama amante - verso 4" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/2/paragrafo/1/exprFrag1/97>	ns3:efChars	"Vedesti, al mio parere, onne valore - verso 1" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/1/paragrafo/21/exprFrag1/76>	ns3:efChars	"Se 'n questo dir presente si contene ... i' prego quei nel cui cospetto v\u00E8ne - I 1 e 5" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/2/paragrafo/1/exprFrag1/96>	ns3:efChars	"Pompei, meorum prime sodalium - Carm. II VII 5" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/2/paragrafo/2/exprFrag1/99>	ns3:efChars	"iudicium nel gergo della mantinca" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/2/paragrafo/2/exprFrag1/98>	ns3:efChars	"Provedi, saggio, ad esta visione, / e per merc\u00E9 ne trai vera sentenza - versi 1-2" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/6/paragrafo/4/exprFrag1/224>	ns3:efChars	"nomina sunt consequentia rebus" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/14/paragrafo/24/exprFrag1/431>	ns3:efChars	"Tu solus peregrinus es in Hierusalem et non cognovisti quae facta sunt in illa his diebus? - Lc 24, 18" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/6/paragrafo/4/exprFrag1/222>	ns3:efChars	"Se 'l nome deve seguitar lo fatto - verso 1" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/13/paragrafo/3/exprFrag1/285>	ns3:efChars	"Se 'l nome deve seguitar lo fatto - verso 1" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/29/paragrafo/9/exprFrag/463>	ns3:efChars	"DEH, PEREGRINI ... ANDATE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/6/paragrafo/4/exprFrag1/221>	ns3:efChars	"d'un accidente \u2013 che sovente \u2013 \u00E8 fero ed \u00E8 s\u00EC altero \u2013 ch'\u00E8 chiamato amore - versi 2-3" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/24/paragrafo/8/exprFrag1/628>	ns3:efChars	"l'anima trista per voler trar guai; - verso 8" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/24/paragrafo/8/exprFrag1/627>	ns3:efChars	"in corde meo" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/8/paragrafo/1/exprFrag1/262>	ns3:efChars	"per\u00F2 ch'i' sento nel cor un pensero/ che fa tremar la mente di paura,/ e par che dica: \u00ABAmor non t'assicura/ in guisa, che tu possi di leggero/ a la tua donna s\u00EC contar il vero,/ che Morte non ti ponga 'n sua figura\u00BB. - versi 3-8" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/15/paragrafo/3/exprFrag1/448>	ns3:efChars	"Amor da quella ch'\u00E8 nel tondo sesto? - verso 6" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/5/paragrafo/11/exprFrag1/198>	ns3:efChars	"s\u00EC va soave per sonno a la gente - verso 7" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/1/paragrafo/14/exprFrag1/44>	ns3:efChars	"s\u00EC va soave per sonno a la gente - verso 7" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/5/paragrafo/11/exprFrag1/199>	ns3:efChars	"Lc 22,26" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/6/paragrafo/2/exprFrag/143>	ns3:efChars	"BUONA \u00C8 LA SIGNORIA D'AMORE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/17/paragrafo/7/exprFrag1/534>	ns3:efChars	"veder mi par de la sua labbia uscire / una s\u00EC bella donna, che la mente / comprender no la pu\u00F2 - versi 7-9" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/14/paragrafo/9/exprFrag1/418>	ns3:efChars	"che, qual mira de f\u00F2re, / vede la Morte sotto al meo colore - versi 30-1" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/17/paragrafo/7/exprFrag1/535>	ns3:efChars	"sursum spirare" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/5/paragrafo/11/exprFrag1/197>	ns3:efChars	"E tu conosci ben ch'i' sono Amore - verso 12" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/14/paragrafo/9/exprFrag1/417>	ns3:efChars	"ch'i' porto morte scritta ne la faccia - verso 14" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/10/paragrafo/22/exprFrag/218>	ns3:efChars	"ELLA \u00C8 ... NATURA" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/14/paragrafo/9/exprFrag1/416>	ns3:efChars	"Morte gentil, rimedio de' cattivi - Corona XXXV" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/1/paragrafo/10/exprFrag/18>	ns3:efChars	"FOSSE BALDANZA D'AMORE A SIGNOREGGIARE ME" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/9/paragrafo/7/exprFrag/180>	ns3:efChars	"VIENMENE PIET\u00C0" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/1/paragrafo/4/exprFrag1/12>	ns3:efChars	"accordellata istretta - verso 32" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/3/paragrafo/10/exprFrag1/149>	ns3:efChars	"partit'hai la pi\u00F9 dolze compagnia - verso 24" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/10/paragrafo/22/exprFrag/215>	ns3:efChars	"COME ... PURA?" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/10/paragrafo/22/exprFrag/216>	ns3:efChars	"ADORNA" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/10/paragrafo/22/exprFrag/217>	ns3:efChars	"QUASI" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/17/paragrafo/5/exprFrag1/529>	ns3:efChars	"e mena seco Amor, s\u00EC che parlare / null' omo pote, ma ciascun sospira? - versi 3-4" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/16/paragrafo/10/exprFrag/343>	ns3:efChars	"SOTTO VESTA ... RETTORICO" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/28/paragrafo/8/exprFrag1/656>	ns3:efChars	"sospiri / che nascon della mente ov'\u00E8 Amore - versi 5-6" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/1/paragrafo/21/exprFrag/49>	ns3:efChars	"RESCRIVA" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/10/paragrafo/9/exprFrag/194>	ns3:efChars	"IN NOTIFICANDO LA TUA CONDIZIONE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/16/paragrafo/10/exprFrag/344>	ns3:efChars	"QUESTO MIO PRIMO AMICO" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/15/paragrafo/3/exprFrag/303>	ns3:efChars	"QUESTO MIO PRIMO AMICO" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/16/paragrafo/10/exprFrag/345>	ns3:efChars	"COS\u00CC RIMANO STOLTAMENTE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/1/paragrafo/14/exprFrag1/50>	ns3:efChars	"Inizio del Decalogo" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/28/paragrafo/4/exprFrag/449>	ns3:efChars	"LO QUALE SUOLE APPARIRE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/18/paragrafo/4/exprFrag/373>	ns3:efChars	"POI" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/7/paragrafo/4/exprFrag1/240>	ns3:efChars	"allora dico che 'l cor si divise - verso 4" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/14/paragrafo/4/exprFrag1/323>	ns3:efChars	"allora dico che 'l cor si divise - verso 4" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/1/paragrafo/21/exprFrag/46>	ns3:efChars	"A CIASCUN'ALMA ... PIANGENDO" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/1/paragrafo/14/exprFrag1/51>	ns3:efChars	"Corona XV" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/1/paragrafo/21/exprFrag/47>	ns3:efChars	"GENTIL CORE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/1/paragrafo/21/exprFrag/48>	ns3:efChars	"LO DIR PRESENTE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/15/paragrafo/8/exprFrag/316>	ns3:efChars	"MONNA BICE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/15/paragrafo/3/exprFrag/304>	ns3:efChars	"GIOVANNA" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/9/paragrafo/8/exprFrag/181>	ns3:efChars	"ASSALE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/15/paragrafo/3/exprFrag/305>	ns3:efChars	"SECONDO CHE ALTRI CREDE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/5/paragrafo/2/exprFrag1/174>	ns3:efChars	"Redde mihi laetitiam salutaris tui - Ps 50, 14" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/18/paragrafo/4/exprFrag/372>	ns3:efChars	"LI SPIRITI ... VIA" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/15/paragrafo/3/exprFrag1/450>	ns3:efChars	"piacente Primavera - verso 2" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/2/paragrafo/1/exprFrag/58>	ns3:efChars	"FU RISPOSTO DA MOLTI" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/15/paragrafo/3/exprFrag/302>	ns3:efChars	"DI FAMOSA BIELTADE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/5/paragrafo/6/exprFrag/115>	ns3:efChars	"COME COSA GRAVE INANIMATA" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/1/paragrafo/1/exprFrag/5>	ns3:efChars	"SENTENZIA" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/1/paragrafo/14/exprFrag1/45>	ns3:efChars	"Tempus erat, quo prima quies mortalibus aegris / incipit et dono divom gratissima serpit: / in somnis ecce ante oculos maestissimus Hector / visus adesse mihi largosque effundere fletus, / raptatus bigis ut quondam aterque cruento / pulvere perque pedes traiectus lora tumentis. / Ei mihi qualis erat, quantum mutatus ab illo / Hectore. - II 268-302" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/10/paragrafo/22/exprFrag1/319>	ns3:efChars	"Ahi Deo, co s\u00EC novella / pote a esto mondo dimorar figura - versi 16-7" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/15/paragrafo/4/exprFrag1/458>	ns3:efChars	"O voi che siete voce nel diserto - versi 1-3" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/15/paragrafo/4/exprFrag1/457>	ns3:efChars	"Is 40,3" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/28/paragrafo/8/exprFrag/451>	ns3:efChars	"CHE NASCON ... NEL CORE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/2/paragrafo/1/exprFrag/59>	ns3:efChars	"DI DIVERSE SENTENZIE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/15/paragrafo/4/exprFrag1/456>	ns3:efChars	"parate viam Domini - Lc 3, 4" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/15/paragrafo/3/exprFrag/306>	ns3:efChars	"IMPOSTO L'ERA" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/9/paragrafo/8/exprFrag/183>	ns3:efChars	"DI VOI RAGIONA" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/1/paragrafo/14/exprFrag1/49>	ns3:efChars	"Et faciet Dominus mirabile - Ex 9, 4" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/29/paragrafo/4/exprFrag/458>	ns3:efChars	"FAREI PIANGERE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/15/paragrafo/4/exprFrag1/455>	ns3:efChars	"parate viam Domini - Mc 1, 3" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/9/paragrafo/8/exprFrag/182>	ns3:efChars	"LA VITA QUASI M'ABANDONA" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/29/paragrafo/6/exprFrag/459>	ns3:efChars	"CHIUNQUE \u00C8 FUORI DELLA SUA PATRIA" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/1/paragrafo/1/exprFrag/0>	ns3:efChars	"IN QUELLA PARTE ... LEGGERE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/15/paragrafo/4/exprFrag1/454>	ns3:efChars	"parate viam Domini - Mt 3, 3" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/15/paragrafo/4/exprFrag1/453>	ns3:efChars	"Ego vox clamantis in deserto: parate viam Domini - Io 1, 23" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/15/paragrafo/4/exprFrag1/452>	ns3:efChars	"Lux vera - Io 1, 9" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/5/paragrafo/2/exprFrag1/171>	ns3:efChars	"ut destruas inimicum et ultorem - Ps 8, 3" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/1/paragrafo/1/exprFrag/4>	ns3:efChars	"LIBELLO" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/10/paragrafo/21/exprFrag/212>	ns3:efChars	"CH\u00C9 LI AV\u00C8N ... SALUTE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/20/paragrafo/8/exprFrag1/576>	ns3:efChars	"e gi\u00E0 no stanca, n\u00E9 riman nel corso - verso 12" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/5/paragrafo/2/exprFrag1/170>	ns3:efChars	"It per urbes - Aen. IV 173" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/1/paragrafo/1/exprFrag/3>	ns3:efChars	"ASEMPLARE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/20/paragrafo/8/exprFrag1/575>	ns3:efChars	"forse mi rimar\u00F2 di pi\u00F9 cherere - verso 14" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/5/paragrafo/2/exprFrag1/173>	ns3:efChars	"a le' s'inchin' ogni gentil vertute, / e la beltate per sua dea la mostra - 10-1" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/1/paragrafo/1/exprFrag/2>	ns3:efChars	"RUBRICA" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/10/paragrafo/21/exprFrag/214>	ns3:efChars	"ANCOR" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/10/paragrafo/21/exprFrag/213>	ns3:efChars	"OGNI OFFESA OBLIA" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/1/paragrafo/1/exprFrag/1>	ns3:efChars	"PARTE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/20/paragrafo/14/exprFrag/410>	ns3:efChars	"GIUNGEMI ... MI PARTE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/29/paragrafo/4/exprFrag1/666>	ns3:efChars	"fare'ne di piet\u00E0 pianger Amore - verso 8" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/23/paragrafo/21/exprFrag1/710>	ns3:efChars	"fare'ne di piet\u00E0 pianger Amore - verso 8" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/23/paragrafo/9/exprFrag1/617>	ns3:efChars	"Voi che per li occhi mi passaste 'l core / e destaste la mente che dormia, / guardate a l'angosciosa vita mia, / che sospirando la distrugge Amore - versi 1-4" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/20/paragrafo/14/exprFrag/411>	ns3:efChars	"GIUNGEMI ... PARTE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/1/paragrafo/16/exprFrag/39>	ns3:efChars	"VIDE COR TUUM!" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/10/paragrafo/18/exprFrag1/307>	ns3:efChars	"Sermo I - in festo Annunciationis" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/20/paragrafo/14/exprFrag/412>	ns3:efChars	"SOL" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/18/paragrafo/4/exprFrag1/546>	ns3:efChars	"se vedesse li spirti fuggir via - verso 13" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/10/paragrafo/18/exprFrag1/309>	ns3:efChars	"Splende 'n la 'ntelligenz\u00EFa del cielo - verso 41" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/20/paragrafo/8/exprFrag1/574>	ns3:efChars	"Io non pensava che lo cor giammai / avesse di sospir' tormento tanto - versi 1-2" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/13/paragrafo/3/exprFrag1/279>	ns3:efChars	"per quella fede, amor, che porto voi - verso 18" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/10/paragrafo/27/exprFrag/223>	ns3:efChars	"PERCH\u00C9 IO VOGLIO DIRE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/6/paragrafo/8/exprFrag/152>	ns3:efChars	"TREMANDO ... CORE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/5/paragrafo/19/exprFrag/135>	ns3:efChars	"QUELLI ... VOI" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/2/paragrafo/11/exprFrag/73>	ns3:efChars	"P\u00CCSTOLA SOTTO FORMA DI SERVENTESE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/5/paragrafo/19/exprFrag/136>	ns3:efChars	"FACE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/2/paragrafo/1/exprFrag/61>	ns3:efChars	"VEDESTI, AL MIO PARERE, ONNE VALORE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/2/paragrafo/11/exprFrag/72>	ns3:efChars	"LX LE PI\u00D9 BELLE DONNE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/1/paragrafo/22/exprFrag1/82>	ns3:efChars	"ch'adesso con' fu 'l sole, / s\u00EC tosto lo splendore fu lucente - versi 5-6" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/2/paragrafo/1/exprFrag/60>	ns3:efChars	"PRIMO DELLI MIEI AMICI" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/11/paragrafo/3/exprFrag1/344>	ns3:efChars	"Ego et Pater unum sumus - Io 10, 30" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/8/paragrafo/4/exprFrag1/267>	ns3:efChars	"Tu sai, quando venisti, ch'io ti dissi, / poi che l'av\u00E8i veduta, / per forza convenia che tu morissi - versi 40-2" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/11/paragrafo/3/exprFrag1/343>	ns3:efChars	"n\u00E9 fe' amor anti che gentil core, / n\u00E9 gentil core anti ch'amor, natura - versi 3-4" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/20/paragrafo/3/exprFrag1/580>	ns3:efChars	"n\u00E9 fe' amor anti che gentil core, / n\u00E9 gentil core anti ch'amor, natura - versi 3-4" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/10/paragrafo/9/exprFrag1/291>	ns3:efChars	"Po' che mi disse di sua condizione - verso 15" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/2/paragrafo/4/exprFrag1/18>	ns3:efChars	"Ecce Dominus Deus in fortitudine veniet, et brachium eius dominabitur - Is 40, 10" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/8/paragrafo/4/exprFrag1/265>	ns3:efChars	"Bella gioia - verso 2" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/2/paragrafo/4/exprFrag1/17>	ns3:efChars	"veniet autem fortior me - Lc 3, 16" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/8/paragrafo/4/exprFrag1/266>	ns3:efChars	"nonch\u00E9 Avegna ched el m'aggia - versi 7-8" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/28/paragrafo/3/exprFrag1/653>	ns3:efChars	"in guisa ch'i' non so l\u00E0 'v' i' mi sia - verso 16" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/6/paragrafo/8/exprFrag/150>	ns3:efChars	"TUTTI LI MIEI ... DIFENDA" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/11/paragrafo/3/exprFrag1/347>	ns3:efChars	"Secondo ci\u00F2 che pone alcuno autore, - verso 3" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/8/paragrafo/4/exprFrag1/264>	ns3:efChars	"Amore o gioia, bella gioia, sento - verso 1" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/6/paragrafo/8/exprFrag/151>	ns3:efChars	"DOLZORE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/11/paragrafo/3/exprFrag1/346>	ns3:efChars	"s\u00EC como l'Autore / pon - 72-3" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/5/paragrafo/18/exprFrag1/207>	ns3:efChars	"ma va' sicuramente / per via tra la gente - 1817-8" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/11/paragrafo/3/exprFrag1/345>	ns3:efChars	"Multitudinis autem credentium erat cor unum et anima una - Act 4, 32" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/5/paragrafo/18/exprFrag1/206>	ns3:efChars	"Tu puoi sicuramente gir, canzone - Verso 71" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/28/paragrafo/3/exprFrag1/652>	ns3:efChars	"Cor contritum et humiliatum, Deus, non despicies - Ps 50, 19 - Miserere" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/10/paragrafo/7/exprFrag1/288>	ns3:efChars	"Et quomodo descendit imber et nix de caelo ... sic erit verbum meum quod egredietur de ore meo -  Is 55, 10-1" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/4/paragrafo/11/exprFrag/107>	ns3:efChars	"DI LONTANA PARTE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/10/paragrafo/7/exprFrag1/289>	ns3:efChars	"e bianca neve scender senza venti - verso 6" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/18/paragrafo/5/exprFrag1/433>	ns3:efChars	"e bianca neve scender senza venti - verso 6" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/4/paragrafo/11/exprFrag/106>	ns3:efChars	"MI CHIAM\u00D2 PER NOME" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/3/paragrafo/5/exprFrag/88>	ns3:efChars	"GUASTANDO" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/3/paragrafo/5/exprFrag/89>	ns3:efChars	"SORA DELL'ONORE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/5/paragrafo/12/exprFrag/129>	ns3:efChars	"PARLI CON TANTA OSCURITADE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/19/paragrafo/8/exprFrag1/566>	ns3:efChars	"Habitavit in civitatibus desolatis -  Iob 15, 28" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/21/paragrafo/6/exprFrag1/604>	ns3:efChars	"L'anima mia dolente e paurosa - verso 9" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/3/paragrafo/8/exprFrag1/145>	ns3:efChars	"villana Morte, che non ha' pietanza - verso 5" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/11/paragrafo/5/exprFrag1/351>	ns3:efChars	"spirito d'amare - verso 3" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/19/paragrafo/8/exprFrag1/565>	ns3:efChars	"desolentur civitates absque habitatore - Is 6,11" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/19/paragrafo/8/exprFrag1/568>	ns3:efChars	"princeps in universa terra - Ps 44, 17" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/9/paragrafo/7/exprFrag1/275>	ns3:efChars	"A me stesso di me pietate v\u00E8ne / per la dolente angoscia ch'i' mi veggio - versi 1-2" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/19/paragrafo/8/exprFrag1/567>	ns3:efChars	"facta est quasi vidua domina gentium, princeps provinciarum facta est sub tributo - esordio" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/1/paragrafo/23/exprFrag/55>	ns3:efChars	"ARDENDO" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/21/paragrafo/6/exprFrag1/606>	ns3:efChars	"ti raccomanda l'anima dolente, - verso 4" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/21/paragrafo/6/exprFrag1/605>	ns3:efChars	"e l'anima dolente che s'ancide, - verso 5" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/2/paragrafo/2/exprFrag/63>	ns3:efChars	"NON FU VEDUTO ALLORA PER ALCUNO" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/27/paragrafo/1/exprFrag/442>	ns3:efChars	"APPARITA" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/14/paragrafo/20/exprFrag1/425>	ns3:efChars	"qual mira de f\u00F2re, / vede la Morte sotto al meo colore - versi 30-1" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/6/paragrafo/2/exprFrag/144>	ns3:efChars	"LE VILI COSE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/2/paragrafo/2/exprFrag/62>	ns3:efChars	"LO VERACE IUDIZIO" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/19/paragrafo/8/exprFrag1/569>	ns3:efChars	"Poi mi disse sua condizione - verso 15" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/11/paragrafo/5/exprFrag1/350>	ns3:efChars	"Voi che per li occhi mi passaste 'l core / e destaste la mente che dormia - versi 1-2" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/20/paragrafo/5/exprFrag1/599>	ns3:efChars	"Voi che per li occhi mi passaste 'l core / e destaste la mente che dormia - versi 1-2" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/2/paragrafo/2/exprFrag/64>	ns3:efChars	"ALLI PI\u00D9 SEMPLICI" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/25/paragrafo/4/exprFrag/434>	ns3:efChars	"S\u00CC CHE PER VOI ... SI SCHIANTI" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/25/paragrafo/4/exprFrag/433>	ns3:efChars	"PRESER" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/25/paragrafo/4/exprFrag/435>	ns3:efChars	"SI SCHIANTI" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/5/paragrafo/20/exprFrag/138>	ns3:efChars	"PREGHERO" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/17/paragrafo/5/exprFrag/358>	ns3:efChars	"TREMANDO" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/1/paragrafo/23/exprFrag/53>	ns3:efChars	"ALLEGRO" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/17/paragrafo/5/exprFrag/357>	ns3:efChars	"TANTO GENTILE ... SOSPIRA" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/7/paragrafo/1/exprFrag/154>	ns3:efChars	"BATTAGLIA DELLI DIVERSI PENSIERI" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/1/paragrafo/23/exprFrag/54>	ns3:efChars	"IN MANO" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/19/paragrafo/8/exprFrag1/563>	ns3:efChars	"et egressus est a filia Sion omnis decor eius - Lam 1, 6" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/19/paragrafo/8/exprFrag1/564>	ns3:efChars	"Threni idest Lamentationes Ieremiae prophetae, et factum est postquam in captivitatem redactus est Israel et Ierusalem deserta est, sedit Ieremias propheta flens et planxit lamentatione hac in Ierusalem et amaro animo suspirans et eiulans dixit - proemio" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/14/paragrafo/24/exprFrag/291>	ns3:efChars	"CHE FAI?" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/14/paragrafo/24/exprFrag/292>	ns3:efChars	"NON SAI NOVELLA?" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/10/paragrafo/7/exprFrag/192>	ns3:efChars	"L'ACQUA MISCHIATA DI BELLA NEVE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/5/paragrafo/20/exprFrag/137>	ns3:efChars	"MADONNA ... FEDE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/1/paragrafo/6/exprFrag/11>	ns3:efChars	"LO SPIRITO ANIMALE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/24/paragrafo/3/exprFrag/429>	ns3:efChars	"LA MIA VILE VITA" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/1/paragrafo/6/exprFrag/12>	ns3:efChars	"ALTA CAMERA" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/2/paragrafo/16/exprFrag/81>	ns3:efChars	"BALDANZA" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/2/paragrafo/16/exprFrag/82>	ns3:efChars	"POVER DIMORO" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/10/paragrafo/20/exprFrag1/311>	ns3:efChars	"A summo coeli - Ps 18, 7" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/6/paragrafo/4/exprFrag/148>	ns3:efChars	"NOMINA SUNT CONSEQUENTIA RERUM" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/10/paragrafo/24/exprFrag1/328>	ns3:efChars	"Poi s\u00E8 nata d'Amore ancella nova - verso 5" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/1/paragrafo/10/exprFrag1/33>	ns3:efChars	"che segnoreggia il mondo de l'onore - verso 4" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/20/paragrafo/13/exprFrag/409>	ns3:efChars	"CHE ... DIVISO" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/9/paragrafo/9/exprFrag/184>	ns3:efChars	"D'ONNE VALOR V\u00D2TO" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/1/paragrafo/15/exprFrag1/52>	ns3:efChars	"tel foiz sera qu'il t'ert avis / que tu tendras cele au cler vis / entre tes braz trestote nue / ausi con s'el fust devenue / dou tot t'amie et ta compaigne - 2425-9" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/13/paragrafo/6/exprFrag/260>	ns3:efChars	"VENIANO DICENDO" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/24/paragrafo/3/exprFrag1/620>	ns3:efChars	"e tr\u00F2voti a pensar troppo vilmente - verso 2" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/26/paragrafo/3/exprFrag1/634>	ns3:efChars	"de la battaglia ch'ell'\u00E0ve dal core - verso 2" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/5/paragrafo/11/exprFrag/126>	ns3:efChars	"ALLORA ... CONOSCESSE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/13/paragrafo/6/exprFrag/261>	ns3:efChars	"CHE NON ... DIVENUTO" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/31/paragrafo/2/exprFrag/473>	ns3:efChars	"STUDIO" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/1/paragrafo/14/exprFrag/29>	ns3:efChars	"MARAVIGLIOSA VISIONE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/1/paragrafo/15/exprFrag1/54>	ns3:efChars	"Is, 58,7" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/24/paragrafo/3/exprFrag1/621>	ns3:efChars	"Or non ardisco, per la vil tua vita - verso 9" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/6/paragrafo/4/exprFrag/146>	ns3:efChars	"DOLCE A UDIRE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/31/paragrafo/2/exprFrag/474>	ns3:efChars	"COLUI A CUI TUTTE LE COSE VIVONO" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/1/paragrafo/14/exprFrag/28>	ns3:efChars	"SOAVE SONNO" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/20/paragrafo/14/exprFrag1/595>	ns3:efChars	"Diletto frate mio, di pene involto - verso 12" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/1/paragrafo/15/exprFrag1/55>	ns3:efChars	"Diletto frate mio, di pene involto - verso 12" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/10/paragrafo/24/exprFrag1/329>	ns3:efChars	"ballatetta leggera e piana - verso 3" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/6/paragrafo/4/exprFrag/147>	ns3:efChars	"SEGUITINO" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/26/paragrafo/3/exprFrag1/636>	ns3:efChars	"Ancor pare a ciascuno molto grave / vostro parlare in terzo con altrui - versi 9-10" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/1/paragrafo/15/exprFrag1/56>	ns3:efChars	"clamydem coccineam circumdederunt ei - Mt 27, 28" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/31/paragrafo/2/exprFrag/475>	ns3:efChars	"DIRE DI LEI ... D'ALCUNA" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/1/paragrafo/14/exprFrag/27>	ns3:efChars	"PENSANDO DI LEI" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/1/paragrafo/15/exprFrag1/57>	ns3:efChars	"in quel punto / che quella donna mi degn\u00F2 guardare - versi 9-10" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/10/paragrafo/24/exprFrag/221>	ns3:efChars	"PER FIGLIUOLA ... PIANA" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/10/paragrafo/20/exprFrag1/312>	ns3:efChars	"Passa per via adorna, e s\u00EC gentile - verso 9" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/14/paragrafo/9/exprFrag/281>	ns3:efChars	"IO PORTO GI\u00C0 LO TUO COLORE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/10/paragrafo/24/exprFrag/222>	ns3:efChars	"PIANA" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/5/paragrafo/11/exprFrag/127>	ns3:efChars	"NELLI MIEI SONNI" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/5/paragrafo/11/exprFrag/128>	ns3:efChars	"TU AUTEM NON SIC" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/10/paragrafo/20/exprFrag1/314>	ns3:efChars	"Amore ha in s\u00E9 vertode: / del vile uom face prode, / s'egli \u00E8 villano in cortesia lo muta - versi 33-5" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/4/paragrafo/9/exprFrag/104>	ns3:efChars	"L'ALTRIER" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/16/paragrafo/6/exprFrag/326>	ns3:efChars	"FARE INTENDERE LE SUE PAROLE A DONNA" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/4/paragrafo/9/exprFrag/105>	ns3:efChars	"TROVAI" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/12/paragrafo/2/exprFrag/243>	ns3:efChars	"SUPERBIA E IRA" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/12/paragrafo/2/exprFrag/242>	ns3:efChars	"FUGGE ... IRA" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/10/paragrafo/21/exprFrag1/316>	ns3:efChars	"ch'abassa orgoglio a cui dona salute - verso 10" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/10/exprFrag1/511>	ns3:efChars	"ch'abassa orgoglio a cui dona salute - verso 10" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/25/paragrafo/4/exprFrag1/633>	ns3:efChars	"ben pare allor che 'l core gli si schianti - verso 32" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/12/paragrafo/2/exprFrag/241>	ns3:efChars	"NEGLI OCCHI ... AMORE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/16/paragrafo/6/exprFrag/327>	ns3:efChars	"COLORO ... AMOROSA" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/12/paragrafo/2/exprFrag/240>	ns3:efChars	"NEGLI OCCHI ... GENTILE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/4/paragrafo/9/exprFrag/103>	ns3:efChars	"CAVALCANDO" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/25/paragrafo/4/exprFrag1/632>	ns3:efChars	"che par che 'l cor dal corpo mi si schianti - verso 6" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/10/paragrafo/21/exprFrag1/318>	ns3:efChars	"ancor ve dir\u00F2 c'ha maggior vertute: / null'om p\u00F2 mal pensar fin che la vede - versi 13-4" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/4/paragrafo/9/exprFrag1/165>	ns3:efChars	"L'altrier - verso 1" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/25/paragrafo/4/exprFrag1/630>	ns3:efChars	"Cosa m'aven, quand'i' le son presente, / ch'i' no la posso a lo 'ntelletto dire - versi 5-6" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/7/paragrafo/10/exprFrag1/254>	ns3:efChars	"Qualunqu'\u00E8 quei che pi\u00F9 allegrezza sente, / se vedesse li spirti fuggir via, / di grande sua pietate piangeria - versi 12-4" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/14/paragrafo/12/exprFrag1/343>	ns3:efChars	"Qualunqu'\u00E8 quei che pi\u00F9 allegrezza sente, / se vedesse li spirti fuggir via, / di grande sua pietate piangeria - versi 12-4" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/15/paragrafo/7/exprFrag1/464>	ns3:efChars	"Lo su' gentile spirito che ride - verso 8" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/4/paragrafo/9/exprFrag1/158>	ns3:efChars	"L'autrier - verso 1" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/4/paragrafo/9/exprFrag1/164>	ns3:efChars	"L'autrier - verso 1" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/4/paragrafo/9/exprFrag1/161>	ns3:efChars	"L'autrier - verso 1" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/4/paragrafo/9/exprFrag1/163>	ns3:efChars	"L'autr' ier - verso 1" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/7/paragrafo/7/exprFrag1/249>	ns3:efChars	"Ma ci\u00F2 ch'eo dico non tener a gabbo - verso 12" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/4/paragrafo/9/exprFrag1/162>	ns3:efChars	"L'autre - verso 1" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/4/paragrafo/9/exprFrag1/160>	ns3:efChars	"L'autre - verso 1" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/7/paragrafo/7/exprFrag1/248>	ns3:efChars	"ch\u00E9 ciascun de la sua gabbo se fae - verso 18" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/7/paragrafo/7/exprFrag1/247>	ns3:efChars	"paura forte che gabbo non faccia - verso 13" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/17/paragrafo/7/exprFrag/360>	ns3:efChars	"D\u00C0 PER GLI OCCHI" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/7/paragrafo/7/exprFrag1/246>	ns3:efChars	"gabbo e non laudo, laudar l'om nesciente - verso 8" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/19/paragrafo/8/exprFrag/389>	ns3:efChars	"CONDIZIONE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/7/paragrafo/7/exprFrag1/245>	ns3:efChars	"tegna altrui in tal gabbo - verso 32" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/19/paragrafo/8/exprFrag/388>	ns3:efChars	"PRINCIPI DELLA TERRA" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/23/paragrafo/9/exprFrag/426>	ns3:efChars	"AMOR ... CORE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/7/paragrafo/7/exprFrag1/244>	ns3:efChars	"e doglia con color trafigurato - verso 6" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/14/paragrafo/7/exprFrag1/333>	ns3:efChars	"e doglia con color trafigurato - verso 6" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/1/paragrafo/22/exprFrag/52>	ns3:efChars	"M'APPARVE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/9/paragrafo/9/exprFrag1/279>	ns3:efChars	"Vedeste, al mio parere onne valore - verso 1" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/19/paragrafo/8/exprFrag/387>	ns3:efChars	"DESOLATA CITTADE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/23/paragrafo/9/exprFrag/427>	ns3:efChars	"CORE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/6/paragrafo/8/exprFrag1/227>	ns3:efChars	"Tuit mei consir son d'amor e de chan - verso 1" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/12/paragrafo/3/exprFrag/244>	ns3:efChars	"OGNE DOLCEZZA ... NEL CORE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/20/paragrafo/8/exprFrag/395>	ns3:efChars	"SON RIMASI OMAI" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/17/paragrafo/7/exprFrag/361>	ns3:efChars	"CHE 'NTENDER ... PROVA" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/20/paragrafo/8/exprFrag/394>	ns3:efChars	"\u00C0NNO ... PENA" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/17/paragrafo/7/exprFrag/362>	ns3:efChars	"E PAR CHE ... D'AMORE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/12/paragrafo/3/exprFrag/246>	ns3:efChars	"CHI PRIMA LA VIDE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/17/paragrafo/7/exprFrag/363>	ns3:efChars	"CHE VA DICENDO ... SOSPIRA" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/12/paragrafo/3/exprFrag/245>	ns3:efChars	"OND'\u00C8 LAUDATO" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/2/paragrafo/16/exprFrag1/131>	ns3:efChars	"importa povert\u00E0 di gioi d'amore - verso 2" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/11/paragrafo/5/exprFrag/235>	ns3:efChars	"BILTATE ... COSTUI" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/12/paragrafo/2/exprFrag1/358>	ns3:efChars	"cotanto d'umilt\u00E0 donna mi pare / ch'ogn'altra ver' di lei i' la chiam' ira - versi 7-8" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/11/paragrafo/5/exprFrag/236>	ns3:efChars	"CHE ... AMORE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/10/paragrafo/33/exprFrag/226>	ns3:efChars	"TROPPI" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/5/paragrafo/19/exprFrag1/208>	ns3:efChars	"Di': \u00ABQuelli che mi manda a voi tr\u00E2 guai - verso 28" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/5/paragrafo/2/exprFrag/109>	ns3:efChars	"DISTRUGGITRICE DI TUTTI LI VIZII" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/12/paragrafo/2/exprFrag1/359>	ns3:efChars	"s\u00EC gentile, / ch'abassa orgoglio a cui dona salute - versi 9-10" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/5/paragrafo/2/exprFrag/108>	ns3:efChars	"SOVERCHIEVOLE BOCE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/15/paragrafo/8/exprFrag1/465>	ns3:efChars	"ella sar\u00E0 del meo cor beatrice. - verso 4" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/17/paragrafo/2/exprFrag1/523>	ns3:efChars	"Tutta vi fece loda vera Iddio, / benigno consiglier de la Natura,/ donandovi in quell'or la sua vertute / quando compose di tanta salute / la vostra gentilissima figura - versi 15-9" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/14/paragrafo/20/exprFrag/286>	ns3:efChars	"CHE ... ALTRUI" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/14/paragrafo/20/exprFrag/287>	ns3:efChars	"NON \u00C0I VALORE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/17/paragrafo/2/exprFrag1/522>	ns3:efChars	"Benedictus Dominus Deus Israel, qui facit mirabilia - Ps 71, 18" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/26/paragrafo/3/exprFrag/436>	ns3:efChars	"BATTAGLIA" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/14/paragrafo/20/exprFrag/288>	ns3:efChars	"VOI" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/17/paragrafo/2/exprFrag1/521>	ns3:efChars	"Non nobis, Domine, non nobis, sed nomini tuo da gloriam - Ps 113, 9" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/26/paragrafo/3/exprFrag/437>	ns3:efChars	"MISERO" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/1/paragrafo/15/exprFrag/37>	ns3:efChars	"SANGUIGNO" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/1/paragrafo/15/exprFrag/38>	ns3:efChars	"M'AVEA ... DEGNATO DI SALUTARE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/1/paragrafo/15/exprFrag/35>	ns3:efChars	"UNA PERSONA DORMIRE NUDA" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/2/paragrafo/2/exprFrag1/100>	ns3:efChars	"Di voi lo core ne port\u00F2, veggendo/ che vostra donna alla morte cadea:/nodriala dello cor, di ci\u00F2 temendo. - versi 9 - 11" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/6/paragrafo/2/exprFrag1/218>	ns3:efChars	"un dolce amor s\u00EC bono - Verso 12" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/4/paragrafo/9/exprFrag1/159>	ns3:efChars	"L'altrer - verso 1" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/1/paragrafo/15/exprFrag/36>	ns3:efChars	"INVOLTA" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/6/paragrafo/2/exprFrag1/217>	ns3:efChars	"Bonus est Dominus sperantibus in eum - Lam 3, 25" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/16/paragrafo/10/exprFrag1/513>	ns3:efChars	"In te non trovo mai ch'uno difetto: / che vai dicendo intra la savia gente / faresti Amore piangere in tuo stato. / Non credo, poi non vede: quest'\u00E8 piano - versi 8-11" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/8/paragrafo/6/exprFrag/178>	ns3:efChars	"SI CR\u00CFA ... / DEGLI OCCHI" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/8/paragrafo/6/exprFrag/179>	ns3:efChars	"DI LOR MORTE VOGLIA" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/16/paragrafo/10/exprFrag1/511>	ns3:efChars	"logica, nonch\u00E9 d'imperizia a formare un sofismo / per silabate carte (vv. 7-8)" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/8/paragrafo/6/exprFrag/176>	ns3:efChars	"VEDE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/17/paragrafo/2/exprFrag/350>	ns3:efChars	"CORONATA E VESTITA D'UMILT\u00C0" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/12/paragrafo/4/exprFrag/247>	ns3:efChars	"QUEL ... MENTE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/24/paragrafo/8/exprFrag/432>	ns3:efChars	"NELL'ANIMA TRISTA" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/16/paragrafo/10/exprFrag1/510>	ns3:efChars	"difetto di saver - v. 6;" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/8/paragrafo/6/exprFrag/177>	ns3:efChars	"SBIGOTTITA" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/10/paragrafo/15/exprFrag/201>	ns3:efChars	"DONNE CH'AVETE ... RISPLENDE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/1/paragrafo/12/exprFrag1/37>	ns3:efChars	"vestimenta eius facta sunt splendentia et candida nimis (\u2026) nubes obumbrans eos - Mc 9, 2-12" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/17/paragrafo/2/exprFrag/351>	ns3:efChars	"NULLA GLORIA MOSTRANDO" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/1/paragrafo/12/exprFrag1/38>	ns3:efChars	"Passa per via - verso 9" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/17/paragrafo/2/exprFrag/352>	ns3:efChars	"BENEDETTO SIA LO SIGNORE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/17/paragrafo/2/exprFrag/353>	ns3:efChars	"CHE S\u00CC MIRABILEMENTE SA OPERARE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/7/paragrafo/4/exprFrag/158>	ns3:efChars	"ALLORA DICO CHE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/1/paragrafo/12/exprFrag1/36>	ns3:efChars	"masculus ante decimum octavum annum verus esse non potest amans - I V" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/7/paragrafo/10/exprFrag/165>	ns3:efChars	"ALTRUI" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/5/paragrafo/2/exprFrag/110>	ns3:efChars	"REGINA DELLE VERTUDI" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/20/paragrafo/16/exprFrag1/599>	ns3:efChars	"Deus meus, Deus meus, ut quid dereliquisti me? - Mt 27, 46" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/7/paragrafo/4/exprFrag/157>	ns3:efChars	"PER TUTTE LE PARTI DEL MIO CORPO" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/5/paragrafo/2/exprFrag/111>	ns3:efChars	"TUTTA LA MIA BEATITUDINE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/20/paragrafo/16/exprFrag1/598>	ns3:efChars	"Or non ardisco, per la vil tua vita, - Verso 9" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/10/paragrafo/15/exprFrag/204>	ns3:efChars	"LA MENTE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/27/paragrafo/2/exprFrag1/647>	ns3:efChars	"e trovoti a pensar troppo vilmente - verso 2" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/1/paragrafo/12/exprFrag1/39>	ns3:efChars	"repleta est Spiritu sancto Elisabeth - Lc 1, 39-56" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/10/paragrafo/33/exprFrag1/333>	ns3:efChars	"assai laudata \u2013 sar\u00E0 tua ragione / da le persone \u2013 c'hanno intendimento: / di star con l'altre tu non hai talento - 73-5" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/20/paragrafo/16/exprFrag1/597>	ns3:efChars	"e trovoti a pensar troppo vilmente - Verso 2" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/10/paragrafo/15/exprFrag/203>	ns3:efChars	"DIRE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/10/paragrafo/15/exprFrag/202>	ns3:efChars	"INTELLETTO" .
