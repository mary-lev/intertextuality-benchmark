<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/34/paragrafo/11/exprFrag1/959>	ns3:efChars	"verso 6" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/11/exprFrag/288>	ns3:efChars	"Cosa" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/39/paragrafo/3/exprFrag1/990>	ns3:efChars	"in guisa ch'i' non so l\u00E0 'v'i' mi sia" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/11/exprFrag/287>	ns3:efChars	"v. 43. Dice di lei Amor" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/20/paragrafo/5/exprFrag1/598>	ns3:efChars	"Dal cor si move spirito in vedere - verso 1" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/12/paragrafo/14/exprFrag/161>	ns3:efChars	"pace" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/20/paragrafo/5/exprFrag1/597>	ns3:efChars	"de cosa piacente / savemo de vert\u00E0 ch'\u00E8 nato amore - versi 5-6" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/12/paragrafo/14/exprFrag/160>	ns3:efChars	"sdonnei" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/21/paragrafo/2/exprFrag1/620>	ns3:efChars	"sento che 'l su' valor mi fa tremare - verso 17" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/27/paragrafo/4/exprFrag1/870>	ns3:efChars	"Rappresentazione dell'amore tormentoso: \"se vedesse li spirti fuggir via\" - verso 13" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/27/paragrafo/4/exprFrag1/871>	ns3:efChars	"deboletta" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/3/paragrafo/3/exprFrag1/50>	ns3:efChars	"fu 'l dolce sonno ch'allor si compiea - verso 13" .
