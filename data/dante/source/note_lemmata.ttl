<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/23/paragrafo/20/exprFrag/383>	ns3:efChars	"colore" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/3/paragrafo/10/exprFrag1/80>	ns3:efChars	"i' prego quei nel cui cospetto v\u00E9ne - I verso 5" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/21/paragrafo/2/exprFrag1/625>	ns3:efChars	"superbos . . . solet humilitate beare - I, 4" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/10/exprFrag/286>	ns3:efChars	"V. 40. l'umilia" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/9/exprFrag1/498>	ns3:efChars	"versi 31 e 69" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/5/exprFrag1/478>	ns3:efChars	"versi 31 e 69" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/21/paragrafo/2/exprFrag1/627>	ns3:efChars	"da s\u00E9 diparte orgoglio e villania - verso 7" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/35/paragrafo/1/exprFrag/546>	ns3:efChars	"de fore" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/22/paragrafo/9/exprFrag/355>	ns3:efChars	"v. 6. bagnar" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/15/paragrafo/6/exprFrag1/395>	ns3:efChars	"n\u00E9 aggiate... figura di morte in vostro petto - verso 40" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/21/paragrafo/2/exprFrag1/628>	ns3:efChars	"cotanto d'umilt\u00E0 donna mi pare, / ch'ogn'altra ver' di lei i' la chiam'ira - versi 7-8" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/4/paragrafo/1/exprFrag1/100>	ns3:efChars	"Ciascun mi guarda in viso e fa dimando, / veggendomi cangiato lo visag gio ; / ed io celo la doglia mia in parlando - versi 9-11" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/10/paragrafo/3/exprFrag1/190>	ns3:efChars	"versi 9-14" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/9/exprFrag/281>	ns3:efChars	"quando va per via" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/12/paragrafo/2/exprFrag/127>	ns3:efChars	"chiamando" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/27/paragrafo/4/exprFrag/483>	ns3:efChars	"chiamando" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/8/paragrafo/6/exprFrag1/153>	ns3:efChars	"Lo vostro fermo dir fino ed orrato - verso 1" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/4/exprFrag1/474>	ns3:efChars	"ma dubito non mo' possa fornire / in proferer ci\u00F2 ch'i' ho in pensamento - versi 5-6" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/24/paragrafo/7/exprFrag/412>	ns3:efChars	"io mi senti' \u2026 dormia" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/12/paragrafo/2/exprFrag/128>	ns3:efChars	"la donna de la cortesia" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/12/paragrafo/2/exprFrag/126>	ns3:efChars	"sollenato" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/9/exprFrag/282>	ns3:efChars	"pere" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/3/paragrafo/10/exprFrag1/81>	ns3:efChars	"Se '1 presente sonetto spesso leggi - verso 12" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/8/paragrafo/6/exprFrag1/154>	ns3:efChars	"io veggio Amor visibil che l'adora / e falle riverenza - versi 13-4" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/4/exprFrag1/473>	ns3:efChars	"che bene en sua ragione [ossia \u00ABde vostro pregio dir\u00BB] / non crederea gi\u00E0 mai poter f\u00ECnare - versi 112-3" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/14/paragrafo/12/exprFrag1/349>	ns3:efChars	"e s'ella sente pur un poco Amore / pi\u00F9 presso a lui [il cuore] che non s\u00F2le, ella more\u00BB (\u00ABSta come quella che non ha valore, / ch' \u00E8 per temenza da lo cor partita - versi 3-6" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/24/paragrafo/7/exprFrag/413>	ns3:efChars	"Or pensa \u2026 di" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/9/exprFrag/283>	ns3:efChars	"nobil cosa" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/2/paragrafo/5/exprFrag/13>	ns3:efChars	"Apparuit iam" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/16/paragrafo/7/exprFrag/239>	ns3:efChars	"v. 3. venmene" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/9/exprFrag/284>	ns3:efChars	"0 si morria" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/2/paragrafo/5/exprFrag/12>	ns3:efChars	"lo spirito animale" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/4/exprFrag1/475>	ns3:efChars	"son temente, / s'io laudo, no 'l mio laudo aggia valore - versi 9-10" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/12/paragrafo/4/exprFrag/132>	ns3:efChars	"parea che attendesse" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/11/exprFrag/290>	ns3:efChars	"adorna" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/3/paragrafo/10/exprFrag1/86>	ns3:efChars	"76, 15-6" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/15/paragrafo/1/exprFrag1/363>	ns3:efChars	"V\u00E8n, che m'uccide, uno sottil pensero, / che par che dica ch'i' mai no la veggia: / questo \u00E8 tormento disperato e fero /che strugg'e dole e 'ncende ed amareggia - versi 11-4" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/14/paragrafo/4/exprFrag1/322>	ns3:efChars	"l'anima tremando si riscosse / veggendo morto 'l cor nel lato manco - versi 13-4" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/14/paragrafo/12/exprFrag1/346>	ns3:efChars	"Savere" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/8/paragrafo/6/exprFrag1/157>	ns3:efChars	"Dolze riviera gaia ed amorosa - verso 37" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/12/paragrafo/4/exprFrag/133>	ns3:efChars	"Segnore de la nobiltade" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/3/paragrafo/10/exprFrag1/85>	ns3:efChars	"Guido, quel Gianni ch'a te fu l'atrieri / salute - versi 1-2" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/3/paragrafo/10/exprFrag/50>	ns3:efChars	"cio\u00E8 Amore" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/14/paragrafo/12/exprFrag1/345>	ns3:efChars	"Ma s\u00EC \u00E8 al cor dolente tanta noia / e all'anima trista \u00E8 tanto danno, / che per disdegno uom non [nessuno] d\u00E0 lor salute" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/11/exprFrag/292>	ns3:efChars	"v. 46. ne 'ntenda di far" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/3/paragrafo/10/exprFrag1/88>	ns3:efChars	"Nonn-oso nominare" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/12/paragrafo/4/exprFrag/134>	ns3:efChars	"Ego tanquam" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/12/paragrafo/4/exprFrag/135>	ns3:efChars	"Ego tanquam" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/24/paragrafo/7/exprFrag/414>	ns3:efChars	"pur" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/14/paragrafo/12/exprFrag1/344>	ns3:efChars	"Se voi sentiste come 'l cor si dole - verso 11" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/8/paragrafo/6/exprFrag1/155>	ns3:efChars	"Tu gli ha' lasciati s\u00EC, che venne Amore / a pianger sovra lor pietosamente - versi 9-10" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/11/exprFrag/291>	ns3:efChars	"pura" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/9/exprFrag/280>	ns3:efChars	"qual vuol \u2026 vada" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/3/paragrafo/10/exprFrag1/87>	ns3:efChars	"Gianni, quel Guido salute / ne la tua bella e dolce salute - versi 1-2" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/8/paragrafo/6/exprFrag1/156>	ns3:efChars	"Gentile ed amorosa ed avenente, / cortese e saggia con gaia sembianza - versi 1-2" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/21/paragrafo/2/exprFrag1/609>	ns3:efChars	"O tu, che porti nelli occhi sovente / Amor - versi 1-2" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/2/exprFrag1/458>	ns3:efChars	"ex abundantia . . . cordis os loquitur - Lc., vi, 45" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/11/exprFrag/294>	ns3:efChars	"v. 47. Color di perle" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/2/paragrafo/4/exprFrag1/20>	ns3:efChars	"versi 8-10" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/4/exprFrag1/465>	ns3:efChars	"versi 8-10" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/2/exprFrag1/457>	ns3:efChars	"ex abundantia . . . cordis os loquitur - Mt., xii, 34" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/26/paragrafo/11/exprFrag1/861>	ns3:efChars	"l'invidia regna ov'\u00E8 paraggio\u00BB; \u00ABma questa \u00E8 senza pare\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/34/paragrafo/9/exprFrag1/956>	ns3:efChars	"le quali hanno destrutto s\u00EC costui - verso 9" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/11/exprFrag/293>	ns3:efChars	"nova" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/24/paragrafo/2/exprFrag1/726>	ns3:efChars	"verso 4" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/12/paragrafo/13/exprFrag1/249>	ns3:efChars	"verso 4" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/22/paragrafo/14/exprFrag1/658>	ns3:efChars	"verso 4" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/32/paragrafo/6/exprFrag1/939>	ns3:efChars	"verso 4" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/2/paragrafo/4/exprFrag1/21>	ns3:efChars	"versi 10-11" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/8/paragrafo/6/exprFrag1/159>	ns3:efChars	"Ahi gentil donna gaia ed amorosa - verso 1" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/2/exprFrag/260>	ns3:efChars	"quasi come per s\u00E9 stessa mossa" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/34/paragrafo/9/exprFrag1/955>	ns3:efChars	"s\u00EC feramente, che distrugge 'l core - verso 11" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/2/exprFrag1/456>	ns3:efChars	"non p\u00F2 cor pensare / n\u00E9 lingua devisare - versi 13-4" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/8/paragrafo/8/exprFrag1/170>	ns3:efChars	"non p\u00F2 cor pensare / n\u00E9 lingua devisare - versi 13-4" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/26/paragrafo/5/exprFrag1/832>	ns3:efChars	"versi 22-3" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/12/paragrafo/15/exprFrag1/261>	ns3:efChars	"per sua cortesia / ti far\u00E0 molto onore - versi 5-6" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/24/paragrafo/2/exprFrag1/727>	ns3:efChars	"Lc 11,27" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/11/exprFrag/296>	ns3:efChars	"v. 50. per essemplo di lei" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/26/paragrafo/5/exprFrag1/831>	ns3:efChars	"s'i' 'l vo' contare, / sento che 'l su' valor mi fa tremare; / e movonsi nell'anima sospiri - versi 16-8" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/2/exprFrag1/455>	ns3:efChars	"exultabit lingua mea iustitiam tuam. Domine, labia mea aperies; et os meum annuntiabit laudem tuam - Ps L 16-7" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/12/paragrafo/4/exprFrag/131>	ns3:efChars	"che io lo conoscesse" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/24/paragrafo/2/exprFrag1/728>	ns3:efChars	"Iob 3,3" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/11/exprFrag/295>	ns3:efChars	"v. quanto de ben" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/34/paragrafo/9/exprFrag1/954>	ns3:efChars	"Amor, che lo tuo grande valor sente - verso 5" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/13/paragrafo/5/exprFrag/174>	ns3:efChars	"ti stringe" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/3/paragrafo/5/exprFrag1/63>	ns3:efChars	"guardi costui, e veder\u00E0 '1 su' core / che Morte '1 porta 'n man tagliato in croce - versi 13-4" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/8/paragrafo/5/exprFrag1/151>	ns3:efChars	"Ov'\u00E8 madonna e lo suo insegnamento, / la sua bellezza e la gran cono- scianza, / lo dolze r\u00ECso e lo bel parlamento, / gli occhi e la bocca e la bella sembianza, / e lo suo adornamento e cortesia? - versi 31 e sgg." .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/26/paragrafo/5/exprFrag1/830>	ns3:efChars	"si che parlare / null'omo pot\u00E8, ma ciascun sospira - versi 3-4" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/4/exprFrag1/471>	ns3:efChars	"De la mia donna vo' cantar con voi - verso 1" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/4/exprFrag1/470>	ns3:efChars	"Io voglio del ver la mia donna laudare - verso 1" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/2/exprFrag1/459>	ns3:efChars	"et immisit in os meum canticum novum, Carmen Deo nostro - Ps xxxix, 4" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/8/paragrafo/5/exprFrag1/150>	ns3:efChars	"quel offende quanto \u00E8 da pregiare - verso 13" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/24/paragrafo/3/exprFrag/403>	ns3:efChars	"di famosa bieltade" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/16/exprFrag/309>	ns3:efChars	"ridicendo anche" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/33/paragrafo/8/exprFrag1/952>	ns3:efChars	"e tanto pi\u00F9 quant'\u00E8 me' conosciuta - verso 66" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/14/paragrafo/12/exprFrag/210>	ns3:efChars	"v. 8. baldanza e \u2026 sicurtate" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/21/paragrafo/2/exprFrag1/610>	ns3:efChars	"Io vidi li occhi dove Amor si mise - verso 1" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/8/exprFrag1/496>	ns3:efChars	"Io vidi li occhi dove Amor si mise - verso 1" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/9/paragrafo/1/exprFrag1/178>	ns3:efChars	"Cosa m'av\u00E8n, quand'i' le son presente, / ch'i' no la posso a Io 'ntelletto dire - versi 5-6" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/3/paragrafo/5/exprFrag1/60>	ns3:efChars	"vide humilitatem meam - Ps., IX, 14" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/2/paragrafo/4/exprFrag1/16>	ns3:efChars	"Spiritus . .. vitalis ... a corde oritur et per arterias pulsando per totum corpus dirigitur a sinistro cordis - i, ii, 2-4" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/2/paragrafo/4/exprFrag1/13>	ns3:efChars	"Spiritus . .. vitalis ... a corde oritur et per arterias pulsando per totum corpus dirigitur a sinistro cordis - i, ii, 2-4" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/8/exprFrag/277>	ns3:efChars	"v. 28. io vidi" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/15/paragrafo/6/exprFrag1/388>	ns3:efChars	"versi 12-4" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/3/paragrafo/10/exprFrag/49>	ns3:efChars	"in lor segnor" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/12/paragrafo/11/exprFrag1/237>	ns3:efChars	"l\u00E0 dove piace a voi di gire andate - verso 26" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/16/exprFrag/308>	ns3:efChars	"dico a cu' io dicer voglio" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/33/paragrafo/5/exprFrag/534>	ns3:efChars	"v. 7. porterai" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/21/paragrafo/2/exprFrag1/611>	ns3:efChars	"Veggio negli occhi de la donna mia / un lume pien di spiriti d'a more - 1-2" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/14/paragrafo/12/exprFrag/211>	ns3:efChars	"v. 9. fere" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/25/paragrafo/7/exprFrag/429>	ns3:efChars	"prosaici dittatori" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/15/paragrafo/6/exprFrag1/389>	ns3:efChars	"versi 2,4,8 per le rime" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/2/paragrafo/4/exprFrag1/15>	ns3:efChars	"l'anima sento per lo cor tremare - verso 20" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/11/exprFrag1/515>	ns3:efChars	"che di dolcezza ne sospir' Amore - verso 3" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/23/paragrafo/21/exprFrag1/711>	ns3:efChars	"che di dolcezza ne sospir' Amore - verso 3" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/14/paragrafo/12/exprFrag/212>	ns3:efChars	"tormentosi" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/8/paragrafo/10/exprFrag/107>	ns3:efChars	"hai partita" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/14/paragrafo/4/exprFrag/193>	ns3:efChars	"Allora dico che" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/24/paragrafo/2/exprFrag/401>	ns3:efChars	"Allora dico che" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/3/paragrafo/5/exprFrag1/62>	ns3:efChars	"scito cor meum - Ps., cxxxviii, 23" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/8/exprFrag/275>	ns3:efChars	"parla Dio" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/24/paragrafo/3/exprFrag/404>	ns3:efChars	"questo primo mio amico" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/8/paragrafo/10/exprFrag/108>	ns3:efChars	"cortesia" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/14/paragrafo/4/exprFrag/192>	ns3:efChars	"incominciare \u2026 da la sinistra parte" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/3/paragrafo/5/exprFrag1/61>	ns3:efChars	"vide afflictionem meam - Lam., i, 9" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/24/paragrafo/3/exprFrag/405>	ns3:efChars	"imposto l'era" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/15/paragrafo/6/exprFrag1/387>	ns3:efChars	"Allor d'un uom che sia pietoso miro / che consolasse mia vita dolente - versi 12-4" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/8/exprFrag/276>	ns3:efChars	"v. 24. sofferite in pace" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/31/paragrafo/15/exprFrag/522>	ns3:efChars	"strugge" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/11/exprFrag1/517>	ns3:efChars	"dical Amor, ch'i' noi savria contare - verso 6" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/5/paragrafo/2/exprFrag/61>	ns3:efChars	"Vedi come" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/11/paragrafo/4/exprFrag1/205>	ns3:efChars	"passa e avanza / natura e costumanza - versi 23-4" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/2/paragrafo/4/exprFrag1/12>	ns3:efChars	"in illo tempore" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/2/paragrafo/4/exprFrag/10>	ns3:efChars	"ne li menimi polsi" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/24/paragrafo/2/exprFrag1/729>	ns3:efChars	"Ier 20,14" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/11/exprFrag1/516>	ns3:efChars	"ch'i' trovo Amor che dice - verso 20" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/5/paragrafo/2/exprFrag/60>	ns3:efChars	"dicere" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/11/exprFrag1/519>	ns3:efChars	"Ahi Deo, co s\u00EC novella / pot\u00E8 a esto mondo dimorar figura - versi 16-7" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/33/paragrafo/5/exprFrag/533>	ns3:efChars	"la dolorosa mente" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/12/paragrafo/11/exprFrag1/236>	ns3:efChars	"Tu puoi sicuramente gir, canzone - verso 71" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/15/paragrafo/1/exprFrag/216>	ns3:efChars	"forte" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/16/paragrafo/2/exprFrag1/398>	ns3:efChars	"De la gran doglia che l'anima sente - verso 9" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/11/exprFrag1/518>	ns3:efChars	"In questo mondo non ha creatura / s\u00EC piena di bielt\u00E0 n\u00E9 di piacere - versi 5-6" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/22/paragrafo/14/exprFrag1/659>	ns3:efChars	"rima Guittoniana" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/33/paragrafo/8/exprFrag1/951>	ns3:efChars	"versi 23-5" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/16/paragrafo/7/exprFrag/240>	ns3:efChars	"a persona" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/2/paragrafo/4/exprFrag/11>	ns3:efChars	"Ecce deus" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/16/paragrafo/2/exprFrag1/396>	ns3:efChars	"II, III, 103-31" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/14/paragrafo/12/exprFrag1/353>	ns3:efChars	"E' v\u00E8n tagliando di s\u00EC gran valore, / che' deboletti spiriti van via - versi 5-6" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/21/paragrafo/2/exprFrag1/619>	ns3:efChars	"tremito: topos dell'esperienza amorosa" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/4/exprFrag1/469>	ns3:efChars	"Quando 'l penser mi v\u00E8n ch'i' voglia dire / a gentil core de la sua vertute - versi 29-30" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/33/paragrafo/1/exprFrag1/940>	ns3:efChars	"verso 23" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/14/paragrafo/12/exprFrag1/354>	ns3:efChars	"Voi che per li occhi mi passaste 'l core, / guardate a l'angosciosa vita mia, / che sospirando la distrugge Amore - versi 1-3" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/16/paragrafo/2/exprFrag1/397>	ns3:efChars	"versi 3 e sgg" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/21/paragrafo/2/exprFrag1/617>	ns3:efChars	"versi 38-9" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/3/paragrafo/10/exprFrag/44>	ns3:efChars	"gentil core" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/21/paragrafo/2/exprFrag1/618>	ns3:efChars	"non p\u00F2 'maginare / ch'om d'esto mondo l'ardisca mirare / che non convegna lui tremare in pria - versi 21-3" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/3/paragrafo/10/exprFrag/43>	ns3:efChars	"v. 1. presa" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/14/paragrafo/12/exprFrag1/352>	ns3:efChars	"LI, 7" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/3/paragrafo/10/exprFrag/46>	ns3:efChars	"rescrivan" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/21/paragrafo/2/exprFrag1/615>	ns3:efChars	"chi vo' non vede, ma' non p\u00F2 valere - verso 4" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/12/paragrafo/2/exprFrag1/207>	ns3:efChars	"per sollenar lo grande ardore - verso 55" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/21/paragrafo/2/exprFrag1/614>	ns3:efChars	"quando li occhi gira - verso 5" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/38/paragrafo/5/exprFrag1/987>	ns3:efChars	"L'anima mia vilment'\u00E8 sbigotita / de la battaglia ch'ell'ave dal core - versi 1-2" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/8/paragrafo/6/exprFrag/99>	ns3:efChars	"gaia" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/3/paragrafo/10/exprFrag/45>	ns3:efChars	"v. 2. dir" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/21/paragrafo/2/exprFrag1/616>	ns3:efChars	"ogn'om la mira - verso 1" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/12/paragrafo/2/exprFrag1/206>	ns3:efChars	"Fino Amor solena / del gran disio la pena - 2307" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/8/paragrafo/6/exprFrag/98>	ns3:efChars	"informa vera" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/12/paragrafo/2/exprFrag1/209>	ns3:efChars	"clamare ad Dominum" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/21/paragrafo/2/exprFrag1/612>	ns3:efChars	"Io veggio che negli occhi suoi risplende / una vert\u00F9 d'amor tanto gentile - versi 11-2" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/35/paragrafo/8/exprFrag/555>	ns3:efChars	"v. 14. andar \u2026 piangendo" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/3/paragrafo/10/exprFrag/48>	ns3:efChars	"v. 4. salute" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/3/paragrafo/10/exprFrag/47>	ns3:efChars	"suo parvente" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/8/paragrafo/6/exprFrag/97>	ns3:efChars	"v. 9. orranza" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/12/paragrafo/2/exprFrag1/208>	ns3:efChars	"ne solena sua greve doglienza - verso 9" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/21/paragrafo/2/exprFrag1/613>	ns3:efChars	"versi 13-4" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/13/paragrafo/5/exprFrag1/287>	ns3:efChars	"ma stringavi pietate - verso 86" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/33/paragrafo/7/exprFrag/537>	ns3:efChars	"v. 15. di pietate" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/12/paragrafo/13/exprFrag1/248>	ns3:efChars	"verso 41" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/36/paragrafo/4/exprFrag1/977>	ns3:efChars	"verso 41" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/31/paragrafo/10/exprFrag1/910>	ns3:efChars	"verso 41" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/26/paragrafo/2/exprFrag1/817>	ns3:efChars	"Benedictus Dominus Deus Israel, qui facit mirabilia solus - Ps 71,18" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/9/exprFrag1/509>	ns3:efChars	"Amore ha in s\u00E9 vertode: / del vile uom face prode, / s'egli \u00E8 villano in cortesia lo muta - Versi 33-5" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/40/paragrafo/4/exprFrag/578>	ns3:efChars	"le quali farebbero piangere" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/10/paragrafo/3/exprFrag/118>	ns3:efChars	"quello che ... in me vertuosamente operava" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/26/paragrafo/5/exprFrag/463>	ns3:efChars	"v. 1. gentile" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/26/paragrafo/2/exprFrag1/816>	ns3:efChars	"Benedictus Dominus qui [o quia]" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/26/paragrafo/5/exprFrag/464>	ns3:efChars	"pare" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/41/paragrafo/12/exprFrag/589>	ns3:efChars	"v. 11. al cor dolente" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/41/paragrafo/12/exprFrag/588>	ns3:efChars	"v. 11. al cor dolente" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/26/paragrafo/5/exprFrag/465>	ns3:efChars	"ogne lingua" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/13/paragrafo/5/exprFrag1/286>	ns3:efChars	"Meravigliosamente / un amor mi distringe - versi 1-2" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/26/paragrafo/5/exprFrag/466>	ns3:efChars	"v. 4. no l'ardiscon di guardare" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/14/paragrafo/7/exprFrag/199>	ns3:efChars	"trasfigurazione" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/18/paragrafo/5/exprFrag/253>	ns3:efChars	"l'acqua mischiata di bella neve" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/3/paragrafo/5/exprFrag/34>	ns3:efChars	"Vide cor tuum" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/18/paragrafo/5/exprFrag/254>	ns3:efChars	"questa donna che" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/20/paragrafo/4/exprFrag1/590>	ns3:efChars	"Audit'aggio nomare / che 'n gentil core amore / fa suo porto - versi 33-5" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/20/paragrafo/4/exprFrag1/591>	ns3:efChars	"dentro dal core si pone a sedere, / ca non poria in pi\u00F9 sicuro domo - versi 7-8" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/26/paragrafo/1/exprFrag/449>	ns3:efChars	"quando passava per via" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/8/paragrafo/5/exprFrag/92>	ns3:efChars	"v.5. villana Morte" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/8/paragrafo/5/exprFrag/93>	ns3:efChars	"v.5. villana Morte" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/9/exprFrag1/502>	ns3:efChars	"e no lle p\u00F2 apressare om che sia vile - verso 12" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/20/paragrafo/4/exprFrag1/592>	ns3:efChars	"ch\u00E9 'n cor gentil cortese fa locore / sempre l'amore - versi 15-6" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/9/paragrafo/1/exprFrag/110>	ns3:efChars	"non tanto fosse lontano" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/23/paragrafo/20/exprFrag/384>	ns3:efChars	"ragionar di morte" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/9/exprFrag1/501>	ns3:efChars	"Passa per via adorna e si gentile - verso 9" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/11/exprFrag1/523>	ns3:efChars	"di tante bellezze adorna v\u00E9ne - verso 16" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/33/paragrafo/7/exprFrag1/948>	ns3:efChars	"voce di dolore - verso 14" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/14/paragrafo/6/exprFrag1/332>	ns3:efChars	"Per li occhi passa come fa lo trono - cfr. versi 9-11" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/11/paragrafo/3/exprFrag/122>	ns3:efChars	"obumbrare" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/20/paragrafo/5/exprFrag/326>	ns3:efChars	"v. 13. svegliar" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/9/exprFrag1/500>	ns3:efChars	"Le donne che vi fanno compagnia / assa' mi piaccion per lo vostro onore - versi 9-10" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/23/paragrafo/20/exprFrag/385>	ns3:efChars	"umilemente" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/20/paragrafo/5/exprFrag/325>	ns3:efChars	"v. 11. la cosa piacente" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/11/exprFrag1/520>	ns3:efChars	"Segnore Dio, come pot\u00E8 venire / al mondo s\u00EC angelica figura? - versi 1-2" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/33/paragrafo/7/exprFrag1/949>	ns3:efChars	"che parla dolore" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/26/paragrafo/2/exprFrag1/810>	ns3:efChars	"veggendo s\u00EC angelica creatura - verso 8" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/23/paragrafo/20/exprFrag/386>	ns3:efChars	"v. 26. Che vedest\u00F9, che tu" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/11/paragrafo/3/exprFrag/123>	ns3:efChars	"soverchio" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/20/paragrafo/5/exprFrag/327>	ns3:efChars	"v. 14. si mil" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/11/exprFrag1/521>	ns3:efChars	"la gente n'\u00E8 tutta 'n errore / che terrena figura esser possiate - versi 7-8" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/11/paragrafo/3/exprFrag/124>	ns3:efChars	"come cosa grave inanimata" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/26/paragrafo/2/exprFrag1/813>	ns3:efChars	"Turba ergo quae stabat et audierat, dicebat tonitruum esse factum. Alii dicebant: Angelus ei locutus est - Gv 12,29" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/22/paragrafo/14/exprFrag/359>	ns3:efChars	"pui" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/20/paragrafo/5/exprFrag/323>	ns3:efChars	"pui" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/9/exprFrag1/506>	ns3:efChars	"versi 13-5" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/26/paragrafo/2/exprFrag1/812>	ns3:efChars	"Dicebant autem multi ex ipsis: Daemonium habet et insanit... Alii dicebant: Haec verba non sunt daemonium habentis. Numquid daemonium potest caecorum oculos aperire? - Gv 10,20-1" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/20/paragrafo/5/exprFrag/324>	ns3:efChars	"v. 10. piace a li occhi si" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/9/exprFrag1/505>	ns3:efChars	"versi 25-6" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/9/exprFrag1/504>	ns3:efChars	"versi 25-6" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/26/paragrafo/2/exprFrag1/815>	ns3:efChars	"Benedictus qui venit" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/9/exprFrag1/503>	ns3:efChars	"null'om p\u00F2 mal pensar fin che la vede - verso 14" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/26/paragrafo/2/exprFrag1/814>	ns3:efChars	"veggendo s\u00EC gran maraviglia - verso 11" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/20/paragrafo/5/exprFrag/322>	ns3:efChars	"v. 9. Bieltate appare in" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/20/paragrafo/3/exprFrag1/585>	ns3:efChars	"s\u00EC como l'Autore / pon - versi 72-3" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/39/paragrafo/8/exprFrag1/994>	ns3:efChars	"e non trovan persona che li miri - verso 8" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/26/paragrafo/13/exprFrag/476>	ns3:efChars	"la si \u2026 recare a mente" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/11/exprFrag1/529>	ns3:efChars	"s\u00EC piena di biltate e di valore - verso 8" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/7/paragrafo/3/exprFrag1/118>	ns3:efChars	"Lam I.12" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/26/paragrafo/13/exprFrag/477>	ns3:efChars	"v. 14. che non" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/31/paragrafo/11/exprFrag1/919>	ns3:efChars	"e ben chi non piange ha dur core - verso 3" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/11/exprFrag1/528>	ns3:efChars	"si piena di bielt\u00E0 n\u00E9 di piacere" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/31/paragrafo/11/exprFrag1/918>	ns3:efChars	"Lc 1,28" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/12/exprFrag1/551>	ns3:efChars	"che porta propiamente Amor nel viso - verso 14" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/11/exprFrag1/527>	ns3:efChars	"schiave / bell'e adorn'e di gentil costume - versi 13-4" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/20/paragrafo/3/exprFrag/320>	ns3:efChars	"v. 4. com'alma razionai" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/23/paragrafo/20/exprFrag/387>	ns3:efChars	"valore" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/11/exprFrag1/526>	ns3:efChars	"\u00E8 s\u00EC gentil e avenente / e tanta adorna - versi 6-7" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/33/paragrafo/7/exprFrag1/950>	ns3:efChars	"una voce d'allegrezza - verso 23" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/11/exprFrag1/525>	ns3:efChars	"saggia e adorna e accorta e sottile - verso 7" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/11/exprFrag1/537>	ns3:efChars	"verso 5" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/39/paragrafo/10/exprFrag1/997>	ns3:efChars	"verso 5" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/24/paragrafo/2/exprFrag/402>	ns3:efChars	"lo d\u00EC che io ti presi" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/12/exprFrag1/550>	ns3:efChars	"Metafora: immagine della donna dipinta nel cuore" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/11/exprFrag1/524>	ns3:efChars	"Passa per via adorna e s\u00EC gentile - verso 9" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/39/paragrafo/10/exprFrag1/998>	ns3:efChars	"la mente ov'\u00E8 Amore - verso 6" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/15/paragrafo/5/exprFrag1/379>	ns3:efChars	"morto colore - verso 7" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/24/paragrafo/6/exprFrag1/747>	ns3:efChars	"versi 1-3" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/18/paragrafo/4/exprFrag/251>	ns3:efChars	"la sua merzede" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/16/paragrafo/7/exprFrag/236>	ns3:efChars	"v. 1. Spesse fiate" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/11/paragrafo/4/exprFrag/125>	ns3:efChars	"redundava" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/18/paragrafo/4/exprFrag/252>	ns3:efChars	"in quello che non mi puote venire meno" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/6/paragrafo/1/exprFrag/63>	ns3:efChars	"s\u00EC mi venne una volontade di volere ricordare" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/39/paragrafo/8/exprFrag/568>	ns3:efChars	"che nascon de'" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/16/paragrafo/7/exprFrag/237>	ns3:efChars	"vegnonmi" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/39/paragrafo/9/exprFrag/571>	ns3:efChars	"di corona di mart\u00ECri" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/12/exprFrag1/553>	ns3:efChars	"versi 4-5" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/41/paragrafo/6/exprFrag/584>	ns3:efChars	"lo Filosofo" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/39/paragrafo/8/exprFrag/569>	ns3:efChars	"persona che li miri" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/16/paragrafo/7/exprFrag/238>	ns3:efChars	"v. 2. oscure" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/18/paragrafo/4/exprFrag/250>	ns3:efChars	"e in quello dimorava" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/39/paragrafo/9/exprFrag/570>	ns3:efChars	"v. 5. fatti son" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/12/paragrafo/15/exprFrag/162>	ns3:efChars	"onore" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/25/paragrafo/7/exprFrag1/782>	ns3:efChars	"Rett. 76, 14-6" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/7/paragrafo/3/exprFrag1/119>	ns3:efChars	"Vedete ch'i' son un che vo piangendo / e dimostrando il giudicio d'Amore, / e gi\u00E0 non trovo s\u00EC pietoso core / che, me guardando, una volta sospiri - versi 1-4" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/39/paragrafo/8/exprFrag1/992>	ns3:efChars	"d'angosciosi dilett'i miei sospiri / che nascon della mente ov'\u00E8 Amore / e vanno sol ragionando dolore ... / giriano agli occhi con tanta vertute - versi 5-9" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/23/paragrafo/17/exprFrag1/698>	ns3:efChars	"n lei \u00E8no adornezze, / gentilezze, savere e bel parlare - versi 25-6" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/39/paragrafo/8/exprFrag1/993>	ns3:efChars	"piange ne li sospir' che nel cor trova - verso 10" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/13/exprFrag/303>	ns3:efChars	"figliuola d'Amor" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/13/exprFrag/302>	ns3:efChars	"vv. 57 Canzone" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/35/paragrafo/4/exprFrag/551>	ns3:efChars	"ragione" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/13/exprFrag/305>	ns3:efChars	"v. 62. Insegnatemi gir" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/7/exprFrag1/488>	ns3:efChars	"che non have altro difetto / che d'aver lei - versi 19-20" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/13/exprFrag/304>	ns3:efChars	"giovane e piana" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/23/paragrafo/8/exprFrag1/692>	ns3:efChars	"i miei sospiri, / che nascon della mente ov'\u00E8 Amore - versi 5-6" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/12/paragrafo/13/exprFrag/153>	ns3:efChars	"v. 26. fermata" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/6/paragrafo/1/exprFrag/64>	ns3:efChars	"di questa gentile donna" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/3/paragrafo/8/exprFrag/40>	ns3:efChars	"apparita" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/12/paragrafo/13/exprFrag/156>	ns3:efChars	"non s'\u00E8 smagato" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/12/paragrafo/13/exprFrag/155>	ns3:efChars	"quanto alla forma, si tratta di participio forte" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/9/paragrafo/1/exprFrag/109>	ns3:efChars	"avvenne cosa" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/12/paragrafo/13/exprFrag/154>	ns3:efChars	"mpronto" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/23/paragrafo/5/exprFrag1/668>	ns3:efChars	"sol obscurabitur, et luna non dabit lumen suum - Mt, XXIV, 29" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/31/paragrafo/9/exprFrag1/906>	ns3:efChars	"versi 8-9" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/7/paragrafo/3/exprFrag1/121>	ns3:efChars	"Voi che per li occhi mi passaste il core . . . / guardate a l'angosciosa vita mia - versi 1 e 3" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/15/paragrafo/5/exprFrag/223>	ns3:efChars	"v. 5. Lo viso" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/12/paragrafo/13/exprFrag/158>	ns3:efChars	"ben servidore" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/11/exprFrag1/532>	ns3:efChars	"Ch\u00E9 ci\u00F2 che l'om de voi conosce e vede, / semiglia, per mia fede, / mirabel cosa a bon conoscidore - versi 19-21" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/7/paragrafo/3/exprFrag1/120>	ns3:efChars	"I' prego voi che di dolor parlate / che, per vertute di nova pietate, / non disdegniate la mia pena udire - versi 1-3" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/12/paragrafo/13/exprFrag1/253>	ns3:efChars	"non si debbia smagare neiente . . . / ma stea co meco il suo core a bandono - versi 10-2" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/23/paragrafo/5/exprFrag1/669>	ns3:efChars	"obtenebratus est sol - Is. XIII, 10" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/15/paragrafo/5/exprFrag/224>	ns3:efChars	"s'appoia" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/4/paragrafo/1/exprFrag/55>	ns3:efChars	"de la mia vista" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/12/paragrafo/13/exprFrag/157>	ns3:efChars	"v. 21. falle umil pregher\u00F2" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/26/paragrafo/10/exprFrag/473>	ns3:efChars	"v. i. Vede" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/11/exprFrag1/533>	ns3:efChars	"Ben credo Dio volesse, / quando la fe' primero, / che 'l suo visaggio altero / sovr'ogne altro paresse - versi 49-52" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/31/paragrafo/9/exprFrag1/904>	ns3:efChars	"E' mi ricorda che 'n Tolosa - verso 31" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/7/paragrafo/1/exprFrag1/111>	ns3:efChars	"Troppo son dimorato / in lontano paese - versi 1-2" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/4/paragrafo/1/exprFrag/56>	ns3:efChars	"pieni d'invidia" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/11/exprFrag1/534>	ns3:efChars	"Per maraviglia fue in terra formata . . ., / e sol la fece Dio per dimostranza / perch\u00E9 da' boni fossene adorata - versi 17-20" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/11/exprFrag1/535>	ns3:efChars	"o che Dio volle mostrar sua possanza / de le bellezze in vostra figura - versi 12-3" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/12/paragrafo/13/exprFrag1/251>	ns3:efChars	"dimostro - verso 22" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/23/paragrafo/5/exprFrag1/667>	ns3:efChars	"in guisa ch'i' non so l\u00E0 'v'i' mi sia - verso 16" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/4/paragrafo/1/exprFrag/57>	ns3:efChars	"si procacciavano" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/10/paragrafo/2/exprFrag1/189>	ns3:efChars	"a le' s'inchin' ogni gentil vertute, / e la beltate per sua dea la mostra - versi 10-1" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/15/paragrafo/5/exprFrag/227>	ns3:efChars	"Moia, moia" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/31/paragrafo/10/exprFrag/510>	ns3:efChars	"in l'alto cielo" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/22/exprFrag/312>	ns3:efChars	"a troppi" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/39/paragrafo/3/exprFrag/566>	ns3:efChars	"l\u00E0" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/33/paragrafo/8/exprFrag/539>	ns3:efChars	"s\u00EC v'\u00E8 gentile" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/7/exprFrag1/486>	ns3:efChars	"clamavi ad te, Domine" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/31/paragrafo/10/exprFrag/511>	ns3:efChars	"reame" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/26/paragrafo/7/exprFrag1/839>	ns3:efChars	"vide uscire / degli occhi vostri un lume di merzede / che porse dentr'al cor nova dolcezza - versi 9-11" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/11/paragrafo/3/exprFrag1/203>	ns3:efChars	"I' vo come colui ch'\u00E8 fuor di vita, / che pare, a chi lo sguarda, ch'omo sia / fatto di rame o di pietra o di legno, / che si conduca sol per maestria - versi 9-12" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/32/paragrafo/5/exprFrag/530>	ns3:efChars	"vanno via" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/22/paragrafo/6/exprFrag1/644>	ns3:efChars	"e vidi il servitore / di monna Lagia che venia dicendo - versi 5-6" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/33/paragrafo/8/exprFrag/538>	ns3:efChars	"saluta" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/31/paragrafo/10/exprFrag/512>	ns3:efChars	"voi, donne, ha lassate" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/12/paragrafo/13/exprFrag1/256>	ns3:efChars	"me' conoscidore - verso 24" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/15/paragrafo/5/exprFrag/225>	ns3:efChars	"ebriet\u00E0" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/26/paragrafo/10/exprFrag/474>	ns3:efChars	"salute" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/11/paragrafo/3/exprFrag1/202>	ns3:efChars	"remagno como stat\u00FCa d'ottono / ove vita n\u00E9 spirto non ricorre / se non che la figura d'omo rende. - versi 12-4" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/26/paragrafo/7/exprFrag1/838>	ns3:efChars	"sento che s\u00EC dolce sguardo / dentro degli occhi mi pass\u00F2 al core / e posevi uno spirito di gioia - versi 9-11" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/11/exprFrag1/530>	ns3:efChars	"adorna e si gentile - 9" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/31/paragrafo/10/exprFrag/513>	ns3:efChars	"v. 20. fue" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/31/paragrafo/9/exprFrag1/907>	ns3:efChars	"s'\u00E8 fuggita e partita da loro, e halli lasciati molto dolenti - 10.10" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/15/paragrafo/5/exprFrag/226>	ns3:efChars	"le pietre" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/11/exprFrag1/531>	ns3:efChars	"Ch\u00E9 la natura entesa / fo di formare voi, co 'l bon pintore / Policreto fo de la sua pentura - versi 10-2" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/26/paragrafo/7/exprFrag1/837>	ns3:efChars	"dentro da lo cor mi pass'amanza - verso 14" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/11/paragrafo/3/exprFrag1/201>	ns3:efChars	"per soverchio de lo su' valore - verso 49" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/13/paragrafo/9/exprFrag1/316>	ns3:efChars	"e dice fierezza perci\u00F2 che viveano come fiere; e dice crudeltade perci\u00F2 che 'l padre e 'l figliuolo non si conosceano - Rett. 5.4" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/36/paragrafo/4/exprFrag/557>	ns3:efChars	"v. 2. preser" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/21/paragrafo/2/exprFrag1/631>	ns3:efChars	"O Deo, che sembra quando li occhi gira, / dical' Amor, ch'i' noi savria contare - versi 5-6" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/32/paragrafo/5/exprFrag/529>	ns3:efChars	"5. vv 1-2" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/38/paragrafo/8/exprFrag/564>	ns3:efChars	"v.3" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/7/paragrafo/3/exprFrag1/125>	ns3:efChars	"eo, lasso, ostal d'ogne tormento - verso 31" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/11/paragrafo/2/exprFrag/121>	ns3:efChars	"lo tremare" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/13/paragrafo/9/exprFrag1/312>	ns3:efChars	"S'io prego questa donna che Pietate / non sia nemica del su' cor gentile - versi 1-2" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/8/paragrafo/5/exprFrag/95>	ns3:efChars	"ci\u00F2 che\u2026 \u00E8 da laudare" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/34/paragrafo/9/exprFrag/541>	ns3:efChars	"v. 5. ne la mente" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/8/paragrafo/3/exprFrag/91>	ns3:efChars	"lo primo" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/7/paragrafo/3/exprFrag1/126>	ns3:efChars	"Vo' portate la chiave / di ciascuna vert\u00F9 alta e gentile - versi 7-8" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/7/exprFrag1/490>	ns3:efChars	"versi 5-8" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/13/paragrafo/9/exprFrag1/311>	ns3:efChars	"Se Merc\u00E9 fosse amica a' miei disir\u00EC - verso 1" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/11/paragrafo/2/exprFrag/120>	ns3:efChars	"uno spirito d'amore" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/24/paragrafo/6/exprFrag/411>	ns3:efChars	"questo sonetto" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/7/exprFrag1/491>	ns3:efChars	"Pro hac orabit ad te omnis sanctus - Ps XXXI, 6" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/8/paragrafo/5/exprFrag/94>	ns3:efChars	"v. 6. miso" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/11/exprFrag1/536>	ns3:efChars	"mirabel cosa - verso 21" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/14/paragrafo/6/exprFrag/198>	ns3:efChars	"infolgorasse" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/12/paragrafo/12/exprFrag1/247>	ns3:efChars	"quel di ch'Amor consente / ch'i' cangi core, volere o maniera, / o ch'altra donna mi sia pi\u00F9 piacente - versi 1-3" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/34/paragrafo/9/exprFrag/542>	ns3:efChars	"destrutto" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/13/paragrafo/9/exprFrag1/314>	ns3:efChars	"I, 8" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/7/paragrafo/3/exprFrag1/122>	ns3:efChars	"chi gran pena sente, / guardi costui, e veder\u00E0 '1 su' core 12-3" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/21/paragrafo/2/exprFrag1/632>	ns3:efChars	"XI, 26; XVIII, 13 e LIII,3" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/11/exprFrag1/539>	ns3:efChars	"quanto bene om sente - verso 2" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/12/paragrafo/12/exprFrag1/246>	ns3:efChars	"non si muta da voi la mia vita - verso 10" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/7/paragrafo/3/exprFrag1/124>	ns3:efChars	"Audite, obsecro, universi populi, et videte dolorem meum - Lam I 18" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/36/paragrafo/4/exprFrag/558>	ns3:efChars	"si schianti" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/9/exprFrag1/510>	ns3:efChars	"Ella si vede / tanto gentil che non p\u00F2 'maginare / ch'om d'esto mondo l'ardisca mirare / che non convegna lui tremare in pria; / ed i', s'i' la sguardasse, ne morria - versi 20-5" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/8/paragrafo/5/exprFrag/96>	ns3:efChars	"v. 8. sovra de l'onore" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/2/paragrafo/7/exprFrag/16>	ns3:efChars	"la mia imaginazione" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/3/paragrafo/1/exprFrag/22>	ns3:efChars	"questa gentilissima" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/12/paragrafo/12/exprFrag1/245>	ns3:efChars	"non cangio il cor da vostra fedaltate - verso 3" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/40/paragrafo/4/exprFrag1/1003>	ns3:efChars	"fare'ne di piet\u00E0 piangere Amore - Verso 8" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/13/paragrafo/8/exprFrag1/303>	ns3:efChars	"i' sento nel cor un penser\u00F2 / che fa tremar la mente di paura - Versi 3-4" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/12/paragrafo/12/exprFrag1/243>	ns3:efChars	"quelli che manda la sua lettera guernisce di parole ornate e piene di sentenzia e di fermi argomenti, si come crede poter muovere l'animo di colui a non negare, e, s'elli avesse alcuna scusa, come la possa indebolire o instornare in tutto - 76-16" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/13/paragrafo/8/exprFrag1/304>	ns3:efChars	"l'anima sento per Io cor tremare - verso 20" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/2/paragrafo/7/exprFrag/15>	ns3:efChars	"di sponsata" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/3/paragrafo/3/exprFrag/29>	ns3:efChars	"Ego dominus tuus" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/12/paragrafo/12/exprFrag1/242>	ns3:efChars	"son certa non ne fai tal portamento / che 'n ci\u00F2 tu posse alcuna scusa avere - versi 9-10" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/13/paragrafo/8/exprFrag1/305>	ns3:efChars	"i' sento lo sospir tremar nel core - verso 5" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/2/paragrafo/7/exprFrag1/27>	ns3:efChars	"per cui si fe' gentil l'anima mia / poi che sposata la congiunse Amore - versi 3-4" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/3/paragrafo/3/exprFrag/28>	ns3:efChars	"una nebula" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/12/paragrafo/12/exprFrag1/240>	ns3:efChars	"Di': Quelli che mi manda a voi - verso 28" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/3/paragrafo/3/exprFrag/27>	ns3:efChars	"uno soave sonno" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/31/paragrafo/11/exprFrag1/921>	ns3:efChars	"non \u00E8 di si alta grandezza nessuno ingegno - verso 11" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/3/paragrafo/1/exprFrag/24>	ns3:efChars	"vedere tutti li termini" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/31/paragrafo/11/exprFrag1/920>	ns3:efChars	"rima guittoniana" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/3/paragrafo/1/exprFrag/23>	ns3:efChars	"di colore bianchissimo" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/16/paragrafo/5/exprFrag/235>	ns3:efChars	"la mia poca vita" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/24/paragrafo/1/exprFrag1/725>	ns3:efChars	"verso 54" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/11/exprFrag1/543>	ns3:efChars	"de la sua persona medesima ne diede esemplo - vii, 3" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/23/paragrafo/5/exprFrag1/674>	ns3:efChars	"Lugebit terra, et maerebunt caeli desuper - Ier IV 28" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/3/paragrafo/1/exprFrag1/42>	ns3:efChars	"Et post dies sex . . . Mt incipit" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/23/paragrafo/8/exprFrag/375>	ns3:efChars	"lo cuore, ove era tanto amore, mi dicesse" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/11/exprFrag1/542>	ns3:efChars	"secondo che vedi per esemplo di due che perfetta mente s'amano insieme - XIX, 8" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/23/paragrafo/5/exprFrag1/673>	ns3:efChars	"et nigrescere faciam stellas . . solem nube tegam . . . Omnia luminaria caeli maerere faciam super te - Ez XXXII 32, 7-8" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/3/paragrafo/1/exprFrag1/41>	ns3:efChars	"Et post dies sex . . . Mc incipit" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/11/exprFrag1/541>	ns3:efChars	"Nihil addere noverat ultra, / ipse fuit quicquid potuit Natura - versi 393-4" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/23/paragrafo/5/exprFrag1/677>	ns3:efChars	"stellae cadent de caelo - Mt XXIV,29" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/26/paragrafo/13/exprFrag1/863>	ns3:efChars	"che di dolcezza ne sospir'Amore - verso 3" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/3/paragrafo/1/exprFrag1/40>	ns3:efChars	"nubes lucida ... obumbravit eos Mt xvii,5" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/23/paragrafo/25/exprFrag1/718>	ns3:efChars	"Levavi oculos meos in montes - Ps CXX" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/11/exprFrag1/540>	ns3:efChars	"natura ha 'n lei miso / quanto pi\u00F9 p\u00F2 di bene - versi 49-50" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/13/paragrafo/9/exprFrag1/307>	ns3:efChars	"io non soch'io mi faccia - verso 14" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/23/paragrafo/5/exprFrag1/675>	ns3:efChars	"Ioel II, 10" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/23/paragrafo/5/exprFrag1/676>	ns3:efChars	"Ioel III, 15" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/26/paragrafo/13/exprFrag1/862>	ns3:efChars	"parlare / null'omo pote, ma ciascun sospira - versi 3-4" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/23/paragrafo/25/exprFrag1/719>	ns3:efChars	"Ad te levavi oculos meos, qui habitas in caelis - Ps CXXII" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/15/paragrafo/4/exprFrag/218>	ns3:efChars	"v. 1. Ci\u00F2 che m'incontra" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/13/paragrafo/9/exprFrag/183>	ns3:efChars	"v. 11. cosi" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/23/paragrafo/5/exprFrag1/679>	ns3:efChars	"omne volatile caeli recessit - Ier IV, 25" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/13/paragrafo/9/exprFrag/182>	ns3:efChars	"v. 10. ch'io mi dica" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/12/exprFrag/297>	ns3:efChars	"v. 52. spirti" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/23/paragrafo/5/exprFrag1/678>	ns3:efChars	"cum ceciderint vulnerati tui in medio terrae - Ez XXXII, 8" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/13/paragrafo/9/exprFrag/181>	ns3:efChars	"da guai matera prenda" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/12/paragrafo/14/exprFrag1/260>	ns3:efChars	"e s'ella questa grazia ti concede, / mandi [2\u00B0 persona] una voce d'allegrezza f\u00F2re, / che mostri quella che t'ha fatto onore versi 22-4" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/26/paragrafo/10/exprFrag1/859>	ns3:efChars	"Vedeste, al mio parere, onne valore / e tutto gioco e quanto bene om sente - versi 1-2" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/3/paragrafo/1/exprFrag1/43>	ns3:efChars	"Vedeste, al mio parere, onne valore / e tutto gioco e quanto bene om sente - versi 1-2" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/13/paragrafo/3/exprFrag1/284>	ns3:efChars	"Credo savete ben, messer Onesto, / che proceder dal fatto il nome dia - versi 1-2" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/7/paragrafo/3/exprFrag/75>	ns3:efChars	"V. 4. audir mi sofferiate" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/7/paragrafo/3/exprFrag/76>	ns3:efChars	"V. 4. audir mi sofferiate" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/25/paragrafo/1/exprFrag/417>	ns3:efChars	"dubitare" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/26/paragrafo/3/exprFrag/456>	ns3:efChars	"s\u00EC gentile e s\u00EC piena di tutti li piaceri" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/25/paragrafo/1/exprFrag1/759>	ns3:efChars	"Per se subsistens" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/25/paragrafo/1/exprFrag/418>	ns3:efChars	"una cosa per s\u00E9" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/26/paragrafo/3/exprFrag/457>	ns3:efChars	"comprendeano" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/25/paragrafo/1/exprFrag/419>	ns3:efChars	"non \u00E8 per s\u00E9 s\u00EC come sustanzia" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/7/paragrafo/3/exprFrag/74>	ns3:efChars	"O ... grave" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/7/paragrafo/3/exprFrag/73>	ns3:efChars	"O ... grave" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/24/paragrafo/6/exprFrag/410>	ns3:efChars	"credendo io" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/7/paragrafo/4/exprFrag1/127>	ns3:efChars	"Ci\u00F2 non m'ha conceduto / mio merto, ma la tua gran bonitate - versi 97-8" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/15/paragrafo/4/exprFrag/219>	ns3:efChars	"nela mente more" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/4/paragrafo/1/exprFrag1/99>	ns3:efChars	"mal parlanti" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/7/paragrafo/4/exprFrag1/129>	ns3:efChars	"e 'nvece di pensier' leggiadri e gai / ch'aver solea d'amore - versi 5-6" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/26/paragrafo/3/exprFrag/458>	ns3:efChars	"ridicere" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/16/paragrafo/3/exprFrag1/400>	ns3:efChars	"chi vedesse com'ell'\u00E8 fuggita [cio\u00E8 l'anima] / diria percerto: Questi non ha vita - versi 7-8" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/4/paragrafo/1/exprFrag1/97>	ns3:efChars	"mi saluta / tanto di presso l'angosciosa Morte, / che fa 'n quel punto le persone accorte, / che dicono infra lor: Quest'ha dolore, / e gi\u00E0, secondo che ne par de f\u00F2re, / dovrebbe dentro aver novi martiri - versi 7-12" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/26/paragrafo/3/exprFrag/459>	ns3:efChars	"n\u00E9 alcuno era ... che" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/7/paragrafo/3/exprFrag/77>	ns3:efChars	"ostale e chiave" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/1/paragrafo/1/exprFrag/1>	ns3:efChars	"Incipit vita nova" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/26/paragrafo/7/exprFrag/471>	ns3:efChars	"v. 14. che va dicendo" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/22/paragrafo/14/exprFrag/357>	ns3:efChars	"coralmente" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/22/paragrafo/14/exprFrag/358>	ns3:efChars	"coralmente" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/11/paragrafo/2/exprFrag1/198>	ns3:efChars	"verso 7" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/23/paragrafo/20/exprFrag1/700>	ns3:efChars	"verso 7" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/22/paragrafo/14/exprFrag1/657>	ns3:efChars	"verso 7" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/1/paragrafo/1/exprFrag/0>	ns3:efChars	"rubrica" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/26/paragrafo/7/exprFrag/470>	ns3:efChars	"si mova / un spirto soave" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/27/paragrafo/4/exprFrag/482>	ns3:efChars	"frale" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/41/paragrafo/6/exprFrag1/1011>	ns3:efChars	"III, 45" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/11/paragrafo/2/exprFrag1/197>	ns3:efChars	"Lo vostro bel saluto e '1 gentil sguardo / che fate quando v'encontro, m'ancide. / Amor m'assale - versi 1-3" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/11/paragrafo/2/exprFrag1/196>	ns3:efChars	"riman figura sol en segnoria / e voce alquanta che parla dolore - Versi 7-8" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/15/paragrafo/6/exprFrag/231>	ns3:efChars	"vista morta" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/18/paragrafo/3/exprFrag/249>	ns3:efChars	"volgendo li suoi occhi verso me" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/37/paragrafo/8/exprFrag/560>	ns3:efChars	"e poi sospira" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/18/paragrafo/3/exprFrag/248>	ns3:efChars	"tra le quali n'avea certe \u2026 altre v'erano \u2026 altre v'erano" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/11/paragrafo/2/exprFrag1/199>	ns3:efChars	"quest'\u00E8 lo spiritel che fa tremare - verso 7" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/15/paragrafo/4/exprFrag/220>	ns3:efChars	"gioia" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/21/paragrafo/2/exprFrag/338>	ns3:efChars	"superbia ed ira" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/12/paragrafo/11/exprFrag/145>	ns3:efChars	"gire" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/23/paragrafo/5/exprFrag/366>	ns3:efChars	"oscurare" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/10/exprFrag1/512>	ns3:efChars	"ca tutto ci\u00F2 ch'io dico m'\u00E8 arivato / in bono usato - versi 38-9" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/2/paragrafo/5/exprFrag1/22>	ns3:efChars	"Animaiis spiritus... Licet exeat a corde, evolat in vacuitatem cellularum cerebri, et ex illis dirigitur in nervos concavos qui a sensus communis organo ad sensus proprios diriguntur; quorum tamen nervi illi qui optici sive visivi dicuntur, et maiores et magis sunt concavi et plus capiunt de spir\u00ECtu, et puriorem et lucidiorem, qui solus elevatur, colligunt -  i, ii, 4" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/21/paragrafo/2/exprFrag/339>	ns3:efChars	"v. 8. Aiutatemi ecc" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/36/paragrafo/4/exprFrag1/978>	ns3:efChars	"far a me cosa che mi scoppi 'l cuore - verso 10" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/23/paragrafo/5/exprFrag/365>	ns3:efChars	"ch'io non sapea ove io mi fosse" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/2/paragrafo/5/exprFrag1/23>	ns3:efChars	"L\u00E0 dove questa bella donna appare / s'ode una voce che le v\u00E8n davanti / e par che d'umilt\u00E0 il su' nome canti / s\u00EC dolcemente, che, s'i' 'l vo' contare, / sento che 'l su' valor mi fa tremare; / e movonsi nell'anima sospiri / che dicon: \"Guarda, se tu coste' miri, / vedra' la sua vert\u00F9 nel del salita - seconda strofa" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/10/exprFrag1/514>	ns3:efChars	"ed ancor pi\u00F9, che quando omo la vede / gi\u00E0 mai non p\u00F2 pensar di cosa ria - versi 25-6" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/15/paragrafo/4/exprFrag/222>	ns3:efChars	"v. 4. Fuggi" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/36/paragrafo/4/exprFrag1/975>	ns3:efChars	"sospiri e dolor mi pigliaro - verso 7" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/35/paragrafo/5/exprFrag1/967>	ns3:efChars	"Io vidi li occhi dove Amor si mise - Verso 1" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/31/paragrafo/11/exprFrag/520>	ns3:efChars	"spirito benegno" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/2/paragrafo/5/exprFrag1/24>	ns3:efChars	"Apparuit enim gratia Dei salvatoris nostri - Tit., Il, 11" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/15/paragrafo/4/exprFrag/221>	ns3:efChars	"quand'io vi son presso" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/36/paragrafo/4/exprFrag1/976>	ns3:efChars	"verso 11" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/35/paragrafo/5/exprFrag1/968>	ns3:efChars	"Veggio negli occhi de la donna mia - verso 1" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/31/paragrafo/11/exprFrag/521>	ns3:efChars	"v. 35. Non \u00E8 di" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/10/exprFrag1/513>	ns3:efChars	"ancor ve dir\u00F2 c'ha maggior vertute: / null'om p\u00F2 mal pensar fin che la vede" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/27/paragrafo/5/exprFrag1/873>	ns3:efChars	"versi 13 e 19" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/32/paragrafo/6/exprFrag/531>	ns3:efChars	"l'anima dolente" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/2/paragrafo/5/exprFrag1/25>	ns3:efChars	"Tit iii, 4" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/21/paragrafo/2/exprFrag/333>	ns3:efChars	"v. 1. Ne li occhi porta" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/21/paragrafo/4/exprFrag/341>	ns3:efChars	"n\u00E9 tenere a mente" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/21/paragrafo/2/exprFrag/335>	ns3:efChars	"v. 3. ogn'om ver lei si gira" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/16/paragrafo/8/exprFrag/243>	ns3:efChars	"v. 8. e que'" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/23/paragrafo/5/exprFrag1/670>	ns3:efChars	"Ez., XXXII, 7" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/13/paragrafo/9/exprFrag1/306>	ns3:efChars	"Ad Hererm., iv, 37" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/21/paragrafo/2/exprFrag/334>	ns3:efChars	"ch'ella mira" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/1/paragrafo/1/exprFrag/3>	ns3:efChars	"libello" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/1/paragrafo/1/exprFrag/4>	ns3:efChars	"libello" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/21/paragrafo/2/exprFrag/336>	ns3:efChars	"fa tremar lo core" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/16/paragrafo/8/exprFrag/242>	ns3:efChars	"m'abbandona" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/23/paragrafo/5/exprFrag1/671>	ns3:efChars	"loel, II, 10,31 e III, 15" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/2/paragrafo/1/exprFrag1/9>	ns3:efChars	"lamque rubescebat stellis Aurora fugatis / cum procul obscuros Collis hvimilemque videmus / Italiam - Aen. III 521-3" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/27/paragrafo/5/exprFrag1/874>	ns3:efChars	"piacer novo - verso 3" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/31/paragrafo/8/exprFrag1/903>	ns3:efChars	"avesse di sospir tormento tanto - verso 2" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/12/paragrafo/11/exprFrag/144>	ns3:efChars	"sicuramente" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/21/paragrafo/2/exprFrag/337>	ns3:efChars	"v. 6. sospira" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/23/paragrafo/5/exprFrag1/672>	ns3:efChars	"disperazione delle filiae Sion" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/35/paragrafo/4/exprFrag1/966>	ns3:efChars	"Verso 73" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/16/paragrafo/8/exprFrag/241>	ns3:efChars	"subitanamente" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/2/paragrafo/1/exprFrag1/8>	ns3:efChars	"Cum inversum" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/1/paragrafo/1/exprFrag/2>	ns3:efChars	"assemplare" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/21/paragrafo/4/exprFrag/340>	ns3:efChars	"non si pu\u00F2 dicer" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/23/paragrafo/25/exprFrag/394>	ns3:efChars	"v. 57. Levava li occhi miei" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/15/paragrafo/5/exprFrag1/380>	ns3:efChars	"qual mira de f\u00F2re, / vede la Morte sotto al meo colore - versi 31-1" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/31/paragrafo/17/exprFrag/527>	ns3:efChars	"elle" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/32/paragrafo/5/exprFrag1/938>	ns3:efChars	"escon f\u00F2re - verso 11" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/12/exprFrag1/548>	ns3:efChars	"verso 13" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/26/paragrafo/3/exprFrag1/820>	ns3:efChars	"verso 13" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/23/paragrafo/25/exprFrag/395>	ns3:efChars	"in pianti" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/31/paragrafo/17/exprFrag/526>	ns3:efChars	"figliuola di tristizia" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/41/paragrafo/6/exprFrag/585>	ns3:efChars	"nel secondo de la Metafisica" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/31/paragrafo/11/exprFrag/519>	ns3:efChars	"v. 33. core ha" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/31/paragrafo/17/exprFrag/525>	ns3:efChars	"v. 72. ritruova" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/20/paragrafo/3/exprFrag/316>	ns3:efChars	"v. 1. una cosa" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/23/paragrafo/5/exprFrag1/685>	ns3:efChars	"A facie eius contremuit terra - Ioel 2,10" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/31/paragrafo/11/exprFrag/518>	ns3:efChars	"piena di grazia" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/32/paragrafo/5/exprFrag1/937>	ns3:efChars	"che, per vertute di nova pietate, / non disdegn[i]ate \u2013 la mia pena udire" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/15/paragrafo/5/exprFrag1/383>	ns3:efChars	"Ebrietate et dolore repleberis, calice moeroris et tristitiae - Ez XXIII, 33" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/20/paragrafo/3/exprFrag/317>	ns3:efChars	"v. 2. il saggio" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/31/paragrafo/9/exprFrag/506>	ns3:efChars	"me ricorda" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/41/paragrafo/6/exprFrag/583>	ns3:efChars	"s'abbia a" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/20/paragrafo/3/exprFrag/318>	ns3:efChars	"dittare" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/12/paragrafo/12/exprFrag/152>	ns3:efChars	"non mut\u00F2 \u2018l core" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/33/paragrafo/1/exprFrag/532>	ns3:efChars	"lo servigio" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/14/paragrafo/5/exprFrag/195>	ns3:efChars	"li spiriti del viso" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/12/paragrafo/6/exprFrag/139>	ns3:efChars	"non fosse noiosa" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/20/paragrafo/3/exprFrag/319>	ns3:efChars	"pone" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/14/paragrafo/5/exprFrag/194>	ns3:efChars	"Allora fuoro si distrutti" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/35/paragrafo/1/exprFrag1/960>	ns3:efChars	"secondo che ne par de f\u00F2re - verso 11" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/41/paragrafo/10/exprFrag/587>	ns3:efChars	"passa" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/36/paragrafo/4/exprFrag1/974>	ns3:efChars	"Piet\u00E0 di me, per Dio, vi prenda, Amore - verso 1" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/14/paragrafo/5/exprFrag/197>	ns3:efChars	"nel loro nobilissimo luogo" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/12/paragrafo/12/exprFrag/150>	ns3:efChars	"v. 20. sed elli ha scusa" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/14/paragrafo/5/exprFrag/196>	ns3:efChars	"li loro strumenti" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/12/paragrafo/12/exprFrag/151>	ns3:efChars	"v. 22. face" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/10/paragrafo/2/exprFrag/117>	ns3:efChars	"regina de le virtudi" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/14/paragrafo/10/exprFrag/206>	ns3:efChars	"desiderando" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/31/paragrafo/9/exprFrag/509>	ns3:efChars	"meco dolente" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/22/paragrafo/16/exprFrag/360>	ns3:efChars	"piangendo" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/12/exprFrag/300>	ns3:efChars	"pinto" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/31/paragrafo/9/exprFrag/508>	ns3:efChars	"v. 10. voi" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/12/exprFrag/301>	ns3:efChars	"v. 56. l\u00E0 've" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/31/paragrafo/9/exprFrag/507>	ns3:efChars	"v. 8. vivia" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/13/paragrafo/3/exprFrag1/278>	ns3:efChars	"una diceria nella quale \u00E0e molte parole s\u00ECe impigliate che ssine puote sostenere l'una parte e l'altra, cio\u00E8 provare si e no per atrebuti, cio\u00E8 per propietadi del fatto o della persona\u00BB: come sarebbe, ad una proposta come \u00AB\u00E8 da sbandire in exilio Marco Tulio Cicero o no ...?\u00BB, rispondere, secondo la parte del s\u00EC \u00ABCicero \u00E8 da sbandire, perci\u00F2 che \u00E0 fatta la cotale cosa\u00BB, e secondo quella del no \u00ABNon \u00E8 da sbandire, ch\u00E9 ricordando pure lo nome signiffica buona cosa, et isbandire et exilio signiffica mala cosa, e non \u00E8 da credere che buono uomo faccia quello - Rett. 19,4,5" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/15/paragrafo/5/exprFrag1/384>	ns3:efChars	"Agitatione agitabitur terra sicut ebrius - Is XXIV, 20" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/8/exprFrag1/495>	ns3:efChars	"quia vidi angelum Domini facie ad faciem - Gdc 6,22" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/15/paragrafo/5/exprFrag1/385>	ns3:efChars	"quia si hi tacuerint, lapides clamabunt - Lc XIX 40" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/27/paragrafo/4/exprFrag/481>	ns3:efChars	"v. 6. che li spiriti" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/23/paragrafo/25/exprFrag/396>	ns3:efChars	"v. 58. che parean" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/8/exprFrag1/493>	ns3:efChars	"le dette pene . . . in pace sofferse - VII,3" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/5/paragrafo/2/exprFrag1/104>	ns3:efChars	"Guarda come conquise / forza d'amor costui! - versi 19-20" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/22/exprFrag1/571>	ns3:efChars	"assai laudata sar\u00E0 tua ragione / da le persone c'hanno intendimento: / di star con l'altre tu non hai talento - versi 73-5" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/38/paragrafo/5/exprFrag/563>	ns3:efChars	"l'appetito \u2026 la ragione" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/23/paragrafo/25/exprFrag/397>	ns3:efChars	"v. 62 dire'lo" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/14/paragrafo/10/exprFrag/205>	ns3:efChars	"altrui" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/15/paragrafo/6/exprFrag/230>	ns3:efChars	"v. 10. l'alma sbigottita" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/5/paragrafo/2/exprFrag1/103>	ns3:efChars	"p. LXXI" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/8/exprFrag1/494>	ns3:efChars	"Vidi Deum facie ad faciem - Gen., xxxii, 30" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/24/paragrafo/1/exprFrag/400>	ns3:efChars	"presente a" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/3/paragrafo/7/exprFrag1/65>	ns3:efChars	"risus vester in luctum convertatur, et gaudium in maerorem - Iac IV 9" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/3/paragrafo/7/exprFrag1/66>	ns3:efChars	"Defecit gaudium cordis nostri; versus est in luctum chorus noster - Lam V 15" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/12/exprFrag1/545>	ns3:efChars	"esce degli occhi suoi, che me [. ..] ardo / un gentiletto spirito d'amore - versi 6-7" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/25/paragrafo/1/exprFrag/420>	ns3:efChars	"uno accidente in sustanzia" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/24/paragrafo/8/exprFrag1/754>	ns3:efChars	"Po' mi girai, e vidi 'l servitore - verso 5" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/8/paragrafo/1/exprFrag1/141>	ns3:efChars	"verso 10" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/12/exprFrag1/547>	ns3:efChars	"verso 10" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/2/paragrafo/1/exprFrag/6>	ns3:efChars	"li quali non sapeano che si chiamare" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/13/paragrafo/3/exprFrag1/281>	ns3:efChars	"chi pi\u00F9 lo serve, pi\u00F9 lo fa penare" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/2/paragrafo/1/exprFrag/5>	ns3:efChars	"quando" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/5/exprFrag/266>	ns3:efChars	"v. 5. Io dico che" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/13/paragrafo/3/exprFrag1/282>	ns3:efChars	"Scriptum est - Mt IV 4,7,10" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/5/exprFrag/267>	ns3:efChars	"il suo valore" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/12/exprFrag1/544>	ns3:efChars	"Veggio negli occhi de la donna mia / un lume pien di spiriti d'amore - versi 1-2" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/35/paragrafo/5/exprFrag/553>	ns3:efChars	"la statura" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/41/paragrafo/12/exprFrag1/1016>	ns3:efChars	"li sospir' che manda 'l cor dolente - verso 3" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/5/exprFrag/268>	ns3:efChars	"innamorar la gente" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/13/paragrafo/3/exprFrag1/280>	ns3:efChars	"per quella f\u00E9 che lo mio cor ti porta - verso 7" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/35/paragrafo/5/exprFrag/552>	ns3:efChars	"v. 1. Videro li occhimiei" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/14/paragrafo/5/exprFrag1/325>	ns3:efChars	"li spiriti fuggiti del mio core, / che per soverchio de lo su' valore/ eran distrutti, se non fosser v\u00F2lti - versi 48-50" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/26/paragrafo/7/exprFrag/469>	ns3:efChars	"ntender no la pu\u00F2" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/26/paragrafo/2/exprFrag1/808>	ns3:efChars	"Questa non \u00E8 terrena creatura: / Dio la mand\u00F2 da ciel, tant'\u00E8 novella - versi 13-4" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/24/paragrafo/7/exprFrag1/751>	ns3:efChars	"Dante, un sospiro messagger del core / subitamente m'assal\u00EC dormendo, / ed io mi disvegliai allor, temendo / ched e' non fosse in compagnia d'Amore.  - versi 1-4" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/14/paragrafo/10/exprFrag1/340>	ns3:efChars	"altrui despiaceria forse non poco - verso 14" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/15/paragrafo/6/exprFrag/228>	ns3:efChars	"v. 9. Peccato face" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/23/paragrafo/23/exprFrag1/715>	ns3:efChars	"crinem.. . Solutae - Aen. XI,35" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/26/paragrafo/7/exprFrag/468>	ns3:efChars	"v. 10. d\u00E0" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/26/paragrafo/2/exprFrag1/809>	ns3:efChars	"e dicon: Quest'\u00E8 dismisura / di bellezze - versi 4-5" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/24/paragrafo/7/exprFrag1/750>	ns3:efChars	"e destaste la mente che dormia - verso 2" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/14/paragrafo/8/exprFrag/200>	ns3:efChars	"li morti spiriti miei" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/23/paragrafo/5/exprFrag1/680>	ns3:efChars	"tanquam avis quae transvolat in aere - Sap. V, II" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/14/paragrafo/8/exprFrag1/334>	ns3:efChars	"[e] miei spiriti son morti - verso 5" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/14/paragrafo/5/exprFrag1/327>	ns3:efChars	"e quel sottile spirito che vede / soccorse gli altri che credean morire - Versi 12-3" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/41/paragrafo/6/exprFrag1/1008>	ns3:efChars	"Splende 'n la 'ntelligenzia del cielo / Deo criator pi\u00F9 che 'n nostr'occhi 'l sole - versi 41-2" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/13/paragrafo/3/exprFrag/172>	ns3:efChars	"li conviene" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/23/paragrafo/23/exprFrag1/717>	ns3:efChars	"verso 28" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/25/paragrafo/7/exprFrag1/783>	ns3:efChars	"verso 28" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/33/paragrafo/6/exprFrag1/945>	ns3:efChars	"Non sentio pace n\u00E9 riposo alquanto - verso 5" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/24/paragrafo/7/exprFrag1/752>	ns3:efChars	"pensa pur di trovar loc'alto o cupo - verso 14" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/13/paragrafo/3/exprFrag/173>	ns3:efChars	"li nomi seguitino le nominate cose" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/15/paragrafo/6/exprFrag/229>	ns3:efChars	"vide" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/8/paragrafo/8/exprFrag1/167>	ns3:efChars	"nova doglia ed antica fai creare,/ pianto e dolor tutto fai generare; - versi 72-3" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/14/paragrafo/5/exprFrag1/329>	ns3:efChars	"Allor si parte ogni vert\u00F9 da' miei [occhi] - verso 12" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/3/paragrafo/7/exprFrag1/69>	ns3:efChars	"fu '1 dolce sonno ch'allor si compiea, / ch\u00E9 '1 su' contraro lo venia vincendo - Versi 13-4" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/33/paragrafo/6/exprFrag1/947>	ns3:efChars	"verso 58" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/13/paragrafo/3/exprFrag/170>	ns3:efChars	"non buona" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/23/paragrafo/5/exprFrag1/683>	ns3:efChars	"Vidi montes, et ecce movebantur, et omnes colles conturbati sunt - Ier 4,24" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/8/paragrafo/8/exprFrag1/168>	ns3:efChars	"madre di vanitate - verso 54" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/14/paragrafo/5/exprFrag1/328>	ns3:efChars	"I, 1" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/22/paragrafo/6/exprFrag/350>	ns3:efChars	"che veniano dicendo" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/33/paragrafo/6/exprFrag1/946>	ns3:efChars	"tes. 610" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/13/paragrafo/3/exprFrag/171>	ns3:efChars	"fede li porta" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/23/paragrafo/5/exprFrag1/684>	ns3:efChars	"omnes colles conturbati sunt - Apc 6,14" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/8/paragrafo/8/exprFrag1/165>	ns3:efChars	"Rett. 23.6" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/14/paragrafo/8/exprFrag1/335>	ns3:efChars	"sed revocare gradum superasque evadere ad auras, / hoc opus, hic labor est - Aen. VI 128-9" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/23/paragrafo/23/exprFrag1/713>	ns3:efChars	"sente / cose dubbiose nel core apparite - versi 7-8" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/3/paragrafo/7/exprFrag1/67>	ns3:efChars	"vedr\u00E0' la sua vert\u00F9 nel ciel salita - verso 20" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/26/paragrafo/3/exprFrag1/822>	ns3:efChars	"Ella si vede / tanto gentil, che non p\u00F2 'maginare / ch'om d'esto mondo l'ardisca mirare / che non convegna lui tremare in pria - versi 20-3" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/14/paragrafo/8/exprFrag/201>	ns3:efChars	"in quella parte de la vita" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/23/paragrafo/5/exprFrag1/681>	ns3:efChars	"Et ecce terraemotus factus est magnus - Mt 28,2" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/20/paragrafo/4/exprFrag1/588>	ns3:efChars	"Al cor gentil rempaira sempre amore - verso 1" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/26/paragrafo/2/exprFrag1/807>	ns3:efChars	"voi corona e manto / portate di franchezza - versi 34-5" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/8/paragrafo/8/exprFrag1/166>	ns3:efChars	"O morte della vita privatrice, / o di ben guastatrice - versi 1-2" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/14/paragrafo/8/exprFrag1/336>	ns3:efChars	"ciascuna vert\u00F9 m'abandona, / in guisa ch'i' non so l\u00E0 'v'i' mi sia: / sol par che Morte m'aggia 'n sua bal\u00ECa - versi 15-7" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/26/paragrafo/3/exprFrag1/821>	ns3:efChars	"e non si p\u00F2 di lei giudicar f\u00F2re / altro che dir: Quest'\u00E8 novo splendore - versi 16-7" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/12/paragrafo/14/exprFrag1/258>	ns3:efChars	"m'\u00E8 rotta la chiave / del su' disdegno che nel mi' cor verso - versi 12-3" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/20/paragrafo/4/exprFrag1/589>	ns3:efChars	"prende amore in gentilezza loco - verso 8" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/23/paragrafo/5/exprFrag1/682>	ns3:efChars	"Et ecce terraemotus factus est magnus - Apc 6,12" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/23/paragrafo/20/exprFrag1/701>	ns3:efChars	"verso 31" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/13/paragrafo/8/exprFrag1/293>	ns3:efChars	"dunque \u00E8 tutto di folle adoperare - verso 14" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/39/paragrafo/4/exprFrag/567>	ns3:efChars	"lo quale suole apparire" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/8/paragrafo/8/exprFrag/104>	ns3:efChars	"la lingua" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/31/paragrafo/10/exprFrag1/909>	ns3:efChars	"VERSO 56" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/8/paragrafo/8/exprFrag/103>	ns3:efChars	"v. 6. blasmar" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/31/paragrafo/10/exprFrag1/908>	ns3:efChars	"coelo \u2026 alto - IV, 7" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/23/paragrafo/20/exprFrag1/703>	ns3:efChars	"qual mira de fore, / vede la morte sotto al meo colore - versi 30-1" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/8/paragrafo/8/exprFrag/102>	ns3:efChars	"v. 2. di dolor madre antica:" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/7/paragrafo/4/exprFrag/80>	ns3:efChars	"v. 12. leggiadro" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/21/paragrafo/4/exprFrag1/634>	ns3:efChars	"Non fu si alta gi\u00E0 la mente nostra / e non si pose 'n noi tanta salute / che propiamente n'avi\u00E0n canoscenza - versi 12-4" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/26/paragrafo/1/exprFrag1/804>	ns3:efChars	"verso 9" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/23/paragrafo/20/exprFrag1/702>	ns3:efChars	"verso 9" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/25/paragrafo/1/exprFrag1/764>	ns3:efChars	"verso 9" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/13/paragrafo/8/exprFrag1/294>	ns3:efChars	"perch\u00E9 non misur'ha ei n\u00E9 ragione - verso 27" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/8/paragrafo/8/exprFrag/101>	ns3:efChars	"Morte villana \u2026 s'affatica" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/7/paragrafo/4/exprFrag/81>	ns3:efChars	"have" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/12/paragrafo/4/exprFrag1/223>	ns3:efChars	"vos autem non sic - Lc., XXII, 26" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/22/paragrafo/14/exprFrag1/656>	ns3:efChars	"Avverbio di origine provenzale, hapax in Dante" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/21/paragrafo/4/exprFrag1/633>	ns3:efChars	"Non si poria contar la sua piagenza - verso 9" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/16/paragrafo/8/exprFrag1/412>	ns3:efChars	"Amor m'assale - verso 3" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/4/exprFrag/262>	ns3:efChars	"v. 1. ch'avete intelletto d'amore" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/26/paragrafo/7/exprFrag1/856>	ns3:efChars	"si parte da lo core uno sospiro / che va dicendo: Spiriti, fuggite - versi 10-1" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/12/paragrafo/12/exprFrag/146>	ns3:efChars	"v. 15. dolze" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/16/paragrafo/8/exprFrag1/413>	ns3:efChars	"tu m'assali. Amore, e mi combatti - verso 2" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/37/paragrafo/8/exprFrag1/980>	ns3:efChars	"verso 3" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/38/paragrafo/8/exprFrag1/988>	ns3:efChars	"verso 3" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/5/exprFrag1/477>	ns3:efChars	"verso 3" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/4/exprFrag1/467>	ns3:efChars	"Donne, ch'onore avete - verso 97" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/26/paragrafo/11/exprFrag/475>	ns3:efChars	"v. 6. nulla invidia" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/26/paragrafo/7/exprFrag1/850>	ns3:efChars	"e movonsi nell'anima sospiri / che dicon - versi 18-9" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/12/paragrafo/12/exprFrag/147>	ns3:efChars	"averai" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/12/paragrafo/6/exprFrag1/230>	ns3:efChars	"l'annoiosa gente" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/4/exprFrag1/468>	ns3:efChars	"Donna me prega, per ch'eo voglio dire - verso 1" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/35/paragrafo/3/exprFrag/548>	ns3:efChars	"di loro \u2026 altrui" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/12/paragrafo/12/exprFrag/148>	ns3:efChars	"v. 18. quelli" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/35/paragrafo/3/exprFrag/547>	ns3:efChars	"li miseri" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/35/paragrafo/3/exprFrag/549>	ns3:efChars	"temendo di non" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/18/paragrafo/3/exprFrag1/426>	ns3:efChars	"disse l'una, che rise - verso 18" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/12/paragrafo/12/exprFrag/149>	ns3:efChars	"vui" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/26/paragrafo/7/exprFrag1/852>	ns3:efChars	"E poi da questo spirito si move / un altro dolce spirito soave - versi 9-10" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/31/paragrafo/16/exprFrag1/928>	ns3:efChars	"Amor . . . / mi sbigottisce. .. / ch\u00E9 sospirando dice: Io ti dispero - verso 36 e sgg" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/4/exprFrag1/466>	ns3:efChars	"versi 41-2" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/31/paragrafo/16/exprFrag1/929>	ns3:efChars	"Quando mi vider, tutti con pietanza / dissermi: Fatto se' di tal servente, / che mai non d\u00E8i sperar altro che morte - versi 12-4" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/18/paragrafo/3/exprFrag1/425>	ns3:efChars	"Elle con gli occhi lor si volser tanto / che vider come 'l cor era ferito - versi 13-4" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/26/paragrafo/7/exprFrag1/851>	ns3:efChars	"dal qual si move spirito d'amare - verso 3" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/18/paragrafo/3/exprFrag1/428>	ns3:efChars	"L'una cantava: E' piove - verso 3" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/23/paragrafo/23/exprFrag/390>	ns3:efChars	"cose dubitose" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/4/exprFrag1/463>	ns3:efChars	"versi 15-8" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/18/paragrafo/3/exprFrag1/427>	ns3:efChars	"Molto cortesemente mi rispuose / quella che di me prima avea riso - versi 37-8" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/23/paragrafo/23/exprFrag/391>	ns3:efChars	"molte" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/4/exprFrag1/464>	ns3:efChars	"versi 5-6 e 8-9" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/26/paragrafo/1/exprFrag/450>	ns3:efChars	"le persone correano per vedere lei" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/2/paragrafo/1/exprFrag1/10>	ns3:efChars	"beata gioia, com chiamava il nome - verso 8" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/13/paragrafo/8/exprFrag1/291>	ns3:efChars	"donna ch'aggia in s\u00E9 beltate - Verso 10" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/15/paragrafo/4/exprFrag1/369>	ns3:efChars	"m'incontra ci\u00F2 che riso e gioco / vi fa menar - versi 13-4" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/18/paragrafo/3/exprFrag1/429>	ns3:efChars	"Elle con gli occhi lor si volser tanto - verso 13" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/22/paragrafo/17/exprFrag1/661>	ns3:efChars	"aggia in s\u00E9 beltate - verso 10" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/4/exprFrag1/462>	ns3:efChars	"ch'om di basso core / a tal ragione pollasse canoscenza - Versi 6-7" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/35/paragrafo/7/exprFrag1/971>	ns3:efChars	"Lagrime ascendon de la mente mia - verso 18" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/7/paragrafo/1/exprFrag/68>	ns3:efChars	"in paese \u2026 lontano" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/13/paragrafo/8/exprFrag/179>	ns3:efChars	"dolzore" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/16/exprFrag1/566>	ns3:efChars	"Donna me prega, perch'eo voglio dire - verso 1" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/13/exprFrag1/560>	ns3:efChars	"voce leve - verso 51" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/13/paragrafo/8/exprFrag/178>	ns3:efChars	"v.4. folle" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/31/paragrafo/16/exprFrag/524>	ns3:efChars	"v. 67. che ogn'om par che mi dica" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/31/paragrafo/16/exprFrag/523>	ns3:efChars	"v. 66. 'nvilita" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/13/exprFrag1/561>	ns3:efChars	"va tu, leggera e piana - verso 3" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/27/paragrafo/5/exprFrag/484>	ns3:efChars	"v. 13. ovunque ella mi vede" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/35/paragrafo/7/exprFrag1/970>	ns3:efChars	"che dell'anima mia nascesse pianto - verso 3" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/31/paragrafo/16/exprFrag1/931>	ns3:efChars	"defecit in dolore vita mea . . . Qui videbant me, foras fugerunt a me. Oblivioni datus sum, tanquam mortuus a corde. Factus sum tanquam vas perditum - Ps., xxx, 11-3" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/31/paragrafo/8/exprFrag/505>	ns3:efChars	"v. 2. lagrimar" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/25/paragrafo/7/exprFrag1/781>	ns3:efChars	"Rettorica \u00E8e scienziadi due maniere: una la quale insegna dire . . .; l'altra insegna dittare - Rett. 1,1" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/14/paragrafo/5/exprFrag1/331>	ns3:efChars	"quorum tamen nervi illi qui optici sive visivi dicuntur et maiores et magis sunt concavi, et plus capiunt de spiritu, et puriorem et lucidum, qui solus elevatur, colligunt - I 2.4" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/12/paragrafo/6/exprFrag1/229>	ns3:efChars	"che mi guardar com'io fosse noioso - verso 3" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/9/exprFrag/278>	ns3:efChars	"voi" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/26/paragrafo/3/exprFrag1/818>	ns3:efChars	"la qual \u00E8 si gentile e avenente / e tanto adorna, che 'l cor la saluta - versi 6-7" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/26/paragrafo/7/exprFrag1/847>	ns3:efChars	"da la qual par ch'una stella si mova / e dica - versi 11-2" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/31/paragrafo/16/exprFrag1/930>	ns3:efChars	"da la qual par ch'una stella si mova / e dica - versi 11-2" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/14/paragrafo/5/exprFrag1/330>	ns3:efChars	"Questi [spiritelli] lasciaro gli occhi abbandonati - verso 17" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/20/paragrafo/4/exprFrag/321>	ns3:efChars	"magione" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/13/paragrafo/8/exprFrag/177>	ns3:efChars	"v. 2. hanno in lor" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/16/paragrafo/3/exprFrag/233>	ns3:efChars	"Amore spesse volte" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/14/paragrafo/12/exprFrag1/342>	ns3:efChars	"Se voi udiste la voce dolente / de' miei sospiri, quand'escon di f\u00F2re, / non gabbereste la vista e 'l colore / ch'i' cangio allora ch'i' vi son presente - versi 1-4" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/13/exprFrag1/562>	ns3:efChars	"XI 26.27" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/9/exprFrag/279>	ns3:efChars	"v. 31. Dico" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/13/paragrafo/8/exprFrag/176>	ns3:efChars	"8. v. 1." .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/26/paragrafo/3/exprFrag1/819>	ns3:efChars	"Io veggio che negli occhi suoi risplende / una vert\u00F9 d'amor tanto gentile, / ch'ogni dolce piacer vi si comprende - versi 11-3" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/16/paragrafo/3/exprFrag/234>	ns3:efChars	"altro di vita" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/7/paragrafo/5/exprFrag/83>	ns3:efChars	"v. 13. baldanza" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/7/paragrafo/5/exprFrag/82>	ns3:efChars	"v. 13. baldanza" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/16/paragrafo/8/exprFrag1/415>	ns3:efChars	"s\u00EC che ciascuna vert\u00F9 m'abandona - verso 15" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/35/paragrafo/8/exprFrag1/972>	ns3:efChars	"Vedete ch'i' son un che vo piangendo - verso 1" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/4/exprFrag/263>	ns3:efChars	"v. 2. i' vo' \u2026 dire" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/7/paragrafo/4/exprFrag/79>	ns3:efChars	"v. 9. in vita si dolce e soave" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/7/paragrafo/5/exprFrag/84>	ns3:efChars	"volendo far come coloro" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/7/paragrafo/4/exprFrag/78>	ns3:efChars	"v. 8. nobiltate" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/4/exprFrag/264>	ns3:efChars	"con voi" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/13/paragrafo/1/exprFrag1/271>	ns3:efChars	"tu m'assali, Amore, e mi combatti - verso 2" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/2/exprFrag1/454>	ns3:efChars	"laetatum est cor meum, et exultavit lingua mea - Ps XV, 9" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/4/exprFrag/265>	ns3:efChars	"finire" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/5/exprFrag1/482>	ns3:efChars	"Versi 7-8" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/16/paragrafo/8/exprFrag1/416>	ns3:efChars	"riman figura sol en segnoria / e voce alquanta che parla dolore - versi 7-8" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/13/paragrafo/1/exprFrag1/272>	ns3:efChars	"s\u00EC mi stringe e mi combatte amore - verso 9" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/22/paragrafo/17/exprFrag/361>	ns3:efChars	"ebbero in loro" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/13/paragrafo/1/exprFrag1/274>	ns3:efChars	"Ps XXXIV 16" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/13/paragrafo/1/exprFrag1/275>	ns3:efChars	"Ps LXXVII 56" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/23/paragrafo/21/exprFrag/388>	ns3:efChars	"v. 29. la mia frale vita" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/23/paragrafo/5/exprFrag/367>	ns3:efChars	"le stelle \u2026 piangessero" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/13/paragrafo/1/exprFrag/166>	ns3:efChars	"pensamenti" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/26/paragrafo/7/exprFrag1/848>	ns3:efChars	"che la mente / comprender no la pu\u00F2 - versi 8-9" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/26/paragrafo/7/exprFrag1/844>	ns3:efChars	"che la mente / comprender no la pu\u00F2 - versi 8-9" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/23/paragrafo/5/exprFrag/368>	ns3:efChars	"li uccelli cadessero morti" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/13/paragrafo/1/exprFrag/167>	ns3:efChars	"combattere" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/23/paragrafo/5/exprFrag/369>	ns3:efChars	"grandissimi tremuoti'." .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/26/paragrafo/7/exprFrag1/846>	ns3:efChars	"veder mi par de la sua labbia uscire - Verso 7" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/3/paragrafo/8/exprFrag1/70>	ns3:efChars	"verso 12" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/31/paragrafo/10/exprFrag1/914>	ns3:efChars	"Mundus egebat eo. Sed eum magis eligis esse / tecum quam secum; mavis succurrere coelo / quam mundo - 422-4" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/12/paragrafo/4/exprFrag1/217>	ns3:efChars	"e tu conosci ben ch'i' sono Amore - verso 12" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/31/paragrafo/10/exprFrag1/913>	ns3:efChars	"e passa el ciel sua laude e ad angel monta - verso 11" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/12/paragrafo/4/exprFrag1/216>	ns3:efChars	"Cons. Phil. I pr. I,13 pr. 2,4 pr. 3,2" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/26/paragrafo/7/exprFrag1/843>	ns3:efChars	"imaginar noi pot\u00E8 om che noi prova - verso 53" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/26/paragrafo/1/exprFrag1/806>	ns3:efChars	"per maraviglia ciascuno a vedere / la vanno, e dicon - versi 3-4" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/12/paragrafo/4/exprFrag1/219>	ns3:efChars	"Cons. Phil. pr. 4, I" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/16/paragrafo/5/exprFrag1/401>	ns3:efChars	"versi 10-1" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/35/paragrafo/7/exprFrag/554>	ns3:efChars	"v. 10. dal core" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/26/paragrafo/7/exprFrag1/842>	ns3:efChars	"che la forza d'amare / non sa chi no'lla prova - 2374-5" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/26/paragrafo/1/exprFrag1/805>	ns3:efChars	"analogia col passaggio di Ges\u00F9 tra le turbe" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/12/paragrafo/4/exprFrag1/218>	ns3:efChars	"quid taces? - Cons. Phil., i, pr. 2, 4" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/31/paragrafo/10/exprFrag1/916>	ns3:efChars	"quibus dignus non erat mundus - XI, 38" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/26/paragrafo/7/exprFrag1/840>	ns3:efChars	"Posso degli occhi miei novella dire, / la qual \u00E8 tale che piace si al core / che di dolcezza ne sospir' Amore - versi 1-3" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/26/paragrafo/2/exprFrag/452>	ns3:efChars	"Questa non \u00E8 femmina" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/26/paragrafo/2/exprFrag/453>	ns3:efChars	"E altri diceano" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/26/paragrafo/5/exprFrag1/829>	ns3:efChars	"pi\u00F9 che stella diana splende e pare - verso 3" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/26/paragrafo/5/exprFrag1/828>	ns3:efChars	"Lo vostro bel saluto e 'l gentil sguardo / che fate - versi 1-2" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/26/paragrafo/2/exprFrag/454>	ns3:efChars	"una maraviglia" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/31/paragrafo/10/exprFrag1/912>	ns3:efChars	"lo ciel passasti - verso 53" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/23/paragrafo/25/exprFrag1/720>	ns3:efChars	"viso di neve colorato in grana - verso 5" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/26/paragrafo/5/exprFrag1/827>	ns3:efChars	"Passa per via adorna e s\u00EC gentile / ch'abassa orgoglio a cui dona salute - versi 9-10" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/26/paragrafo/2/exprFrag/455>	ns3:efChars	"che benedetto sia lo Segnore, che" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/31/paragrafo/10/exprFrag1/911>	ns3:efChars	"i' non mertai mai gi\u00E0 tanto gran cosa, / ma solo fu vostra pietanza fina - verso 61" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/13/paragrafo/8/exprFrag/180>	ns3:efChars	"e sol s'accordano" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/2/paragrafo/4/exprFrag/8>	ns3:efChars	"In quello punto" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/33/paragrafo/5/exprFrag1/943>	ns3:efChars	"l'anima si briga di partire - verso 2" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/23/paragrafo/25/exprFrag1/721>	ns3:efChars	"veggio piover per l'aere martiri - verso 13" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/22/paragrafo/9/exprFrag1/653>	ns3:efChars	"versi 9-11" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/26/paragrafo/5/exprFrag1/826>	ns3:efChars	"versi 6-7" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/23/paragrafo/25/exprFrag1/722>	ns3:efChars	"Mt 21,9" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/23/paragrafo/27/exprFrag1/724>	ns3:efChars	"c'ha preso forma di figura umana" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/33/paragrafo/5/exprFrag1/941>	ns3:efChars	"Tu m'hai s\u00EC piena di dolor la mente - verso 1" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/13/paragrafo/1/exprFrag/168>	ns3:efChars	"tentare" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/23/paragrafo/27/exprFrag1/723>	ns3:efChars	"incarnata" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/2/paragrafo/4/exprFrag/9>	ns3:efChars	"lo spirito de la vita" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/26/paragrafo/2/exprFrag/451>	ns3:efChars	"coronata e vestita d'umilitade" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/39/paragrafo/4/exprFrag1/991>	ns3:efChars	"lo qual s\u00F2l apparir quand'om si more - verso 3" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/23/paragrafo/23/exprFrag/393>	ns3:efChars	"v. 47. traendo guai" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/40/paragrafo/10/exprFrag1/1006>	ns3:efChars	"Poi che di doglia cor conven ch'i' porti - verso 1" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/5/exprFrag1/479>	ns3:efChars	"E dico che' miei spiriti son morti - verso 5" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/16/paragrafo/2/exprFrag/232>	ns3:efChars	"quando la mia memoria" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/23/paragrafo/23/exprFrag/392>	ns3:efChars	"v. 46. di sciolte" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/34/paragrafo/10/exprFrag/544>	ns3:efChars	"v. 10. con una voce" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/34/paragrafo/10/exprFrag/543>	ns3:efChars	"v. 9. Piangendo" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/25/paragrafo/1/exprFrag1/760>	ns3:efChars	"ed io si dico che non \u00E8 neiente - verso 7" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/1/paragrafo/1/exprFrag1/3>	ns3:efChars	"Canzon,. . . de' libri d'Amore / io t'asemplai - versi 43-4" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/23/paragrafo/17/exprFrag/380>	ns3:efChars	"v.1. Donna" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/25/paragrafo/1/exprFrag1/761>	ns3:efChars	"Molti l'amore apellano dietate / per c'om visibolmente lo comprende - versi 1-2" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/1/paragrafo/1/exprFrag1/2>	ns3:efChars	"Il titolo di questo libro ... si \u00E8 cotale: Qui comincialo 'nsegnamento di rettorica \u2026 - Rett. I 12" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/23/paragrafo/17/exprFrag/381>	ns3:efChars	"v. 2. adorna assai di" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/25/paragrafo/1/exprFrag1/762>	ns3:efChars	"Per\u00F2 ch'amore no si p\u00F2 vedere / e no si tratta corporalemente - versi 1-2" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/26/paragrafo/3/exprFrag/460>	ns3:efChars	"noi convenisse" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/13/exprFrag1/554>	ns3:efChars	"Canzon, tu sai - verso 1" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/3/paragrafo/1/exprFrag1/39>	ns3:efChars	"Non enim sciebat quid diceret; erant enim timore exterriti - Mc IX 5" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/13/paragrafo/9/exprFrag/188>	ns3:efChars	"e dico" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/3/paragrafo/7/exprFrag/36>	ns3:efChars	"la sua letizia si convertia in amarissimo pianto" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/23/paragrafo/20/exprFrag1/708>	ns3:efChars	"ruppe ogni valore - verso 10" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/8/paragrafo/1/exprFrag/90>	ns3:efChars	"pietosamente" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/13/exprFrag1/557>	ns3:efChars	"Poi se' nata d'Amore ancella nova" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/23/paragrafo/20/exprFrag1/709>	ns3:efChars	"ho perduto ogni valore - verso 4" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/13/paragrafo/9/exprFrag/184>	ns3:efChars	"accordanza" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/23/paragrafo/20/exprFrag1/706>	ns3:efChars	"che difes'hai, che tu non \u00E8i perito? - verso 14" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/12/paragrafo/14/exprFrag/159>	ns3:efChars	"d'ogni piet\u00E0 chiave" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/22/paragrafo/16/exprFrag1/660>	ns3:efChars	"quelli martiri / che soglion consumare altru' piangendo - versi 13-4" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/13/exprFrag1/558>	ns3:efChars	"Ballata giovenzella - verso 25" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/41/paragrafo/10/exprFrag1/1014>	ns3:efChars	"verso 53" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/12/paragrafo/4/exprFrag1/220>	ns3:efChars	"aspettando se alcuna cosa rispondesse o dicesse - III, 1" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/23/paragrafo/2/exprFrag1/662>	ns3:efChars	"V\u00E8n, che m'uccide, uno sottil pensero / che par che dica ch'i' mai no la veggia - versi 11-2" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/13/paragrafo/9/exprFrag/185>	ns3:efChars	"la mia nemica" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/23/paragrafo/20/exprFrag1/707>	ns3:efChars	"Sta come quella che non ha valore - verso 5" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/26/paragrafo/7/exprFrag1/849>	ns3:efChars	"un lume pien di spiriti d'amore - verso 2" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/12/paragrafo/4/exprFrag1/221>	ns3:efChars	"l segnor valente / che segnoreggia il mondo de l'onore - versi 3-4" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/3/paragrafo/1/exprFrag1/37>	ns3:efChars	"vestimenta eius facta sunt splendentia, et candida nimis velut nix - Mc IX,2" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/13/paragrafo/9/exprFrag/186>	ns3:efChars	"soppongo" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/23/paragrafo/20/exprFrag1/704>	ns3:efChars	"verso 47" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/3/paragrafo/7/exprFrag/37>	ns3:efChars	"verso lo cielo" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/3/paragrafo/7/exprFrag/39>	ns3:efChars	"si ruppe e fui disvegliato" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/3/paragrafo/1/exprFrag1/38>	ns3:efChars	"Et apparuit illis Elias cum Moyse\u2026 - Mc IX 3" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/13/paragrafo/9/exprFrag/187>	ns3:efChars	"qual parte" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/23/paragrafo/20/exprFrag1/705>	ns3:efChars	"or che ha' tu che se' cosi dolente? - verso 2" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/3/paragrafo/7/exprFrag/38>	ns3:efChars	"deboletto" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/1/paragrafo/1/exprFrag/6>	ns3:efChars	"MI F\u00C9 ... DONAGIONE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/9/paragrafo/1/exprFrag1/354>	ns3:efChars	"Quant je chevauchoie versi 12-13 \u00AB[la dama] si chanta maintenant / ceste chan\u00E7onete\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/7/paragrafo/1/exprFrag1/303>	ns3:efChars	"ant es d'amor honratz sos seignoratges verso 13 e dic vos ben, si la forsa fos mia" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/1/paragrafo/1/exprFrag/7>	ns3:efChars	"CON BELLA ACCOGLIENZA" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/9/paragrafo/1/exprFrag1/355>	ns3:efChars	"l'ultima stanza ricorda le peregrinazioni del testo nella ricerca di qualcuno \u00ABche ti vestisse\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/1/paragrafo/1/exprFrag/8>	ns3:efChars	"CAMISCIA" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/1/paragrafo/1/exprFrag/4>	ns3:efChars	"BELLA FAZZONE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/9/paragrafo/1/exprFrag1/356>	ns3:efChars	"\u00ABlo vers comenssa / a son veil\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/7/paragrafo/1/exprFrag1/301>	ns3:efChars	"Clig\u00E8s, 475-6 Oeil, vos m'avez tra\u00EFe! / Par vos m'a mes cuers enha\u00EFe" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/1/paragrafo/1/exprFrag/5>	ns3:efChars	"DI CUI ... S'AGENZA" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/9/paragrafo/1/exprFrag1/357>	ns3:efChars	"una rubrica del codice che trasmette le poesie dell'Anonimo Genovese, \u00ABCantione de beata Virgine secundum sonum De l'alegra montanina\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/9/paragrafo/1/exprFrag1/350>	ns3:efChars	"Sol nimium fervens 15 \u00ABFlora sibi nomen\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/9/paragrafo/1/exprFrag1/352>	ns3:efChars	"Fasti V 184" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/9/paragrafo/1/exprFrag1/351>	ns3:efChars	"Na Flors" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/1/paragrafo/1/exprFrag/9>	ns3:efChars	"DI TANTO ... MI FRANCAI" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/9/paragrafo/1/exprFrag1/353>	ns3:efChars	"Avant hier en un vert pre versi 6-7 \u00ABl'une estoit si jolivete, / qui chantoit ensi\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/1/paragrafo/1/exprFrag/2>	ns3:efChars	"VIS\u00CFONE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/9/paragrafo/1/exprFrag1/358>	ns3:efChars	"Donna, l'amor mi sforza verso 45 [voglio] ghirlanda portare" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/1/paragrafo/1/exprFrag/3>	ns3:efChars	"NE TRAI VERA SENTENZA" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/9/paragrafo/1/exprFrag1/359>	ns3:efChars	"in rima con um\u00ECle e sottile come nella fronte di Cavalcanti, Pegli occhi fere" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/1/paragrafo/1/exprFrag/0>	ns3:efChars	"PROVEDI ... ELLA" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/1/paragrafo/1/exprFrag/1>	ns3:efChars	"PROVEDI" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/38/paragrafo/2/exprFrag/550>	ns3:efChars	"LO BEN ... DIMONI" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/3/paragrafo/1/exprFrag1/153>	ns3:efChars	"Lasso, per ben servir son adastiato" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/38/paragrafo/1/exprFrag1/1153>	ns3:efChars	"Cecco d'Ascoli, La invidia a me \u00E0 dato s\u00EC de morso 5-8 \u00ABO messer Cino, io veggio ch'\u00E8 discorso / il tempo omai che pianger s\u00EC convene, / poi che la setta che il vizio mantene / par che dal cielo ogni ora abbi soc- corso\u00BB." .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/36/paragrafo/2/exprFrag/520>	ns3:efChars	"COS\u00CC CHIAMATO" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/9/paragrafo/1/exprFrag1/343>	ns3:efChars	"Belle Aliz matin leva 4-6 \u00AB[Aliz] cink flurettes i [nel bosco] trouva: / un cha- pelet fet en a / de rose fleurie\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/38/paragrafo/1/exprFrag1/1152>	ns3:efChars	"anonimo Dante Alleghier 14 \u00ABche porta propiamente Amor nel viso\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/36/paragrafo/2/exprFrag/521>	ns3:efChars	"BRIEVE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/9/paragrafo/1/exprFrag1/344>	ns3:efChars	"jeu de chapelet versi 4181-4300" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/38/paragrafo/1/exprFrag1/1151>	ns3:efChars	"Cino, Ci\u00F2 ch'io veggio di qua m'\u00E8 mortal duolo 2-4 \u00ABi' so' lunge e tra selvaggia gente, / la qual i' fuggo, e sto celatamente / perch\u00E9 mi trovi Amor col penser solo\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/36/paragrafo/2/exprFrag/522>	ns3:efChars	"AFFANNATO" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/36/paragrafo/2/exprFrag/523>	ns3:efChars	"CHE ... VETTA" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/6/paragrafo/1/exprFrag1/244>	ns3:efChars	"Rettorica 76, 14 \u00ABCosie usatamente adviene che due persone si tramettono lette- re l'uno all'altro o in latino o in proxa o in rima o in volgare o inn- altro, nelle quali contendono d'alcuna cosa, e cos\u00EC fanno tencione. Altress\u00EC uno amante chiamando merz\u00E9 alla sua donna dice parole e ragioni molte\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/38/paragrafo/1/exprFrag1/1150>	ns3:efChars	"Baudouin de Cond\u00E9, Dis de Tunis 73-4 \u00ABet Charit\u00E9s, par Avarisse, / n'a de re- cet ou se garisse [si ripari]\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/36/paragrafo/2/exprFrag/524>	ns3:efChars	"SECONDO ... HAI" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/25/paragrafo/3/exprFrag/341>	ns3:efChars	"NOVELLO" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/6/paragrafo/1/exprFrag1/247>	ns3:efChars	"incipit di Guittone, La dolorosa mente, ched eo porto" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/25/paragrafo/3/exprFrag/340>	ns3:efChars	"BEN TI FARANNO ... STAGNO" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/6/paragrafo/1/exprFrag1/248>	ns3:efChars	"La dolorosa vita che si prova" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/38/paragrafo/1/exprFrag1/1155>	ns3:efChars	"Cavalcanti, I' vegno 'l giorno 10 \u00ABfar mostramento che tu' dir mi piaccia\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/25/paragrafo/3/exprFrag/343>	ns3:efChars	"MA ... DETTO" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/6/paragrafo/1/exprFrag1/249>	ns3:efChars	"\u00ABbiasmo la dolze Toscana / che mi diparte lo core\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/38/paragrafo/1/exprFrag1/1154>	ns3:efChars	"Giraut de Borneil, Jois sia comensamens 64-6 \u00ABReis omnipotens, / alques chamjet la sazos / En c'om era bos!\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/25/paragrafo/3/exprFrag/342>	ns3:efChars	"CH\u00C9 ... CARNE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/38/paragrafo/1/exprFrag1/1149>	ns3:efChars	"Guilhem de Montanhagol, Non estarai, per ome qe\u00B7m casti 27 \u00ABqu'estiers non vei on pretz trobe gandia\u00BB ('altrimenti non vedo dove l'onore trovi riparo');" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/38/paragrafo/1/exprFrag1/1148>	ns3:efChars	"Cino, Se tu sapessi ben com'io aspetto 5-6 \u00ABio son distretto / di quel Signore cui servir m'agenzo\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/9/paragrafo/1/exprFrag1/346>	ns3:efChars	"Mamma lo temp'\u00E8 venuto versi 18-19, nei Memoriali bolognesi" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/9/paragrafo/1/exprFrag1/348>	ns3:efChars	"Flora (nn. 73, 83, 104 [II], 106, 186)" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/7/paragrafo/1/exprFrag1/305>	ns3:efChars	"S'io non temesse la Ragione prima versi 13-14 Eo stesso m'ancidr\u00F2, ch\u00E9 non pensava / ch'oscuro le fosse ci\u00F2 ch'omo vede" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/9/paragrafo/1/exprFrag1/349>	ns3:efChars	"Florula (nn. 103.2a \u00ABFlorulam\u00BB [9] e 108.2b \u00ABque mea michi Florula / det oscula\u00BB [8- 9])" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/25/paragrafo/3/exprFrag/830>	ns3:efChars	"A' FI' DI STAGNO" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/36/paragrafo/1/exprFrag1/1116>	ns3:efChars	"\u00ABelli ne faranno alta vendetta\u00BB (Livio volgarizzato)" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/37/paragrafo/2/exprFrag1/1137>	ns3:efChars	"Bertran de Born ricorre allo stesso genere di exemplum: Fuilhetas, ges autres vergiers 6 \u00ABQ'ieu ai ja vist albre fuilhat\u00BB." .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/9/paragrafo/1/exprFrag1/370>	ns3:efChars	"Or sus, vous dorm\u00E9s trop, ma dame joliete versi 50-51 \u00ABDe vous que j'aim ... / ay fait cest virelay\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/9/paragrafo/1/exprFrag1/371>	ns3:efChars	"Cronica V 29 \u00ABper leggiadria portano ... le penne del gufo in capo\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/36/paragrafo/1/exprFrag1/1114>	ns3:efChars	"citare in giudizio" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/36/paragrafo/1/exprFrag1/1115>	ns3:efChars	"Bono Giamboni: \u00ABcadrebbe a lei di dirti in prima i suoi ammunimenti\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/9/paragrafo/1/exprFrag1/372>	ns3:efChars	"Da che mi conven fare versi 88-89 ch'io non poria far quella / che degna non foss'ella" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/48/paragrafo/2/exprFrag1/1644>	ns3:efChars	"Cino, Signor, e' non pass\u00F2 mai peregrino 12 \u00ABQuesta dagli occhi mie' men'una pioggia\u00BB." .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/36/paragrafo/1/exprFrag1/1112>	ns3:efChars	"Quaresimale fiorentino, s.v. richiamarsi 'appellarsi, lamentarsi di qualcosa presso l'autorit\u00E0 giudiziaria'" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/10/paragrafo/1/exprFrag/169>	ns3:efChars	"MERC\u00C9 ... CORTESIA" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/36/paragrafo/1/exprFrag1/1113>	ns3:efChars	"tel se claime a vos de tel" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/6/paragrafo/1/exprFrag1/250>	ns3:efChars	"\u00ABDolze e gaia terra fiorentina\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/10/paragrafo/1/exprFrag/168>	ns3:efChars	"CERC\u00D2" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/48/paragrafo/2/exprFrag1/1642>	ns3:efChars	"pseudo-Dionigi (De divinis nominibus IV \u00A7 117)" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/6/paragrafo/1/exprFrag1/251>	ns3:efChars	"\u00ABque forsa d'amor li fez far\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/36/paragrafo/1/exprFrag1/1110>	ns3:efChars	"Cecco Angiolieri: cfr. Qual \u00E8 senza danari innamorato 7 \u00ABnon ho di che pagar potesse un messo\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/48/paragrafo/2/exprFrag1/1643>	ns3:efChars	"Tommaso (\u00A7 311): \u00ABsi est aliquid quod non par- ticipat lumine eius, hoc non est propter debilitatem vel parvitatem illuminantis virtutis in ipso ..., sed propter defectum eorum quae non possunt extendere se ad partecipandum lumen solis\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/36/paragrafo/1/exprFrag1/1111>	ns3:efChars	"Anonimo, A te medesmo mi richiamo, amore 1-2 \u00ABA te medesmo mi richiamo, amore, / di te\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/6/paragrafo/1/exprFrag1/252>	ns3:efChars	"\u00ABco la forza d'amore / el ten\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/10/paragrafo/1/exprFrag/164>	ns3:efChars	"HA IN COMPAGNIA" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/10/paragrafo/1/exprFrag/163>	ns3:efChars	"PER\u00D2 CHE ... A S\u00C9" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/6/paragrafo/1/exprFrag1/254>	ns3:efChars	"L'anima mia versi 5 e 10" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/6/paragrafo/1/exprFrag1/256>	ns3:efChars	"Rimembrivi oramai verso 2" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/10/paragrafo/1/exprFrag/167>	ns3:efChars	"NOVO COLORE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/10/paragrafo/1/exprFrag/165>	ns3:efChars	"PRINCIPIO" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/10/paragrafo/1/exprFrag/166>	ns3:efChars	"CONFORTO ... SPERANZA" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/6/paragrafo/1/exprFrag1/258>	ns3:efChars	"Laudario di Santa Maria della Scala XVIII 5 Piacciati, bel Ges\u00F9, d'alluminare" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/10/paragrafo/1/exprFrag/160>	ns3:efChars	"MADONNA" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/9/paragrafo/1/exprFrag1/374>	ns3:efChars	"Sovrana ballata placente versi 37-38 \u00ABVaten', balata novella, / en Pisa, cantante 'mpromera\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/9/paragrafo/1/exprFrag1/373>	ns3:efChars	"Tanto saggio e bon poi me somegli (L 346) 7 \u00ABDeo, com'el tu' don a me piac'egli\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/6/paragrafo/1/exprFrag1/259>	ns3:efChars	"Tant m'abellis l'amoros pessamens versi14-15 si de lieis cui desire / non ai socors, ni d'aillor no l'aten" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/9/paragrafo/1/exprFrag1/375>	ns3:efChars	"Dixem'Amor: Questa donna pi\u00F9 vol te verso 5 faite cantar davanti a la soa fazza" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/10/paragrafo/1/exprFrag/162>	ns3:efChars	"AMICA DI PIETATE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/10/paragrafo/1/exprFrag1/403>	ns3:efChars	"Tutto lo mondo si mantien per fiore 14 vostra merc\u00E9, madonna, fior aulente" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/9/paragrafo/1/exprFrag1/376>	ns3:efChars	"versi 8-10 e quando gionge, pregote che fazza / a soa fegura bella / reverenza ed onor" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/10/paragrafo/1/exprFrag1/402>	ns3:efChars	"Omo non fu ch'amasse lealmente 14 merz\u00E9 cherendo a vostra cortesia (Corona IX)" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/10/paragrafo/1/exprFrag/161>	ns3:efChars	"SIGNOR ... OCCHI" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/9/paragrafo/1/exprFrag1/377>	ns3:efChars	"Movo canto amoroso novamente 47-8 tu d\u00EBi sperar d'aver onore, / poi che tu vai a donna conoscente" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/37/paragrafo/1/exprFrag/527>	ns3:efChars	"NON ... FENICE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/25/paragrafo/3/exprFrag1/1798>	ns3:efChars	"\u00ABPetruccino Stagni\u00BB nei Capitoli della Compagnia dei Porta- tori di Firenze, anno 1317 (corpus TLIO)" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/37/paragrafo/1/exprFrag/526>	ns3:efChars	"S'I' LA RIGUARDO" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/37/paragrafo/1/exprFrag/525>	ns3:efChars	"NOVELLAMENTE ... SIA 'L VERDE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/36/paragrafo/1/exprFrag1/1109>	ns3:efChars	"Novellino LXX 8 \u00ABs\u00E8 tu la pi\u00F9 forte cosa ch'io mai trovasse\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/3/paragrafo/1/exprFrag/67>	ns3:efChars	"AMOR ... APPRUOVI" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/8/paragrafo/1/exprFrag/136>	ns3:efChars	"GUIDO, ... SAREMMO NOI" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/37/paragrafo/2/exprFrag1/1138>	ns3:efChars	"Guiraut Riquier, Aissi pert poder amors 21-3 \u00ABE ioys, quant pretz n'es partitz, / es arbres senes razitz / de tot frug desesperatz\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/8/paragrafo/1/exprFrag/137>	ns3:efChars	"GUIDO" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/3/paragrafo/1/exprFrag/69>	ns3:efChars	"DISTRETTO" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/8/paragrafo/1/exprFrag/138>	ns3:efChars	"PRESI PER INCANTAMENTO" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/37/paragrafo/1/exprFrag/528>	ns3:efChars	"CHE FAR\u00D2, DANTE?" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/37/paragrafo/2/exprFrag1/1139>	ns3:efChars	"Ovidio, Met. II 1-33" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/3/paragrafo/1/exprFrag/68>	ns3:efChars	"AMOR ... AMARE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/8/paragrafo/1/exprFrag/139>	ns3:efChars	"IN UN TALENTO" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/9/paragrafo/1/exprFrag1/360>	ns3:efChars	"Festa dies fuerat sancto celebrata Iohanni 5-6 \u00ABIngre- dior templum varia de gente repletum; / intus et exterius pervolita- bat Amor\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/6/paragrafo/1/exprFrag1/260>	ns3:efChars	"Anc no\u00B7m parti de solatz ni de chan versi 22-23  \u00ABAutre socors non aten ni deman / mas sol de lieis, s'ieu aver lo pogues\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/6/paragrafo/1/exprFrag1/261>	ns3:efChars	"De fin'amor son tuit mei pessamen versi 35-36 pero qant homs als seus secor e val, / bella domna, fai son pro veramen" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/6/paragrafo/1/exprFrag1/262>	ns3:efChars	"Ben volria saber d'Amor versi 9-12 Ia aten hom d'alcun seingnor, / cui hom serv de cor lialmen, / quan locs ni aizes lo\u00B7il consen, / de far ben a son servidor" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/10/paragrafo/1/exprFrag/159>	ns3:efChars	"MADONNA, ... CORTESIA" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/6/paragrafo/1/exprFrag1/263>	ns3:efChars	"In gioi mi tegno tutta la mia pena versi 19-21 [Amore] non mente a quelli che son suoi, / anti li dona gioi, / come fa buon segnore a suo servente" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/6/paragrafo/1/exprFrag1/264>	ns3:efChars	"Vituperio sempiternale sar\u00E0 al segnore se per la ingiuria de' suoi subditi non si muove a l'arme ... Lo segnore riceve dispregio nella ingiuria de' vassalli se lle sue mani se stancano de fare vendetta" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/9/paragrafo/1/exprFrag1/366>	ns3:efChars	"Partitz de joy e d'amor verso 4 \u00ABMas per creisser ma dolor\u00BB)" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/6/paragrafo/1/exprFrag1/265>	ns3:efChars	"Amor, che lungiamente m'hai menato versi 22-23 E certo no gli \u00E8 troppo disinore / quand'omo \u00E8 vinto" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/6/paragrafo/1/exprFrag1/267>	ns3:efChars	"Lancan folhon bosc e jarric 39-40 e port el cor, on que m'estei, / sa beutat e sa fachura" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/9/paragrafo/1/exprFrag1/367>	ns3:efChars	"D'amor son preso, s\u00EC che me ritrarne verso 12 \u00ABdi Fin Presgio portate la corona\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/6/paragrafo/1/exprFrag1/266>	ns3:efChars	"Meravigliosamente verso 28 al cor m'ard'una doglia" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/6/paragrafo/1/exprFrag1/268>	ns3:efChars	"Tan mou de cortesa razo verso 41 qu'inz el cor remir sa faisso" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/9/paragrafo/1/exprFrag1/368>	ns3:efChars	"Quando la stella versi 3-10 \u00ABAmor gentil m'apparse ne la mente: / ... / una ghirlanda 'n su le trezze bionde / di foglie verdi pose con le fronde\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/6/paragrafo/1/exprFrag1/269>	ns3:efChars	"Meravigliosamente versi 10-11 In cor par ch'eo vi porti, / pinta come parete" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/9/paragrafo/1/exprFrag1/369>	ns3:efChars	"Urbs beata Hierusalem la citt\u00E0 \u00E8 detta \u00ABangelis coronata\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/9/paragrafo/1/exprFrag1/362>	ns3:efChars	"Cavalcanti, S'io prego 6" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/9/paragrafo/1/exprFrag1/364>	ns3:efChars	"Posso degli occhi verso 24 che mostri quella che t'ha fatto onore" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/9/paragrafo/1/exprFrag1/365>	ns3:efChars	"Roman de la Rose verso 9056 Pour sa biaut\u00E9 croistre" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/1/paragrafo/1/exprFrag1/49>	ns3:efChars	"Somniale Danielis, \u00ABMatrem suam mortuam aut vivam audire [ma \u00E8 attestata la variante videre] securitatem significat\u00BB; e quella pubblicata da Martin 1981, p. 172 \u00ABMatrem suam vivam aut mortuam videre: securitatem\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/1/paragrafo/1/exprFrag1/48>	ns3:efChars	"Rasis: \u00ABMatrem mortuam videre: gaudium\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/1/paragrafo/1/exprFrag1/47>	ns3:efChars	"Bernart de Ventadorn, Be\u00B7m cuidei de chantar sofrir 18 \u00ABdel plus ... prendetz esgardamen!\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/1/paragrafo/1/exprFrag1/46>	ns3:efChars	"Raimon de Miraval, Cel que no vol auzir chanssos 10-4 \u00ABDesir lo tener e\u00B7l baisar, / e\u00B7l jazer e-l plus conquistar, / et apres, mangas e cordos, / e del plus qe-il clames merces\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/1/paragrafo/1/exprFrag1/45>	ns3:efChars	"Chr\u00E9tien de Troyes, Le Conte du Graal, 511-2, il sovrappi\u00F9 \u00E8 appunto ci\u00F2 che tien dietro al bacio: \u00ABSe lo baisier vos en consent, / lo so- replus vos en desfant\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/8/paragrafo/1/exprFrag/140>	ns3:efChars	"DI STAR ... DISIO" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/8/paragrafo/1/exprFrag/141>	ns3:efChars	"VANNA" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/1/paragrafo/1/exprFrag1/44>	ns3:efChars	"Je sui jonete et jolie 16 \u00ABDel plus mon pleisir fer\u00E9\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/1/paragrafo/1/exprFrag1/43>	ns3:efChars	"L'autre jour en un jardin 44-5 \u00ABet me foula et ledi / plus que je ne di\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/8/paragrafo/1/exprFrag/142>	ns3:efChars	"LAGIA" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/8/paragrafo/1/exprFrag/143>	ns3:efChars	"QUELLA ... TRENTA" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/8/paragrafo/1/exprFrag/144>	ns3:efChars	"RAGIONAR ... D'AMORE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/36/paragrafo/1/exprFrag/519>	ns3:efChars	"ALTA VENDETTA" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/36/paragrafo/1/exprFrag/518>	ns3:efChars	"CADE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/6/paragrafo/1/exprFrag1/270>	ns3:efChars	"D'un'amorosa voglia mi convene verso 11" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/6/paragrafo/1/exprFrag1/271>	ns3:efChars	"Di voi mi stringe tanto lo desire verso 13 che 'n cor vi porto pinta tuttavia" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/11/paragrafo/1/exprFrag1/410>	ns3:efChars	"Miserere mei, Deus, miserere mei, quoniam in te confidit anima mea Ps 56,2" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/6/paragrafo/1/exprFrag1/272>	ns3:efChars	"Signor, e' non pass\u00F2 mai peregrino versi 9-10 [Amore] coll'altra [mano] nella mia mente pinge, / a simil di piacer s\u00EC bella foggia" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/6/paragrafo/1/exprFrag1/273>	ns3:efChars	"\"ut quasi auream nobis fabricemus in corde nostro imaginem sponsi tui\" Super extremam partem Cantici canticorum sermones CXX, sermo 11" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/6/paragrafo/1/exprFrag1/274>	ns3:efChars	"Gn 1, 27 Et creavit Deus hominem ad imaginem suam" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/6/paragrafo/1/exprFrag1/275>	ns3:efChars	"Bona dona, cuy ricx pretz fai valer verso 17 E si de vos dizetz que\u00B7m dezesper" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/7/paragrafo/1/exprFrag1/298>	ns3:efChars	"\u00ABquem [Ges\u00F9] cum non videritis diligitis; in quem nunc quoque non videntes, credentes autem exultatis laeti- tia inenarrabili et glorificata\u00BB (I Pt 1, 8)." .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/7/paragrafo/1/exprFrag1/299>	ns3:efChars	"\u00ABTestor populi venientis gratiam ..., me non videntes oculis carnalibus, sed spiritu credent quae dixi\u00BB (IV Esr 1, 37)" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/6/paragrafo/1/exprFrag1/276>	ns3:efChars	"Nova danza pi\u00F9 fina versi 27-31 Immantenente mi mandate / di voi asicurando / ca, se tropo vi tardirete, / amor vostro lepando, / sacciate ben mi perderete!" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/6/paragrafo/1/exprFrag1/278>	ns3:efChars	"S'eo sono innamorato e duro pene versi 21-23 E se tardate pi\u00F9, saciate eo p\u00E8ro, / tant'ho nel core affanno, pena e vita: / non p\u00F2, se non da voi, esser sanato" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/11/paragrafo/1/exprFrag1/416>	ns3:efChars	"Apc 19, 12 \u00ABOculi ... eius sicut flamma ignis\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/6/paragrafo/1/exprFrag1/277>	ns3:efChars	"Ab lo temps qe fai refreschar versi 44-45 e sapchas ... / qu'eu non puesc lonjamen estar" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/6/paragrafo/1/exprFrag1/279>	ns3:efChars	"\"Chi \u00E8 misero e mendico, provi tutti e poi l'amico\"" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/11/paragrafo/1/exprFrag1/415>	ns3:efChars	"Fresca rosa novella versi 32-34 \u00ABOltra natura umana / vostra fina piasenza / fece Dio\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/11/paragrafo/1/exprFrag1/418>	ns3:efChars	"Cavalcanti, Se vedi Amore verso 2 \u00ABin parte l\u00E0 've Lapo sia presente\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/11/paragrafo/1/exprFrag1/417>	ns3:efChars	"\u00ABomnes autem visum igni tribuunt, quod cuiusdam affectionis cau- sam ignorent. Nam presso agitatoque oculo igneus fulgor apparet\u00BB (De sensu 437a 23-5)" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/11/paragrafo/1/exprFrag1/412>	ns3:efChars	"\u00ABdi costu' che feristi: / quando tuoi occhi co\u00B7mmiei si scontr\u00E2ro\u00BB (versi 5-6)" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/36/paragrafo/1/exprFrag/515>	ns3:efChars	"DANTE ALLEGHIER" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/36/paragrafo/1/exprFrag/514>	ns3:efChars	"DANTE ALLEGHIER, ... NEL VISO" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/11/paragrafo/1/exprFrag1/411>	ns3:efChars	"Ct 4, 9 \u00ABvulnerasti cor meum in uno oculorum tuorum\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/11/paragrafo/1/exprFrag1/414>	ns3:efChars	"Ps 30, 2 \u00ABIn te domine speravi, non confundar in aeternum\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/36/paragrafo/1/exprFrag/517>	ns3:efChars	"S'ERA ... DONNA" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/11/paragrafo/1/exprFrag1/413>	ns3:efChars	"Ps 9, 11 \u00ABSperent in te qui noverunt nomen tuum\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/36/paragrafo/1/exprFrag/516>	ns3:efChars	"POTESSE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/6/paragrafo/1/exprFrag/109>	ns3:efChars	"TANTO DI VALORE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/6/paragrafo/1/exprFrag/108>	ns3:efChars	"FORZA D'AMORE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/6/paragrafo/1/exprFrag/107>	ns3:efChars	"DOLCE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/11/paragrafo/1/exprFrag1/409>	ns3:efChars	"Ps 50, 3 Miserere mei Deus, secundum misericordiam tuam" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/3/paragrafo/1/exprFrag1/146>	ns3:efChars	"Un Corzo di Corzan 5-6 \u00ABE ci\u00F2 che Gal\u00EFen ci lasci\u00F2 scritto, / aggio provato per voler campare\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/11/paragrafo/1/exprFrag1/408>	ns3:efChars	"E udii una voce che mi disse: \"la fanciulla che vedi \u00E8 Amore\" lettere di Ildegarda, in the letters of hildegard of bingen, vol 1, 85r" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/3/paragrafo/1/exprFrag1/145>	ns3:efChars	"Ver' la mia donna 2 \u00ABch'un'ora non l'ardisco di cherere\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/11/paragrafo/1/exprFrag1/407>	ns3:efChars	"Cavalcanti, Era in penser d'amor 22 \u00ABfatta di gioco in figura d'amore\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/3/paragrafo/1/exprFrag1/148>	ns3:efChars	"Primer ch'eo vidi 9 \u00ABE bene veggio omai che lo meo core\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/3/paragrafo/1/exprFrag1/149>	ns3:efChars	"O lasso, che mi val 9 \u00ABE ben conosco troppo folleg- giando\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/3/paragrafo/1/exprFrag1/147>	ns3:efChars	"ben conosc e sai / ieu conosc e sai ques vers / ben sai e conosc veramen" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/7/paragrafo/1/exprFrag1/297>	ns3:efChars	"\u00ABdicit ei Iesus: \"quia vidisti me, credidisti; beati qui non viderunt et crediderunt\"\u00BB (Io 20, 29)" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/3/paragrafo/1/exprFrag1/142>	ns3:efChars	"La dilettosa cera 29-30 \u00ABPartir\u00F2 lo coraggio / da s\u00EC dolze penare?\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/2/paragrafo/2/exprFrag/27>	ns3:efChars	"QUAL CHE ... PARAGGIO" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/3/paragrafo/1/exprFrag1/141>	ns3:efChars	"\u00ABDa doglia e da rancura lo meo core / veggio partire\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/7/paragrafo/1/exprFrag1/296>	ns3:efChars	"v. 2 \u00ABamendate 'l gran fallire\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/3/paragrafo/1/exprFrag1/144>	ns3:efChars	"Non perch'eo v'aggia, donna, fatto offesa 13 \u00ABda tale error partite lo co- raggio\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/7/paragrafo/1/exprFrag1/295>	ns3:efChars	"Perch\u00E9 non fuoro a me gli occhi dispenti versi 1-3 \u00ABPerch\u00E9 non fuoro a me gli occhi dispenti / o tolti, s\u00EC che de la lor veduta / non fosse nella mente mia venuta [la donna]?\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/2/paragrafo/2/exprFrag/29>	ns3:efChars	"AMICO" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/7/paragrafo/1/exprFrag1/294>	ns3:efChars	"A Deu coman vos e\u00B7l vostre ric pre\u00E7 versi 29-30 \u00ABGen m'en trairon, mai trop me fan doler, / mei oills lairon, che mi feiron ve\u00E7er\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/3/paragrafo/1/exprFrag1/143>	ns3:efChars	"Lasso, merz\u00E9 cherere 18 \u00ABs'eo gi\u00E0 mai partisse lo mio core\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/2/paragrafo/2/exprFrag/28>	ns3:efChars	"QUAL CHE VOI SIATE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/6/paragrafo/1/exprFrag/106>	ns3:efChars	"LA DISPIETATA ... VAI" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/49/paragrafo/2/exprFrag/742>	ns3:efChars	"SON MOSSO" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/3/paragrafo/1/exprFrag1/140>	ns3:efChars	"\u00ABMeravigliosamente / un amor mi distringe\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/49/paragrafo/2/exprFrag/740>	ns3:efChars	"SDEGNATO ... MESCHINO" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/49/paragrafo/2/exprFrag/741>	ns3:efChars	"DA LE ... PIETATE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/6/paragrafo/1/exprFrag1/281>	ns3:efChars	"de liey servir sui volontos verso 37" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/11/paragrafo/1/exprFrag1/420>	ns3:efChars	"Dt 9, 27 \u00ABne aspicias duritiam populi huius\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/6/paragrafo/1/exprFrag1/282>	ns3:efChars	"Aissi cum cel c'am'e non es amaz versi 12-14 per qu'eu me soi, del tot a vos donaz, / bona dona, que d'al non ai talan / mas de servir vostre cors benestan" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/6/paragrafo/1/exprFrag1/283>	ns3:efChars	"Lo 'namorato core versi 57-58 ca sol per voi servire / voria valer, pi\u00F9 che per mia piagenza" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/11/paragrafo/1/exprFrag1/422>	ns3:efChars	"\u00ABNe respicias peccata mea, sed fidem Ecclesiae tuae\u00BB Rito della comunione" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/6/paragrafo/1/exprFrag1/284>	ns3:efChars	"S'ieu en pascor non chantava verso 50 ni non vuelh ren don sos pretz valgues mens" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/11/paragrafo/1/exprFrag1/421>	ns3:efChars	"\u00ABDomine, non aspicias peccata mea, sed fidem huius hominis\u00BB (Gregorio Magno, Dialogi II XXXII 3)." .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/1/paragrafo/1/exprFrag/12>	ns3:efChars	"DEL PI\u00D9 ... GIURARE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/3/paragrafo/1/exprFrag/71>	ns3:efChars	"SOLO UN'ORA" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/6/paragrafo/1/exprFrag1/285>	ns3:efChars	"Movo canto amoroso novamente 22-4 dira'le tosto tosto che non m'attalenta / altro che solo ci\u00F2 che a\u00B7llei contenta: / e quanto vuol, vogl'eo similemente" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/1/paragrafo/1/exprFrag/13>	ns3:efChars	"PI\u00D9" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/3/paragrafo/1/exprFrag/70>	ns3:efChars	"CHE SOLO UN'ORA ... PENSARE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/6/paragrafo/1/exprFrag1/286>	ns3:efChars	"Amor tanto altamente versi 83-84 che 'n nulla cosa / che lei non sia gioiosa e' non so' vago" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/1/paragrafo/1/exprFrag/14>	ns3:efChars	"MORTA" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/3/paragrafo/1/exprFrag/73>	ns3:efChars	"E ... VERACEMENTE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/6/paragrafo/1/exprFrag1/287>	ns3:efChars	"De servir bon senhor verso16 qu'elha\u00B7m pot ben donar so qu'ieu non ay" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/6/paragrafo/1/exprFrag1/289>	ns3:efChars	"Poich'a voi piace, Amore verso 39-40 La vostra ciera umana / mi d\u00E0 conforto e facemi alegrare" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/3/paragrafo/1/exprFrag/72>	ns3:efChars	"D'OVIDIO ... GUARIRE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/6/paragrafo/1/exprFrag1/288>	ns3:efChars	"L'autrier verso 35 Si fossetz un pauc humana!" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/1/paragrafo/1/exprFrag/10>	ns3:efChars	"PRESILA ABBRACCIARE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/1/paragrafo/1/exprFrag/11>	ns3:efChars	"LA BELLA" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/38/paragrafo/2/exprFrag/833>	ns3:efChars	"D'OPRA ... SCIOLTO:" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/11/paragrafo/1/exprFrag1/424>	ns3:efChars	"Non gi\u00E0 per gioia ch'aggia mi conforto 54-6 \u00ABper\u00F2 che alungiare po' mia vita, / se non provede nanti che perita / s\u00EFa, che mi var\u00E0 poi lo pentere?\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/11/paragrafo/1/exprFrag1/423>	ns3:efChars	"Humils, forfaitz, repres e penedens versi 6-7 \u00ABque no gardetz cum soy forfaitz vas vos: / si\u00B7us plai, gardatz l'ops de m'ar- ma marrida\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/11/paragrafo/1/exprFrag1/425>	ns3:efChars	"Abbi piet\u00E0 di me, o sarai punita dopo la morte in una sorta di inferno degli amanti'" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/10/paragrafo/1/exprFrag1/401>	ns3:efChars	"Dolze d'amore amico, e' ve riscrivo 11 d'amor la mente cinta" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/3/paragrafo/1/exprFrag1/139>	ns3:efChars	"Gaia donna piacente e dilettosa 25 \u00ABAmor mi fa sovente tormentare\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/3/paragrafo/1/exprFrag1/137>	ns3:efChars	"Rinuccino, Tu che di guerra colpo nonn-atendi 9 \u00ABch\u00E9 contro a fino amor non val difesa\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/10/paragrafo/1/exprFrag1/400>	ns3:efChars	"Era l'aire sereno e lo bel tempo versi 5-6 Ben fusti zoia, tal che\u00B7mm'apparisti / e col novo color del tuo bel viso" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/49/paragrafo/2/exprFrag/739>	ns3:efChars	"I' SON ... GITO" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/11/paragrafo/1/exprFrag1/419>	ns3:efChars	"Io vidi li occhi versi 5-6 \u00ABe se non fosse che la donna rise, / i' parlerei di tal guisa doglioso\u00BB." .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/3/paragrafo/1/exprFrag1/136>	ns3:efChars	"Peroch\u00E9 s\u00E8te paragon di sagio 13-4 \u00ABfino amante non vincie per dire, / ma serve e tace\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/3/paragrafo/1/exprFrag1/135>	ns3:efChars	"motivo della resa davanti all'amore ricorre spesso nella lirica romanza" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/3/paragrafo/1/exprFrag/75>	ns3:efChars	"MERZEDE ... SOFFERENTE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/3/paragrafo/1/exprFrag/74>	ns3:efChars	"CHE 'NVERSO ... SOFFERENTE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/3/paragrafo/1/exprFrag/77>	ns3:efChars	"N'HAVE OMO PARTE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/3/paragrafo/1/exprFrag/76>	ns3:efChars	"BEN SERVIR" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/6/paragrafo/1/exprFrag1/280>	ns3:efChars	"Madonna, il fino amor versi 56-57 Ma voi pur s\u00E8te quella / che possedete i monti del valore" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/8/paragrafo/1/exprFrag1/306>	ns3:efChars	"Plazer e souhait provenzali" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/6/paragrafo/1/exprFrag1/293>	ns3:efChars	"Subbitamente Amor, con la sua fiaccola 71-5 die [alla donna] che 'l tardato don non \u00E8 laudabile; / e dopo tal notabile, / per ritornare a me ti mette a correre, / che tu sai ben, se stessi lungo termine, / mi troveresti facto escha di vermine" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/8/paragrafo/1/exprFrag1/308>	ns3:efChars	"\u00ABUna ricca rocca e forte manto / volesse Dio che monte ricco avesse\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/36/paragrafo/2/exprFrag1/1121>	ns3:efChars	"Bichilino, Pomerium, p. 69: \u00ABPeperit nobis vestrarum litterarum tenor materiem tristicie et doloris\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/47/paragrafo/2/exprFrag1/1633>	ns3:efChars	"Corona XLIX 2 \u00ABi' sono issuto e\u00B7sson di sua masnada\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/36/paragrafo/2/exprFrag1/1120>	ns3:efChars	"Gui d'Uissel be\u00B7m pesa de vos 9-13 \u00ABDompna Na Maria, tenssos / e tot cant cuiava laissar, / mas aoras non puosc estar / qu'ieu non chant als vostres somos. / E respon eu a la dompna breumen\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/47/paragrafo/2/exprFrag1/1632>	ns3:efChars	"Dino Frescobaldi, Morte avversara, poich'io son con- tento 77 \u00ABi' ho seguito Amor sott'una insegna\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/47/paragrafo/2/exprFrag1/1631>	ns3:efChars	"commento alle Sentenze di san Bonaventura: \u00ABoptime nominatur per hoc, quod dicitur liberum arbitrium, non uno nomine, sed composito, ut unum nomen respondeat rationi, et alterum voluntati\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/47/paragrafo/2/exprFrag1/1630>	ns3:efChars	"\u00ABNeque enim ad liberum arbitrium, quantum in se est, pertinet, aut ali- quando pertinuit, posse vel sapere, sed tantum velle: nec potentem facit creaturam, nec sapientem, sed tantum volentem\u00BB (VIII 24)" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/47/paragrafo/2/exprFrag1/1638>	ns3:efChars	"Monte, Lo nomo c'\u00E0', percontradio si mostra 14 \u00ABUno voler \u00E8 'n me che m\u00F2 m'adestra\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/36/paragrafo/2/exprFrag1/1125>	ns3:efChars	"I Cor 11, 10 \u00ABdebet mulier potestatem habere supra caput\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/47/paragrafo/2/exprFrag1/1637>	ns3:efChars	"Terenzio, Eunuchus 57-8 \u00ABquae res [Amor] in se neque consilium neque modum / habet ullum, eam consilio regere non potes\u00BB." .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/36/paragrafo/2/exprFrag1/1124>	ns3:efChars	"De virginibus velandis Tertulliano  \u00ABUbi enim gradum fiximus de apostoli absoluta definitione, omnem mulierem etiam omnis aetatis intellegendam, responderi ex diverso habebat, ergo a nativitate et a primo nomine aetatis virginem operiri oportere. Non ita est autem, sed ex quo intelligere se coeperit et sensum naturae suae intrare et de virginis exire et pati novum illud quod alterius aetatis est\u00BB (XI 2)" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/47/paragrafo/2/exprFrag1/1636>	ns3:efChars	"Meteorologica 370b 18-9 \u00ABcum autem flatus qui in nube erat, excretus alte- ri repercutitur, perinde ut cum ex lato in angustum adigitur ventus in portis viisque\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/9/paragrafo/1/exprFrag/148>	ns3:efChars	"VOLARE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/9/paragrafo/1/exprFrag/145>	ns3:efChars	"PER UNA ... ONORE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/36/paragrafo/2/exprFrag1/1123>	ns3:efChars	"Ars amatoria I 31 \u00ABEste procul, vittae tenues, insigne pudoris\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/47/paragrafo/2/exprFrag1/1635>	ns3:efChars	"Iacopo da Varazze, p. 476 (De letania maiori et minori): \u00ABEt ista dicitur esse ratio quare ecclesia campanas consuevit pulsare quando tempestates concitari videt, ut scilicet demones qui hoc faciunt tubas eterni regis audiant et sic territi fugiant et a tempe- statis concitatione quiescant\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/36/paragrafo/2/exprFrag1/1122>	ns3:efChars	"Tibullo (I VI 67- 8)" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/47/paragrafo/2/exprFrag1/1634>	ns3:efChars	"Dino del Garbo commentando Cavalcan- ti, \u00ABappetitus in quo habet esse amor est appetitus qui non est regu- latus a ratione, quia hic appetitus non insequitur iudicium rationis rectum et salvum\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/9/paragrafo/1/exprFrag/146>	ns3:efChars	"PORTARE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/9/paragrafo/1/exprFrag/149>	ns3:efChars	"UM\u00CCLE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/2/paragrafo/2/exprFrag/40>	ns3:efChars	"CHI ... AMADORE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/36/paragrafo/2/exprFrag1/1126>	ns3:efChars	"Uc de Saint-Circ, N'Ugo, vostre semblan digatz 17 \u00ABSegon la razon qe\u00B7m contatz\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/38/paragrafo/2/exprFrag1/1802>	ns3:efChars	"Guilhem de Montanhagol, Non estarai, per ome qe\u2219m casti 1-2 \u00ABNon estarai, per ome qe\u00B7m casti, / q'eu no\u00B7m do joi\u00BB." .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/9/paragrafo/1/exprFrag/151>	ns3:efChars	"DIR\u00D2 A ... MIA" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/9/paragrafo/1/exprFrag/152>	ns3:efChars	"PER CRESCER DISIRE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/38/paragrafo/2/exprFrag1/1803>	ns3:efChars	"Iac 2, 14 \u00ABQuid proderit fratres mei si fi- dem qui dicat se habere, opera autem non habeat?\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/9/paragrafo/1/exprFrag/150>	ns3:efChars	"SOTTILE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/9/paragrafo/1/exprFrag/155>	ns3:efChars	"PER LEGGIADRIA" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/9/paragrafo/1/exprFrag/156>	ns3:efChars	"ELLE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/9/paragrafo/1/exprFrag/153>	ns3:efChars	"CORONATA D'AMORE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/9/paragrafo/1/exprFrag/154>	ns3:efChars	"LE PAROLETTE ... BALLATA" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/8/paragrafo/1/exprFrag1/309>	ns3:efChars	"Ar' agues eu mil marcs de fin argen" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/6/paragrafo/1/exprFrag1/290>	ns3:efChars	"Contra lo meo volere (L 073) verso 46-47 Dunqua vostro valore / e mercede mi vaglia" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/6/paragrafo/1/exprFrag1/291>	ns3:efChars	"Domna, gencer que non sai dir 205-6 Sie\u00B7us play, rendetz me ma salut, / pus Amors m'a per vos vencut" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/6/paragrafo/1/exprFrag1/292>	ns3:efChars	"A quella amorosetta foresella versi 1-2 A quella amorosetta foresella / pass\u00F2 s\u00EC 'l core la vostra salute" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/8/paragrafo/1/exprFrag1/318>	ns3:efChars	"nave \u00ABsans voile et sans avirons\u00BB che custodisce il cadavere della sorella di Perceval e a bordo della quale sale Lancillotto: nave piena di tutti i \u00ABbonnes odours du monde\u00BB e \u00ABde toutes boines viandes\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/2/paragrafo/2/exprFrag/31>	ns3:efChars	"NON \u00C8 GIOCO" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/8/paragrafo/1/exprFrag1/317>	ns3:efChars	"(Tristano riccardiano, pp. 88-9)" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/2/paragrafo/2/exprFrag/30>	ns3:efChars	"MANTO/DI SCIENZA" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/2/paragrafo/2/exprFrag/33>	ns3:efChars	"PER VIA SAGGIA" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/8/paragrafo/1/exprFrag1/319>	ns3:efChars	"Mare amoroso, \u00ABsanza remi e sanza vela\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/2/paragrafo/2/exprFrag/32>	ns3:efChars	"SACCIATE ... MOCO" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/8/paragrafo/1/exprFrag1/314>	ns3:efChars	"\u00ABE se potesse avere una barchetta, / tal com' fu quella che don\u00F2 Merlino / a la va- lente donna d'Avalona, / ch'andassi sanza remi e sanza vela\u00BB (versi 212- 5)" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/2/paragrafo/2/exprFrag/35>	ns3:efChars	"POI PIACEVI" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/8/paragrafo/1/exprFrag1/313>	ns3:efChars	"\u00ABla nef de joie et de deport\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/2/paragrafo/2/exprFrag/34>	ns3:efChars	"VOCO" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/2/paragrafo/2/exprFrag/37>	ns3:efChars	"E IO ... FORE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/2/paragrafo/2/exprFrag/36>	ns3:efChars	"CORAGGIO" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/8/paragrafo/1/exprFrag1/310>	ns3:efChars	"Amor, eo chero mia donna in domino" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/47/paragrafo/2/exprFrag1/1626>	ns3:efChars	"Maestro Francesco, Molti l'Amore apellano d\u00EFetate 5 \u00ABche segnoreggia Amor la volontate\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/11/paragrafo/1/exprFrag1/404>	ns3:efChars	"Metamorfosi di Apuleio (X 3) \u00ABCausa omnis et origo praesentis doloris ... tute ipse est. Isti enim tui oculi per meos oculos ad intima de- lapsi praecordia meis medullis acerrimum commovent incendium. Ergo miserere tua causa pereuntis\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/47/paragrafo/2/exprFrag1/1625>	ns3:efChars	"Tommaso (ST I, qu. CXV 4), \u00ABnihil prohibet aliquem hominem per liberum arbitrium passionibus resistere\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/47/paragrafo/2/exprFrag1/1624>	ns3:efChars	"Abelardo, Theologia \u00ABSummi boni\u00BB II 6 \u00ABnon ideo cuncta ex necessitate proveniunt, ut scilicet humani pereat libertas arbitrii\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/8/paragrafo/1/exprFrag1/312>	ns3:efChars	"\u00ABA suon di trombe anzi che di corno, / vorria di fin'amor far una mostra / d'armati ca- valier, di pasqua un giorno, / e navicare sanza tiro d'ostra\u00BB (versi 1-4)" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/11/paragrafo/1/exprFrag1/406>	ns3:efChars	"avvio di Dino Frescobaldi, Deh, giovanetta, de' begli occhi tuoi verso 1" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/9/paragrafo/1/exprFrag/157>	ns3:efChars	"QUAL ... CANTER\u00C0" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/8/paragrafo/1/exprFrag1/311>	ns3:efChars	"\u00ABEt tout ami e\u00FCssent leur amies, / et si s'amaissent de cuer certain et vrai, / cascuns e\u00FCst son plaisir et cuer gay\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/11/paragrafo/1/exprFrag1/405>	ns3:efChars	"dal racconto di Giacobbe e di L\u00E0bano, in Gn 30, 37-9" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/9/paragrafo/1/exprFrag/158>	ns3:efChars	"CHE ... ONORE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/48/paragrafo/2/exprFrag/734>	ns3:efChars	"DEGNO ... PONTE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/36/paragrafo/2/exprFrag1/1117>	ns3:efChars	"Cecco Angiolieri, Non si disperin quelli de lo 'nferno 3 \u00ABel quale \u00E8 Cecco, ch'\u00E8 cos\u00EC chiamato\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/36/paragrafo/2/exprFrag1/1119>	ns3:efChars	"il joc partit di Guiraut Riquier, Aras s'esfors, N'Eve- yos, vostre sen 9-10 \u00ABD'est partimen, Guiraut Riquier, breumens / vos respondray\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/48/paragrafo/2/exprFrag/735>	ns3:efChars	"S'IO ... PLOIA" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/36/paragrafo/2/exprFrag1/1118>	ns3:efChars	"Bichilino, Pomerium, pp. 100-1: \u00ABEcce breviter respondemus ... Absque prolixitate percipite responsivam\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/2/paragrafo/2/exprFrag/39>	ns3:efChars	"CERTANAMENTE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/2/paragrafo/2/exprFrag/38>	ns3:efChars	"S\u00CC COME QUEI CH(E)" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/10/paragrafo/1/exprFrag1/384>	ns3:efChars	"Donna, se 'l prego 19-20 \u00ABDonna, Ragion d'Amor mi d\u00E0 speranza, / che voi se- rete ver' me s\u00EC gentile\u00BB." .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/25/paragrafo/1/exprFrag/332>	ns3:efChars	"OMOR" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/25/paragrafo/1/exprFrag/333>	ns3:efChars	"NIDO" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/8/paragrafo/1/exprFrag1/329>	ns3:efChars	"Amic Arver, d'una res vos deman verso 3 ce d'un talent e d'un cor son amdus" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/10/paragrafo/1/exprFrag1/383>	ns3:efChars	"Donna, vostr'adorne\u00E7e 25-30 \u00ABDona, lo gram save- re / ch'in vui regna chotanto / me d\u00E0 ferma creden\u00E7a / che del meo dolere / me dar\u00E0 \u00E7ogla e canto / la vostra chanoscen\u00E7a\u00BB in Memoriali bolognesi" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/10/paragrafo/1/exprFrag1/382>	ns3:efChars	"Don- na, vostre belleze 1-3 \u00ABDonna, vostre belleze, / c'avete, col bel viso, / m'hanno s\u00EC priso\u00BB." .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/8/paragrafo/1/exprFrag1/328>	ns3:efChars	"Nulha res a chantar no\u00B7m falh 17-8 \u00ABcar si s'encontron d'un voler / dui fin amic e d'un talan\u00BB;" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/8/paragrafo/1/exprFrag1/322>	ns3:efChars	"\u00ABEt puis entrerez dedans une nef que je vous feray adouber en laquelle vous ne doubterez riens, ne vent ne tempeste ne orage ... Si est faicte la nef en telle maniere que, de quelque coust\u00E9 que vous vouldrez, s'en yra ainsi que vous lui commanderez\u00BB (Floriant et Flo- rete, p. 94" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/8/paragrafo/1/exprFrag1/321>	ns3:efChars	"\u00ABli sages Mierlins quant il vivoit fist cele barge par sa grant soutili- te\u00BB (Prophesies, p. 329" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/25/paragrafo/1/exprFrag/330>	ns3:efChars	"LA TRUOVI" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/25/paragrafo/1/exprFrag/331>	ns3:efChars	"CORTONESE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/37/paragrafo/2/exprFrag/531>	ns3:efChars	"CHE QUE' ... N'ELICE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/37/paragrafo/2/exprFrag/532>	ns3:efChars	"N'ELICE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/25/paragrafo/1/exprFrag/827>	ns3:efChars	"CHI UDISSE ... GUIDO!:" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/25/paragrafo/1/exprFrag/828>	ns3:efChars	"NON LE VAL PERCH\u00C9" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/37/paragrafo/2/exprFrag/530>	ns3:efChars	"SENZA RADICE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/37/paragrafo/2/exprFrag/536>	ns3:efChars	"TALOR ... GITA" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/37/paragrafo/2/exprFrag/533>	ns3:efChars	"FRUTTO NO" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/37/paragrafo/2/exprFrag/535>	ns3:efChars	"GIOVANE DONNA" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/10/paragrafo/1/exprFrag1/389>	ns3:efChars	"Qui sap, sofrent, esperare 51-3 \u00ABE, pos tuit li ben estar / son en vos, ben es ma fes / qe\u00B7i degues esser mer- ces\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/37/paragrafo/2/exprFrag/534>	ns3:efChars	"PER\u00D2 CHE ... NATURA" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/10/paragrafo/1/exprFrag1/388>	ns3:efChars	"Ben an mort mi e lor 9-10 \u00ABqu'ieu non cre jes que merces aus faillir / lai on Dieus volc totz autres bes aizir\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/10/paragrafo/1/exprFrag1/385>	ns3:efChars	"O tu, che porti versi 1-2 O tu, che porti nelli occhi sovente / Amor" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/47/paragrafo/2/exprFrag/730>	ns3:efChars	"N'ADESTRA" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/2/paragrafo/2/exprFrag1/71>	ns3:efChars	"ars dictandi" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/10/paragrafo/1/exprFrag1/396>	ns3:efChars	"principium \u00E8 \u00ABid a quo aliquid procedit\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/6/paragrafo/1/exprFrag/130>	ns3:efChars	"CANZONE ... VAI" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/2/paragrafo/2/exprFrag1/72>	ns3:efChars	"Di vil matera 13 \u00ABqual che voi siate, egli \u00E8 d'un'altra gente\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/10/paragrafo/1/exprFrag1/395>	ns3:efChars	"Qui ve gran maleza faire 13-4 \u00ABe granz cobeitatz entieira / li fai conpaignia\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/10/paragrafo/1/exprFrag1/394>	ns3:efChars	"Ispesso di gioia nascie ed inconinza 51-2 \u00ABfallire non poria / merz\u00E9, ove son tute altre vertute\u00BB." .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/2/paragrafo/2/exprFrag1/73>	ns3:efChars	"amico" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/10/paragrafo/1/exprFrag1/393>	ns3:efChars	"Madonna, io nonn-audivi dicer mai 9-11 \u00ABch\u00E9\u00B7ll\u00E0 dov'\u00E8 bieltate e piacimento, / pregio ed onore e modo di sa- vere, / ben de' merz\u00E9 trovarvi umil talento\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/2/paragrafo/2/exprFrag1/74>	ns3:efChars	"Iob 29, 14 \u00ABIustitia indutus sum, et vestivit me sicut vestimento\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/8/paragrafo/1/exprFrag1/338>	ns3:efChars	"l'incipit di Guido Orlandi Ragionando d'amore" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/10/paragrafo/1/exprFrag1/392>	ns3:efChars	"Tan aut me creis Amors en ferm talan 26-8 \u00ABlai on es beutatz et pretz valens / non deu faillir merces ni chauzimens / ni guizardos de fin joi, ses duptansa\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/25/paragrafo/1/exprFrag/325>	ns3:efChars	"CHI UDISSE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/2/paragrafo/2/exprFrag1/75>	ns3:efChars	"Contra falsos XLVI 122 \u00ABSic ergo omnis virtus vestis est anime\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/8/paragrafo/1/exprFrag1/337>	ns3:efChars	"En aquest son gai e leugier si legga: \u00ABla contessa valenta, / qar prez li es daz / et autriaz, / tant qe val las meilhors trenta\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/25/paragrafo/1/exprFrag/326>	ns3:efChars	"BICCI VOCATO FORESE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/10/paragrafo/1/exprFrag1/391>	ns3:efChars	"Quan si cargo\u00B7l ram de vert fueill 43-4 \u00ABmas en vos es tot aisso [tutte le doti che il poeta ha elencato] ab joven, / esser hi deu merces, ab chauzi- men [con indulgenza]\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/2/paragrafo/2/exprFrag1/76>	ns3:efChars	"mantiauz d'onour" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/25/paragrafo/1/exprFrag/327>	ns3:efChars	"POTREBBE ... VERNATA" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/10/paragrafo/1/exprFrag1/390>	ns3:efChars	"Los mals d'Amor ai eu ben totz apres 31-3 \u00ABque so non cuich que ges esser pogues / que lai on es totz autres bes pausatz / que no\u00B7i degues esser Humilitatz\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/2/paragrafo/2/exprFrag1/77>	ns3:efChars	"De coralmente amar 9 \u00ABCh\u00E9 manto n'\u00F2\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/8/paragrafo/1/exprFrag1/339>	ns3:efChars	"Bilt\u00E0 di donna 3 \u00ABcantar d'augelli e ragionar d'amore\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/2/paragrafo/2/exprFrag1/88>	ns3:efChars	"Bono Giamboni, Libro LXI 3 \u00ABs\u00EC come quella che ben li sapea\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/25/paragrafo/1/exprFrag/328>	ns3:efChars	"CRISTALLO" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/2/paragrafo/2/exprFrag1/78>	ns3:efChars	"Novellino XLI 10 \u00ABQuelli cavalieri dissero: \"Questo non \u00E8 giuoco\"\u00BB." .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/2/paragrafo/2/exprFrag1/79>	ns3:efChars	"Vogl'e ragion mi convit'e rechere 1-4 \u00ABVogl'e ragion mi convit'e rechere / in voi laudar, valente e car valore; / ma picciul mio e gran vostro savere / e troppo umilit\u00E0 mi fa temere\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/8/paragrafo/1/exprFrag1/336>	ns3:efChars	"Quant vient en mai que l'on dit as lons jors verso 21" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/8/paragrafo/1/exprFrag1/335>	ns3:efChars	"Can chai la fueilla 41-4 \u00ABTan par es genta / sela que\u00B7m te joios / las genzors trenta / venz de belas faissos\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/8/paragrafo/1/exprFrag1/332>	ns3:efChars	"Dante, un sospiro messagger del core 6" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/8/paragrafo/1/exprFrag1/330>	ns3:efChars	"De coniuratione Catilinae (XX), idem velle atque idem nolle, ea demum firma amicitia est." .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/47/paragrafo/2/exprFrag1/1816>	ns3:efChars	"Nasone, nel quarto libro delle Metamorfosi" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/38/paragrafo/1/exprFrag/537>	ns3:efChars	"PERCH'IO ... RICOLTO" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/47/paragrafo/2/exprFrag1/1817>	ns3:efChars	"Rimedii dei casi che dal famosissimo dei filosofi, Seneca" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/25/paragrafo/1/exprFrag/329>	ns3:efChars	"DI MEZZO ... INFREDDATA" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/37/paragrafo/1/exprFrag1/1800>	ns3:efChars	"(cfr. Uc Brunenc, Ab plazer receup et acuoill 24 \u00ABc'Amors asol [mantiene] so qu'ella pliu [promette]\u00BB)" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/37/paragrafo/1/exprFrag1/1801>	ns3:efChars	"l'immagine di Amore fedifrago si trova invece per esempio in Cino (?), Cori gentili e serventi d'amore" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/10/paragrafo/1/exprFrag1/399>	ns3:efChars	"Dante da Maiano (?), Tutto ch'eo poco vaglia 57 conforto el meo coraggio (Bettarini)" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/10/paragrafo/1/exprFrag1/398>	ns3:efChars	"In un gravoso 8-9 \u00ABconforto mia speranza, / pensando che s'avanza\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/2/paragrafo/2/exprFrag1/83>	ns3:efChars	"Di ci\u00F2 ch'audivi 9 \u00ABe poi vi piace ch'eo vi parli, bella\u00BB:" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/2/paragrafo/2/exprFrag1/84>	ns3:efChars	"Jehan de Grieviler, sage 10-1 \u00ABmon corage / vous en dirai\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/2/paragrafo/2/exprFrag1/85>	ns3:efChars	"Di ci\u00F2 ch'audivi 6 \u00ABma per un cento di menzogna fore\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/2/paragrafo/2/exprFrag1/86>	ns3:efChars	"Onkes jor de ma vie 15-6 \u00ABcome cil qui n'avoie / nule fole pansee\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/6/paragrafo/1/exprFrag/122>	ns3:efChars	"TUTTI ... PROVI" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/2/paragrafo/2/exprFrag1/87>	ns3:efChars	"Clig\u00E8s 4268-9 \u00ABdroiz est qu'a vos congi\u00E9 preigne / come a cele qui je sui touz\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/6/paragrafo/1/exprFrag/121>	ns3:efChars	"L'ATTENDER IO NON POSSO" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/6/paragrafo/1/exprFrag/120>	ns3:efChars	"SAPPIATE CHE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/2/paragrafo/2/exprFrag1/89>	ns3:efChars	"Phelipe, je vos demant 9 \u00ABSachiez certainement\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/8/paragrafo/1/exprFrag1/340>	ns3:efChars	"Di maggio s\u00EC vi do molti cavagli 13-4 \u00ABbaciarsi nella bocca e nelle guance; / d'amor e di goder vi si ragioni\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/25/paragrafo/1/exprFrag1/1795>	ns3:efChars	"Monte, Eo nom son quelli che chera perdono 8 \u00ABE non mi val perch'io sto pur gechito\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/47/paragrafo/2/exprFrag/841>	ns3:efChars	"SE ... STANCO" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/2/capitolo/13/paragrafo/1/exprFrag/894>	ns3:efChars	"PENSIER ... PENSARE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/2/capitolo/13/paragrafo/1/exprFrag/896>	ns3:efChars	"L'UNO ... AMARE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/2/capitolo/13/paragrafo/1/exprFrag/895>	ns3:efChars	"COMMUNEMENTE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/2/capitolo/13/paragrafo/1/exprFrag/897>	ns3:efChars	"LA BELLA ... DONATO" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/2/capitolo/13/paragrafo/1/exprFrag/898>	ns3:efChars	"ED IO 'L CONSENTO" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/6/paragrafo/1/exprFrag/126>	ns3:efChars	"DARMI ... OSA" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/6/paragrafo/1/exprFrag/125>	ns3:efChars	"QUELLE COSE ... VOGLIO" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/6/paragrafo/1/exprFrag/124>	ns3:efChars	"PER VOI SERVIR" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/6/paragrafo/1/exprFrag/123>	ns3:efChars	"E VOI ... AMO" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/6/paragrafo/1/exprFrag/129>	ns3:efChars	"DENTRO AL COR" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/2/paragrafo/2/exprFrag1/80>	ns3:efChars	"Venuto m'\u00E8 'n talento di savere 7-9 \u00ABMa forse che m'inganna lo savere / ch'e' n'aggio poco, avengna che m'\u00E8 danno. / Voi ne dimando, che n'avete assai\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/37/paragrafo/1/exprFrag/832>	ns3:efChars	"DISDICE ... CI\u00D2 CHE PROMETTE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/6/paragrafo/1/exprFrag/128>	ns3:efChars	"DUNQUE ... MOVA" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/2/paragrafo/2/exprFrag1/81>	ns3:efChars	"S\u00EC come 'l mare (L 338) 16 \u00ABaudo ch'\u00E8 medicina in loco saggio\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/6/paragrafo/1/exprFrag/127>	ns3:efChars	"UMANO" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/2/paragrafo/2/exprFrag1/82>	ns3:efChars	"co per 'capo'" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/6/paragrafo/1/exprFrag/110>	ns3:efChars	"LUNGAMENTE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/47/paragrafo/2/exprFrag/729>	ns3:efChars	"CONSIGLIO ... BALESTRA" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/47/paragrafo/2/exprFrag/724>	ns3:efChars	"IO SONO STATO ... STANCO" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/6/paragrafo/1/exprFrag/119>	ns3:efChars	"SE DIR VOLESTE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/47/paragrafo/2/exprFrag/725>	ns3:efChars	"SONO STATO ... INSIEME" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/47/paragrafo/2/exprFrag/728>	ns3:efChars	"ESSER ... SCEME" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/47/paragrafo/2/exprFrag/727>	ns3:efChars	"FA COME ... SCEME" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/6/paragrafo/1/exprFrag/114>	ns3:efChars	"ONOR" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/3/paragrafo/1/exprFrag1/154>	ns3:efChars	"Poi no mi val merz\u00E9 n\u00E9 ben servire" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/6/paragrafo/1/exprFrag/113>	ns3:efChars	"BUON ... DIFENDE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/6/paragrafo/1/exprFrag/112>	ns3:efChars	"SOL ... ATTENDE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/2/paragrafo/2/exprFrag1/90>	ns3:efChars	"Baudo\u00FFn, il sunt dui amant 9 \u00ABSire, saichiez certeinnement\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/6/paragrafo/1/exprFrag/111>	ns3:efChars	"PIACCIAVI MANDAR" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/3/paragrafo/1/exprFrag1/155>	ns3:efChars	"Qualunque m'adimanda 13 \u00ABcui trova bon, [Amore] di s\u00E9 li dona parte\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/3/paragrafo/1/exprFrag1/150>	ns3:efChars	"Gentil madonna, la vert\u00F9 d'amore 13 \u00ABBen me cognosco eo non sufficiente\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/6/paragrafo/1/exprFrag/118>	ns3:efChars	"PER ... CARI" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/2/paragrafo/2/exprFrag1/91>	ns3:efChars	"En estiu, qan crida\u00B7l iais 27-8 \u00ABmas d'aisso es grans pechatz ['disgrazia'] / qu'eu am e non sui amatz\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/37/paragrafo/2/exprFrag/529>	ns3:efChars	"I' HO VEDUTO GI\u00C0" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/6/paragrafo/1/exprFrag/117>	ns3:efChars	"L\u00C0 ... S\u00C8TE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/2/paragrafo/2/exprFrag1/92>	ns3:efChars	"Bernart de Ventadorn, A! tantas bonas chansos 11-2 \u00ABque m'estara mal e laih / c'ames et amatz no fos\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/6/paragrafo/1/exprFrag/116>	ns3:efChars	"LA SUA ... INCENDE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/2/paragrafo/2/exprFrag1/93>	ns3:efChars	"Lamentomi 3-4 \u00ABamo for misura / una donna da cui non sono amato\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/3/paragrafo/1/exprFrag1/152>	ns3:efChars	"\u00ABAmor m'aucide, n\u00E9 da lui difesa / non trovo mai che di merz\u00E9 chiamare\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/3/paragrafo/1/exprFrag1/151>	ns3:efChars	"Cortesamen mou en mon cor mesclanza 15-6 \u00ABc'Amor no venz menaza ni bobanz, / mas gens servirs e precs e bona fes\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/6/paragrafo/1/exprFrag/115>	ns3:efChars	"E CERTO" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/1/paragrafo/1/exprFrag1/42>	ns3:efChars	"\u00ABQuid faciam? Referam que fecimus? Hic pudor obstat, / ipsaque ne referam nostra puella vetat\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/25/paragrafo/2/exprFrag/338>	ns3:efChars	"LEGATO ... SALAMON" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/1/paragrafo/1/exprFrag1/41>	ns3:efChars	"Chr\u00E9tien de Troyes, Clig\u00E8s 6260-2 \u00ABNe ja plus ne m'en demandez, / mais n'est chose que li uns voille / que li autres ne s'i acuille\u00BB; e Le chevalier de la charrete 4690 \u00ABMez tot jorz iert par moi te\u00FCe\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/25/paragrafo/2/exprFrag/337>	ns3:efChars	"UDITE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/25/paragrafo/2/exprFrag/335>	ns3:efChars	"L'ALTRA NOTTE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/1/paragrafo/1/exprFrag1/40>	ns3:efChars	"Ogan, ab freg que fazia 19-20 \u00ABSaludiey\u00B7l, ez elha mi, / la genta\u00BB." .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/25/paragrafo/2/exprFrag/336>	ns3:efChars	"INCONTANENTE ... D\u00CC" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/25/paragrafo/2/exprFrag/334>	ns3:efChars	"L'ALTRA NOTTE ... MI' VIAGGIO" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/1/paragrafo/1/exprFrag1/38>	ns3:efChars	"Oriolanz, en haut solier 45 \u00ABbaisier et acoler l'a pris\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/25/paragrafo/1/exprFrag1/740>	ns3:efChars	"Flos medicinae scholae Salerni 1829-30 \u00ABvis senis est fragilis, que debilis est calor ejus, / humo- res dat hepar gelidos, tardos et aquosos\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/38/paragrafo/2/exprFrag1/1162>	ns3:efChars	"Inghilfredi, Greve puot'on piacere a tutta gente 51-3 \u00ABTant'ha lo mal lo ben da s\u00E9 distinto, / ca chi pi\u00F9 falla di lodo \u00E0 corona / e chi ben opra di lui mal si sona\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/1/paragrafo/1/exprFrag1/37>	ns3:efChars	"Erec 4040-1 \u00ABMais Erec de tant se franchist, / por ce que cil desar- mez iere\u00BB ('Ma Erec si comport\u00F2 generosamente / perch\u00E9 quello era disarmato')" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/25/paragrafo/1/exprFrag1/741>	ns3:efChars	"De retardatione accidentium senectutis di Ruggero Ba- cone: \u00ABSenectus et senii accidentia proveniunt ex debilitate caloris naturalis, et debilitatis caloris naturalis provenit ex dissolutione na- turalis humiditatis et augmento extranee\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/38/paragrafo/2/exprFrag1/1163>	ns3:efChars	"Guiraut Riquier, Karitatz ez amors e fes 11-2 \u00ABque\u00B7l mals es plazens e privatz, / tant que per paucx es faitz le bes\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/1/paragrafo/1/exprFrag1/36>	ns3:efChars	"Legenda aurea, p. 662: \u00ABCum super terram petrosam in sola camisia diutius tractus fuisset\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/38/paragrafo/2/exprFrag1/1164>	ns3:efChars	"Guittone, 1-3 \u00ABIddio, / riccore, amore 'n fio / ... ha voi non poco dato\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/1/paragrafo/1/exprFrag1/35>	ns3:efChars	"Flamenca 6128-30 \u00ABBel sengner, / veus m'aici ben a vostra guisa / tota nudeta en camisa\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/38/paragrafo/2/exprFrag1/1165>	ns3:efChars	"cap. LII De resurrectione Domini" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/25/paragrafo/1/exprFrag1/744>	ns3:efChars	"\u00ABquod si [superfluitates \u2013 cio\u00E8 le eccedenze del cibo] neque coitu neque pollutione exeant ... in vasis suis calefiunt et febres faciunt\u00BB (Costantino Africano, Pantegni, p. 25r)." .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/1/paragrafo/1/exprFrag1/34>	ns3:efChars	"Bel acueil \u00E8 uno dei personaggi del Roman de la Rose" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/1/paragrafo/1/exprFrag1/33>	ns3:efChars	"Amors, rics fora s'ieu vis 43 \u00ABde belh aculhimen\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/38/paragrafo/2/exprFrag1/1167>	ns3:efChars	"\u00ABPax tibi cum omnibus filiis tuis, iustis meis\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/1/paragrafo/1/exprFrag1/32>	ns3:efChars	"Dona, la genser qu'om veya 2 \u00ABde belh aculhimen\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/25/paragrafo/1/exprFrag1/742>	ns3:efChars	"Roman de la Rose 405-6 \u00ABCes vieilles genz ont tost froidure, / bien savez que c'est lor nature\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/25/paragrafo/1/exprFrag1/743>	ns3:efChars	"\u00ABSed quia magis ledatur si abstineat omnino a coitu vel vir vel mu- lier. Dico quod mulier, quia per coitum fit de ipsis multa expurga- tio superfluitatum, etiam sperma ipsius est impurius quam sperma virorum, et citius convertitur in venenosam materiam, unde incur- runt multas egritudines\u00BB (Petrus de Sancto Floro, Concordanciae, p. 30)" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/1/paragrafo/1/exprFrag1/31>	ns3:efChars	"\u00ABCoronam accipere vel habere: gaudium\u00BB (Libro dei sogni di Rasis)" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/38/paragrafo/2/exprFrag1/1160>	ns3:efChars	"Is 14, 13 \u00ABQui dicebas in corde tuo: \"in caelum conscen- dam, super astra Dei exaltabo solium meum\"\u00BB (parla Lucifero)" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/1/paragrafo/1/exprFrag1/39>	ns3:efChars	"L'autrier trobey la bergeira d'antan 2 \u00ABSaludei la, e respos mi la bella\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/38/paragrafo/2/exprFrag1/1161>	ns3:efChars	"Am 6, 3 \u00ABqui separati estis in diem malum, et adpropinquatis solio ini- quitatis\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/37/paragrafo/2/exprFrag1/1144>	ns3:efChars	"Lemmo Orlandi (Fera cagione e dura 59-60) \u2013 \u00ABdi vana donna amare, / gioven trop- po di tenpo e di savere\u00BB." .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/37/paragrafo/2/exprFrag1/1145>	ns3:efChars	"Anzi ch'Amore ne la mente guidi 1-3 \u00ABAnzi ch'Amore ne la mente guidi / donna, ch'\u00E8 poi del core ucciditrice, / conviensi dire a l'om: \"Non sei fenice\"\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/37/paragrafo/2/exprFrag1/1142>	ns3:efChars	"Arnaut Daniel, Lo ferm voler ch'el cor m'intra 25 \u00ABPos flori la secha verja\u00BB." .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/37/paragrafo/2/exprFrag1/1143>	ns3:efChars	"Dino Frescobaldi, Morte avversara, poich'io son contento 67 \u00ABNatura lo mi contradice\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/37/paragrafo/2/exprFrag1/1140>	ns3:efChars	"Cicerone, De senectute XV 51 \u00AB[terra] elicit herbescentem ex eo [semine] viriditatem\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/1/paragrafo/1/exprFrag1/30>	ns3:efChars	"L'autre jour je chevachoie 10-2 \u00ABtres douce compaignete, / doneis moi vostre chaipelet, / donneiz moi vostre chaipelet\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/38/paragrafo/2/exprFrag1/1158>	ns3:efChars	"Rm 3, 12 \u00ABNon est qui faciat bonum, non est usque ad unum\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/37/paragrafo/2/exprFrag1/1141>	ns3:efChars	"Nm 17, 8 il bastone di Aronne, il prescelto dal Signore, fiorisce e d\u00E0 frutti: Mos\u00E8 \u00ABinvenit germinasse virgam Aaron in domo Levi, et turgentibus gemmis eruperant flores\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/38/paragrafo/2/exprFrag1/1159>	ns3:efChars	"\u00AB\u00E8 stile ciniano, se si pensa al contraro che 'l valore ... del sonetto O voi che siete voce\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/25/paragrafo/1/exprFrag1/734>	ns3:efChars	"Cecco d'Ascoli (Acerba III XVIII 3265-6 \u00ABNasce nell'alpe del settentrione / cristallo fatto dell'antica neve\u00BB)" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/25/paragrafo/1/exprFrag1/735>	ns3:efChars	"Dolce coninzamento 39-40 \u00ABtant'\u00E8 di mal usaggio / che di stat'\u00E0 gelore\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/25/paragrafo/1/exprFrag1/736>	ns3:efChars	"Rustico, Io fo ben boto a Dio 5 \u00ABNon vedi che di mezzo luglio tosse?\u00BB." .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/25/paragrafo/1/exprFrag1/739>	ns3:efChars	"(Maestro Mauro, Regulae urinarum, in De Renzi 1852-59, III, p. 8: \u00ABflegma aliquando habundat cum febre\u00BB)" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/1/paragrafo/1/exprFrag1/26>	ns3:efChars	"Dollioso mi part\u00ECo e for racordato 12-3 \u00ABMer\u00E7\u00E9 kero ad ella ke m'\u00E0 e[n] ballia / Ke la kirlanda me deia largire\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/1/paragrafo/1/exprFrag1/25>	ns3:efChars	"grazir" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/1/paragrafo/1/exprFrag1/24>	ns3:efChars	"Donna, l'amor mi sforza 43-4 \u00ABDonqua si d\u00E9 gradire / di me, che voglio ben fare\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/1/paragrafo/1/exprFrag1/23>	ns3:efChars	"bella faisso" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/1/paragrafo/1/exprFrag1/22>	ns3:efChars	"bella faisso" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/1/paragrafo/1/exprFrag1/21>	ns3:efChars	"bella faisso" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/49/paragrafo/2/exprFrag1/1653>	ns3:efChars	"Cino a Cavalcanti, Qua' son le cose vostre 12-3 \u00ABma sono un uom cotal di basso 'ngegno / che vo piangendo\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/25/paragrafo/1/exprFrag1/732>	ns3:efChars	"\u00ABSimonem qui vocatur Petrus\u00BB (Mt 4, 18)." .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/49/paragrafo/2/exprFrag1/1654>	ns3:efChars	"Cino, Io che nel tempo reo 7-8 \u00AB[la morte] i miseri com'eo / sempre disdegna\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/25/paragrafo/1/exprFrag1/733>	ns3:efChars	"\u00ABccc cavalieri ... ch'erano vernati in Maremma\u00BB (Villani)" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/1/paragrafo/1/exprFrag1/20>	ns3:efChars	"\u00ABper\u00F2 ven faccio sentenz\u00EFatore\u00BB (Solicitando 14)" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/38/paragrafo/2/exprFrag1/1156>	ns3:efChars	"Raimbaut de Beljoc, A penre m'er lo conort del salvatge 24 \u00ABPrez? E quil vol? Eu non sai ar on sia\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/49/paragrafo/2/exprFrag1/1656>	ns3:efChars	"Forese Donati, L'altra notte 3" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/25/paragrafo/1/exprFrag1/731>	ns3:efChars	"\u00ABIesus qui vocatur Christus\u00BB Mt 1, 16" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/38/paragrafo/2/exprFrag1/1157>	ns3:efChars	"Iacopone, L'omo fo creato vert\u00FCoso 220-6: \u00ABalbergane, c\u00E0 simo de tua sorte\u00BB, dicono le Beatitudini a Dio, e Dio risponde: \u00ABnon se trov\u00F2 null'omo anco- ra degno / d'albergare s\u00EC nobele tesaro\u00BB." .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/1/paragrafo/1/exprFrag1/4>	ns3:efChars	"\u00ABVostra vis\u00EFone, diteme, foe / che donna una a mirabil fazione / porgea voi un falcone, / ci\u00F2e che 'n pi\u00F9 guise l'omo intender pu\u00F2e\u00BB Lettere XII 17-20" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/1/paragrafo/1/exprFrag1/6>	ns3:efChars	"Roman de la Rose 18-20 \u00ABli plusor songent de nuiz / maintes choses covertement / que l'en voit puis apertement\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/2/capitolo/13/paragrafo/1/exprFrag1/1912>	ns3:efChars	"De las serors d'En Guiran 6 \u00ABq'eu n'estau en consire\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/2/capitolo/13/paragrafo/1/exprFrag1/1914>	ns3:efChars	"Gianni Alfani, De la mia donna 28-30 \u00ABch'Amor, la sua mer- c\u00E9, mi dice ch'io / non le tema mostrare / quella ferita dond'i' vo do- lente\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/2/capitolo/13/paragrafo/1/exprFrag1/1913>	ns3:efChars	"Novellino LXIII 5 \u00ABe diceano comunemente che 'l voleano impendere\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/1/paragrafo/1/exprFrag1/28>	ns3:efChars	"Jeu de Robin 175-6 \u00ABRobin, veus tu que je le [la corona di fiori] meche / seur ton chief par amourete?\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/2/capitolo/13/paragrafo/1/exprFrag1/1916>	ns3:efChars	"Iacopo Mo- stacci, Solicitando un poco meo savere 7 \u00ABlo voglio consentire\u00BB);" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/1/paragrafo/1/exprFrag1/27>	ns3:efChars	"(Reggimento, pp. 38-9): \u00ABPo' con una ghirlanda ch'avea in testa / me fe' legare\u00BB (12-3)" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/2/capitolo/13/paragrafo/1/exprFrag1/1915>	ns3:efChars	"Guilhem de Montanhagol, Nulhs hom no val ni deu esser prezatz 21 \u00ABde la bella a cui me sui donatz\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/25/paragrafo/2/exprFrag1/1797>	ns3:efChars	"\u00ABcompiere il viaggio il quale avea cominciato\u00BB (Bibbia volgarizzata, nel corpus TLIO)" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/37/paragrafo/1/exprFrag1/1127>	ns3:efChars	"Rigaut de Berbezilh e alla sua canzone Atressi con l'orifanz, in cui si legge: \u00ABe s'ieu pogues contrafar / fenis\u00BB (36-7)" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/37/paragrafo/1/exprFrag1/1129>	ns3:efChars	"Novelle non di veritade ignude Cino chiede a un ignoto corrispondente (Dante?) \u00ABcome si dee mutar lo scuro in verde\u00BB (14)" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/37/paragrafo/1/exprFrag1/1128>	ns3:efChars	"n. LXIV del Novellino: Altress\u00EC come il leofante" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/38/paragrafo/1/exprFrag/538>	ns3:efChars	"PERCH'IO ... RAGIONI" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/38/paragrafo/1/exprFrag/539>	ns3:efChars	"SIGNORE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/1/paragrafo/1/exprFrag1/14>	ns3:efChars	"Vostra quistione 6 \u00ABLo mio proveder di tal loco saggio\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/37/paragrafo/1/exprFrag1/1131>	ns3:efChars	"Molte fiate Amor, quando mi desta, afferma che Amore gli porta nell'immaginazione una donna \u00ABdogliosa, in scura vesta\u00BB (5)" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/1/paragrafo/1/exprFrag1/13>	ns3:efChars	"\u00ABFatigatus, modicum sub frondosa pinu quievi et cepi firmiter dormire. Cum autem sic quiescerem, ecce comparuit virgo speciosissima ... [quae] me suaviter strinxit et suis rubentibus labellis mea suavius comprimens contulit michi basia ineffabilia\u00BB, ecc.; dopodich\u00E9 l'amante chiede all'amata di spiegargli il sogno e l'amata esegue, anzi, d\u00E0 appuntamento all'amante in un prato, \u00ABquoniam ibi proposui vobis explanare sompnium et referre plurima que litteris non audeo annotare\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/37/paragrafo/1/exprFrag1/1130>	ns3:efChars	"Amico, s'egualmente mi ricange dichiara di morire \u00ABper quella oscura che pur piange, / la qual velata in un amanto negro / vien ne la mente e lagrimando tange\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/37/paragrafo/1/exprFrag1/1133>	ns3:efChars	"Monte, Ai, Deo merz\u00E9, che fia di me, Amore 14 \u00ABMa ben vor\u00EFa contrafar fenice\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/1/paragrafo/1/exprFrag1/12>	ns3:efChars	"3449-50 \u00ABE ben sol aisso avenir / qu'on somne segon son desir / quan s'adorm sus el pensamen\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/11/paragrafo/1/exprFrag/182>	ns3:efChars	"MILLE ... DOLORE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/37/paragrafo/1/exprFrag1/1132>	ns3:efChars	"Guittone, Spietata donna 5-6 \u00ABche lo tuo fero orgoglio no m'ofenda / s'eo ti riguardo, che con el m'aucidi!\u00BB." .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/11/paragrafo/1/exprFrag/181>	ns3:efChars	"DEH NON GUARDARE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/38/paragrafo/1/exprFrag/543>	ns3:efChars	"RIVOLTO" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/11/paragrafo/1/exprFrag/180>	ns3:efChars	"MI RIDI" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/37/paragrafo/1/exprFrag1/1134>	ns3:efChars	"Cino, Anzi ch'Amore ne la mente guidi 1-3 \u00ABAnzi ch'Amore ne la mente guidi / donna, ch'\u00E8 poi del core ucciditrice, / conviensi dire a l'om: \"Non sei fenice\"\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/38/paragrafo/1/exprFrag/544>	ns3:efChars	"DIRI" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/38/paragrafo/1/exprFrag/541>	ns3:efChars	"DONNA ... VOLTO" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/37/paragrafo/1/exprFrag1/1136>	ns3:efChars	"Noffo, I' veggio star sul canto de la nave 9-11 \u00ABOr che far\u00F2? Verr\u00F2 io poi avanti? / O\u00B7ttorner\u00F2 come dice l'Amore? / Consigliatemi\u00BB;" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/38/paragrafo/1/exprFrag/542>	ns3:efChars	"AH ... RICOLTO" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/25/paragrafo/2/exprFrag1/746>	ns3:efChars	"Monte, Aim\u00E8 lasso, perch\u00E9 a fighura d'omo 143-4 \u00ABgi\u00E0 f\u00F4ra a le fosse / lo corpo morto\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/25/paragrafo/2/exprFrag1/745>	ns3:efChars	"ST III 84,3 \"nam peccata sunt quaedam vinculam, secundum illud Proverb. 5: 'Iniquitates suae capiunt impium et funibus peccatorum suorum quisque constringitur'\"\u00BB." .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/25/paragrafo/2/exprFrag1/747>	ns3:efChars	"Per s\u00EC gran somma ho 'mpegnate risa 9 \u00ABl'altro giorno cos\u00EC mi parve in sogno\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/38/paragrafo/1/exprFrag/540>	ns3:efChars	"SE ... DONI" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/25/paragrafo/2/exprFrag1/1796>	ns3:efChars	"\u00ABa modo di pellegrino, che si studia di compiere il suo viaggio\u00BB (Seneca volgarizzato)" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/25/paragrafo/3/exprFrag1/754>	ns3:efChars	"\u00ABa modo di pellegrino, che si studia di compiere il suo viaggio\u00BB (Seneca volgarizzato)" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/1/paragrafo/1/exprFrag1/19>	ns3:efChars	"Controv. VII VI 22 - sententiam trahere" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/1/paragrafo/1/exprFrag1/18>	ns3:efChars	"vesion che al v. 15 \u00E8 chiamata appunto songe: \u00ABpour douner au songe conclusion\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/1/paragrafo/1/exprFrag1/15>	ns3:efChars	"Ser Bello 9-10 \u00ABdir\u00F2, per vostro dubio diclarare, / s\u00EC come pare ala mia proveden\u00E7a\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/7/paragrafo/1/exprFrag/134>	ns3:efChars	"DICO BEN" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/7/paragrafo/1/exprFrag/133>	ns3:efChars	"SED ELLI / NON S'ACCECASSER" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/7/paragrafo/1/exprFrag/135>	ns3:efChars	"EO STESSO LI UCCIDR\u00D2" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/25/paragrafo/2/exprFrag1/748>	ns3:efChars	"\u00ABencontenente ch'eo fui ionto\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/25/paragrafo/2/exprFrag/829>	ns3:efChars	"COMPIE' MI' V\u00CFAGGIO" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/7/paragrafo/1/exprFrag/132>	ns3:efChars	"NON ... MIEI" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/7/paragrafo/1/exprFrag/131>	ns3:efChars	"NON MI ... SCANOSCENTI" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/38/paragrafo/2/exprFrag/549>	ns3:efChars	"NON RISPONDE AL FIO" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/38/paragrafo/2/exprFrag/548>	ns3:efChars	"DEL CONTRARIO ... TRONI" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/11/paragrafo/1/exprFrag/172>	ns3:efChars	"(I)N OMBRA D'AMORE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/11/paragrafo/1/exprFrag/171>	ns3:efChars	"V\u00CFOLETTA" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/25/paragrafo/2/exprFrag1/750>	ns3:efChars	"Era tutta soletta 41-2 \u00ABsentendomi legato / col nodo Salamone\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/38/paragrafo/2/exprFrag/546>	ns3:efChars	"ALBERGO" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/11/paragrafo/1/exprFrag/170>	ns3:efChars	"DEH, V\u00CFOLETTA ... DOLORE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/38/paragrafo/2/exprFrag/547>	ns3:efChars	"DA ... OBLIO" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/38/paragrafo/2/exprFrag/545>	ns3:efChars	"I' ... LO BEN" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/25/paragrafo/2/exprFrag/339>	ns3:efChars	"MI SEGNA'" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/25/paragrafo/3/exprFrag1/756>	ns3:efChars	"Ugo Primate nella sua invettiva contro Abelardo" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/11/paragrafo/1/exprFrag/179>	ns3:efChars	"(I)N PARTE ... DOVE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/11/paragrafo/1/exprFrag/178>	ns3:efChars	"SPIRITO COCENTE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/11/paragrafo/1/exprFrag/177>	ns3:efChars	"FOCO ... VIDI" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/11/paragrafo/1/exprFrag/176>	ns3:efChars	"FORMA ... UMANA" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/25/paragrafo/2/exprFrag1/753>	ns3:efChars	"Agostino, De sermone Domi- ni in monte II V 18 \u00ABcum ad orationem stamus, ad orientem convertimur, unde coelum surgit\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/11/paragrafo/1/exprFrag/175>	ns3:efChars	"SPERA IN TE" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/25/paragrafo/3/exprFrag1/759>	ns3:efChars	"Cavalcanti, Novelle ti so dire 12 \u00ABma ben \u00E8 ver che ti larg\u00E2r lo pegno\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/11/paragrafo/1/exprFrag/174>	ns3:efChars	"DEL COR ... FERISTI" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/25/paragrafo/3/exprFrag1/758>	ns3:efChars	"\u00ABvendetta della carne\u00BB viene dalla Bibbia, Sir 7, 19 \u00ABHumilia valde spiritum tuum, quoniam vindicta carnis impii ignis et vermes\u00BB" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/25/paragrafo/2/exprFrag1/751>	ns3:efChars	"\u00ABhoc signum crucis maxime demones odiunt et timent\u00BB (Vita di San Giuliano" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/25/paragrafo/3/exprFrag1/757>	ns3:efChars	"\u00ABPalma Novella\u00BB, in Rolandino, Vita di Ezzelino, p. 44." .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/11/paragrafo/1/exprFrag/173>	ns3:efChars	"AGGI PIET\u00C0" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/rime/libro/1/capitolo/25/paragrafo/2/exprFrag1/752>	ns3:efChars	"Chr\u00E9tien de Troyes, Le Conte du Graal 114 \u00ABpor aus [i demoni] se doit en saignier\u00BB)" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/10/paragrafo/20/exprFrag1/315>	ns3:efChars	"Ella si vede / tanto gentil che non p\u00F2 'maginare / ch'om d'esto mondo l'ardisca mirare / che non convenga lui tremare in pria; / ed i', s'i' la sguardasse, ne morria - versi 20-4" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/14/paragrafo/24/exprFrag1/430>	ns3:efChars	"e dicemi: \"che\u00B7ffai? / la tua donna si muor di te aspettando\" - versi 53-4" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/15/paragrafo/4/exprFrag/309>	ns3:efChars	"\"EGO VOX ... DOMINI\"" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/5/paragrafo/20/exprFrag1/210>	ns3:efChars	"e s'ella sorridendo non ti crede, / dille: \"Madonna, con giurata fede - versi 98-9" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanova/libro/1/capitolo/10/paragrafo/18/exprFrag/206>	ns3:efChars	"ANGELO CLAMA ... BEATI\"" .
