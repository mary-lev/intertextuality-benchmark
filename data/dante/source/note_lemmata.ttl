<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/35/paragrafo/3/exprFrag1/964>	ns3:efChars	"e mena seco Amor - verso 3" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/39/paragrafo/9/exprFrag1/996>	ns3:efChars	"ghirlanda di martiri - verso 10" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/31/paragrafo/10/exprFrag/515>	ns3:efChars	"v. 22. pass\u00F2 li cieli" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/31/paragrafo/10/exprFrag/514>	ns3:efChars	"v. 22. pass\u00F2 li cieli" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/7/paragrafo/5/exprFrag1/133>	ns3:efChars	"alegranza con baldore - verso 10" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/3/paragrafo/3/exprFrag1/52>	ns3:efChars	"Ego sum Dominus Deus tuus - Exod., XX, 2" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/33/paragrafo/6/exprFrag/536>	ns3:efChars	"v. 13. astioso" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/18/paragrafo/5/exprFrag1/434>	ns3:efChars	"Et quomodo descendit imber et nix de caelo,. . . sic erit verbum meum quod egredietur de ore meo - Is LV 10-1" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/35/paragrafo/3/exprFrag1/961>	ns3:efChars	"I, 630" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/3/paragrafo/3/exprFrag1/51>	ns3:efChars	"Apoc., x, i" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/15/paragrafo/1/exprFrag1/364>	ns3:efChars	"i' sento nel cor un pensero / che fa tremar la mente di paura, / e par che dica: Amor non t'assicura / in guisa che tu possi di leggero / a la tua donna si contar il vero, / che Morte non ti ponga 'n sua figura - versi 3-8" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/23/paragrafo/27/exprFrag/399>	ns3:efChars	"v. 72. formata" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/23/paragrafo/27/exprFrag/398>	ns3:efChars	"v. 72. formata" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/24/paragrafo/8/exprFrag/415>	ns3:efChars	"guardando\u2026 / io vidi" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/21/paragrafo/2/exprFrag1/629>	ns3:efChars	"ed i' le prego per lor cortesia / che qual pi\u00F9 pu\u00F2 pi\u00F9 vi faccia onore - versi 11-2" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/14/paragrafo/12/exprFrag/208>	ns3:efChars	"poria" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/33/paragrafo/6/exprFrag/535>	ns3:efChars	"riposo" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/31/paragrafo/15/exprFrag1/923>	ns3:efChars	"del colpo fu strutta la mente - versi 11" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/15/paragrafo/6/exprFrag1/390>	ns3:efChars	"rima siciliana" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/14/paragrafo/12/exprFrag/209>	ns3:efChars	"quando s\u00EC presso" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/31/paragrafo/15/exprFrag1/924>	ns3:efChars	"verso 40" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/35/paragrafo/3/exprFrag/550>	ns3:efChars	"con" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/23/paragrafo/2/exprFrag/362>	ns3:efChars	"uno pensero lo quale era" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/18/paragrafo/5/exprFrag1/437>	ns3:efChars	"Is XLII 10" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/31/paragrafo/15/exprFrag1/925>	ns3:efChars	"distrugge 'l core - verso 11" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/16/paragrafo/7/exprFrag1/411>	ns3:efChars	"ma chi tal vede - verso 6" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/18/paragrafo/5/exprFrag1/438>	ns3:efChars	"versi 37-8" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/14/paragrafo/12/exprFrag/207>	ns3:efChars	"v. 5. Se lo saveste" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/31/paragrafo/15/exprFrag1/926>	ns3:efChars	"l'angosciosa vita mia / che sospirando la distrugge Amore - versi 3-4" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/15/paragrafo/6/exprFrag1/392>	ns3:efChars	"versi 30-1" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/40/paragrafo/10/exprFrag/581>	ns3:efChars	"de' sospiri" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/25/paragrafo/7/exprFrag/430>	ns3:efChars	"largita" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/15/paragrafo/6/exprFrag1/393>	ns3:efChars	"Morte m'\u00E8 nel viso gi\u00E0 salita - verso 14" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/10/exprFrag/285>	ns3:efChars	"v. 39. li avvien \u2026 in salute" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/9/exprFrag1/499>	ns3:efChars	"Ancor ve dir\u00F2 c'ha maggior vertute - verso 13" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/7/exprFrag1/487>	ns3:efChars	"verso 14" .
