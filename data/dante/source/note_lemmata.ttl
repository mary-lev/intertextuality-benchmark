<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/33/paragrafo/5/exprFrag1/944>	ns3:efChars	"verso 1" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/27/paragrafo/4/exprFrag1/872>	ns3:efChars	"La salute tua \u00E8 apparita / L\u00E0 dove questa bella donna appare / s'ode una voce che le v\u00E8n davanti / e par che d'umilt\u00E0 [cfr. qui il v. 14] il su' nome canti / si dolcemente ... / e movonsi nell'anima sospiri / che dicon: Guarda; se tu coste' miri, / vedr\u00E0' la sua vert\u00F9 nel ciel salita - versi 12-20" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/18/paragrafo/4/exprFrag1/431>	ns3:efChars	"Amor, la sua merc\u00E9, mi dice - verso 28" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/21/paragrafo/2/exprFrag1/622>	ns3:efChars	"s\u00EC che parlare / null'omo pote, ma ciascun sospira - versi 3-4" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/19/paragrafo/11/exprFrag/289>	ns3:efChars	"v. 44. come esser p\u00F2" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/18/paragrafo/4/exprFrag1/430>	ns3:efChars	"laetitiam salutaris tui - Ps I,14" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/21/paragrafo/2/exprFrag1/623>	ns3:efChars	"abassa orgoglio a cui dona salute - verso 10" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/31/paragrafo/10/exprFrag/517>	ns3:efChars	"v. 28. non era degna" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/35/paragrafo/3/exprFrag1/962>	ns3:efChars	"I veggo a lui spirito apparire - verso 9" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/18/paragrafo/5/exprFrag1/435>	ns3:efChars	"quod non auferetur - Is LV 13" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/6/paragrafo/1/exprFrag1/106>	ns3:efChars	"non ho talento di voler provare - verso 9" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/35/paragrafo/3/exprFrag1/963>	ns3:efChars	"per la vil tua vita - verso 9" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/39/paragrafo/9/exprFrag1/995>	ns3:efChars	"hanno destrutto s\u00EC costui. . . / ch'altro non n'\u00E8 rimaso che sospiri - versi 11-2" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/31/paragrafo/10/exprFrag/516>	ns3:efChars	"v. 24. dolce disire" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/18/paragrafo/5/exprFrag1/436>	ns3:efChars	"montes et colles cantabunt coram vobis laudem - Is LV 12" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/12/paragrafo/2/exprFrag1/211>	ns3:efChars	"cotanto d'umilt\u00E0 donna mi pare - Verso 7" .
<http://perunaenciclopediadantescadigitale.eu/resource/work/vitanuovaderobertis/libro/1/capitolo/6/paragrafo/1/exprFrag1/107>	ns3:efChars	"aliae dominae" .
